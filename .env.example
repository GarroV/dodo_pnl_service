# Пример окружения. Скопировать в .env и подставить значения.
# .env в git не попадает — там настоящие секреты.
#
#     cp .env.example .env
#
# Значения ниже рабочие: с ними `docker compose up -d --build` поднимается
# как есть. Пароли — заглушки для локальной машины, на площадке заменить.

# --- База данных ---
POSTGRES_USER=app
# Только буквы, цифры и дефис: пароль подставляется в DSN, спецсимволы в нём
# пришлось бы кодировать.
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=dodo_pnl
# Порт базы на хосте. Наружу торчит только на localhost. 5432 обычно занят
# локальным Postgres, поэтому 5440 — и локально, и на площадке (D006).
POSTGRES_HOST_PORT=5440

# Как ходить в базу с хоста: pytest, `python manage.py ...` из venv, psql.
# Внутри compose приложение использует не эту строку, а собранную из
# POSTGRES_* с хостом `db` — см. docker-compose.yml.
DATABASE_URL=postgresql://app:dev-only-change-me@127.0.0.1:5440/dodo_pnl

# Демо-стенд живёт отдельной базой: он пересоздаётся целиком и не должен
# иметь ни одного шанса задеть боевые данные (D016).
# Пока не читается никем — придёт с блоком demo.
DEMO_DATABASE_URL=postgresql://app:dev-only-change-me@127.0.0.1:5440/dodo_pnl_demo

# --- Приложение ---
# Порт приложения на хосте: 8000 локально, 8030 на площадке (D006).
APP_PORT=8000
SECRET_KEY=change-me-any-long-random-string
DJANGO_SETTINGS_MODULE=config.settings
# 1 — подробные страницы ошибок. На площадке обязательно 0.
DJANGO_DEBUG=1
# Через запятую, без пробелов. При DJANGO_DEBUG=0 обращение с чужим именем
# хоста получит 400.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Кнопки быстрого входа учётками тестового сида на странице входа. Отдельного
# способа проверить личность у них нет: кнопка подставляет пароль сида и идёт
# тем же путём. Умолчание зависит от DJANGO_DEBUG; на площадке — DEV_LOGIN=0,
# тогда кнопок нет, а выданные ими сессии перестают действовать.
DEV_LOGIN=1

# Пароль учёток тестового сида (логины: director, accountant, manager, admin) и
# тех самых кнопок. Данные для разработки, а не секрет площадки: сид на площадке
# не гоняется.
SEED_USER_PASSWORD=dodo-dev

# --- Фоновый расчёт периода ---
# Очередь живёт в той же базе (django-q2, брокер orm), отдельного сервиса
# очереди нет. Рабочий процесс поднимается службой `queue` в docker-compose.yml.
#
# 1 — расчёт уходит фоновой задачей, страница показывает ход работы.
# 0 — расчёт идёт прямо в запросе, и страница прогресса не обещает. Это
# осознанный режим для площадки без рабочего процесса, а не поломка: молчаливой
# подмены одного другим нет ни в одну сторону.
PAYRUN_BACKGROUND=1

# Сколько задач рабочий процесс берёт одновременно. Расчёт периода держит
# транзакцию, поэтому больше ядер базы ставить смысла нет.
PAYRUN_QUEUE_WORKERS=2

# Сколько секунд задаче даётся на расчёт, прежде чем очередь считает её
# потерянной. Возврат в очередь берётся отсюда же с запасом: retry меньше
# timeout означал бы выдачу той же задачи второму процессу, пока первый считает.
PAYRUN_QUEUE_TIMEOUT=600

# Сколько секунд задача может простоять непринятой, прежде чем страница скажет
# человеку, что рабочий процесс очереди, похоже, не запущен, и предложит
# посчитать прямо сейчас. Живая очередь забирает задачу за доли секунды.
PAYRUN_QUEUE_STALE_SECONDS=10

# --- Проверка здоровья ---
# Их читает docker/healthcheck.py. Когда появится отдельный эндпоинт проверки,
# достаточно поменять путь здесь — трогать код не нужно.
HEALTHCHECK_PORT=8000
HEALTHCHECK_PATH=/
HEALTHCHECK_TIMEOUT=5

# --- Сверка с настоящей таблицей бухгалтерии ---
# Файл содержит ФИО и суммы живых людей, поэтому лежит ВНЕ репозитория.
# Без этой переменной тесты сверки пропускаются, остальные идут как обычно.
# PAYROLL_FIXTURE=/Users/<имя>/Documents/projects/_private/dodo_pnl/plata-2026-06.xlsx

# --- Тесты схемы ---
# Куда подключаться, чтобы создать временную базу под тесты схемы и сида.
# Роль должна уметь create database; политики проверяются переключением на роль
# app_user, поэтому обычный владелец схемы подходит.
# С поднятым compose это база postgres в контейнере:
DODO_TEST_ADMIN_DSN=postgresql://app:dev-only-change-me@127.0.0.1:5440/postgres
