# Пример окружения. Скопировать в .env и подставить значения.
# .env в git не попадает — там настоящие секреты.

# --- База данных ---
# Локально поднимается через docker compose, порт наружу только на localhost.
DATABASE_URL=postgresql://app:change-me@localhost:5440/dodo_pnl
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=dodo_pnl
POSTGRES_HOST_PORT=5440

# Демо-стенд живёт отдельной базой: он пересоздаётся целиком и не должен
# иметь ни одного шанса задеть боевые данные.
DEMO_DATABASE_URL=postgresql://app:change-me@localhost:5440/dodo_pnl_demo

# --- Приложение ---
APP_PORT=8000
SECRET_KEY=change-me-any-long-random-string
DJANGO_SETTINGS_MODULE=config.settings

# --- Сверка с настоящей таблицей бухгалтерии ---
# Файл содержит ФИО и суммы живых людей, поэтому лежит ВНЕ репозитория.
# Без этой переменной тесты сверки пропускаются, остальные идут как обычно.
# PAYROLL_FIXTURE=/Users/<имя>/Documents/projects/_private/dodo_pnl/plata-2026-06.xlsx

# --- Тесты схемы ---
# Куда подключаться, чтобы создать временную базу под тесты схемы и сида.
# Роль должна уметь create database; политики проверяются переключением на роль
# app_user, поэтому обычный владелец схемы подходит.
# DODO_TEST_ADMIN_DSN=postgresql:///postgres
