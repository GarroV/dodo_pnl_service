# Пример окружения. Скопировать в .env и подставить значения.
# .env в git не попадает — там настоящие секреты.
#
#     cp .env.example .env
#
# Значения ниже рабочие: с ними `docker compose up -d --build` поднимается
# как есть. Пароли — заглушки для локальной машины, на площадке заменить.

# --- Имя стенда ---
# Готового значения здесь нет намеренно: скопированный пример принёс бы одно имя
# на всех, а имя проекта Compose — одно на машину, а не на каталог. Пока в
# docker-compose.yml было зашито `name: dodo-pnl`, `docker compose up` из
# соседней рабочей копии молча переставлял порты чужому стенду, а
# `down -v` уносил чужую базу вместе с сидом посреди проверки (issue #51,
# воспроизведено дважды).
#
# Не задали — стенд назовётся по каталогу рабочей копии, и это безопасно:
# каталоги у копий разные. Задавать стоит, когда имя каталога длинное или
# копий у одной задачи несколько:
#
#     COMPOSE_PROJECT_NAME=dodo-pnl-<про что эта копия>
#
# Порты в каждой копии тоже свои: APP_PORT, DEMO_APP_PORT, POSTGRES_HOST_PORT.

# --- База данных ---
# Владелец схемы: этой ролью образ базы создаёт базу, ею же накатываются
# миграции (см. MIGRATION_DB_USER ниже).
POSTGRES_USER=app
# Только буквы, цифры и дефис: пароль подставляется в DSN, спецсимволы в нём
# пришлось бы кодировать.
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=dodo_pnl
# Порт базы на хосте. Наружу торчит только на localhost. 5432 обычно занят
# локальным Postgres, поэтому 5440 — и локально, и на площадке (D006).
POSTGRES_HOST_PORT=5440

# --- Две роли: кто накатывает схему и кто работает продуктом (T058) ---
# Схему накатывает служба `migrate` ролью MIGRATION_DB_USER — она владеет
# таблицами и имеет право на DDL. Приложение и рабочий процесс очереди ходят
# ролью APP_DB_USER, и права на DDL у неё быть не должно: на разделении ролей
# стоит разграничение доступа (роль приложения не обходит политики RLS).
#
# Локально обе роли — одна и та же: в контейнере базы есть только POSTGRES_USER,
# заводить вторую ради разработки незачем. Обе переменные поэтому пустые и
# берут значение из POSTGRES_USER/POSTGRES_PASSWORD.
#
# На площадке их разводят: MIGRATION_DB_USER — владелец схемы, APP_DB_USER —
# логин-роль без DDL, которой выдана групповая роль `app_user`. Пусто здесь
# означает «как POSTGRES_*», а не «без роли»: молчаливой подмены нет — что
# именно подставилось, видно в `docker compose config`.
# Роль рабочего процесса очереди — третья (T124, issue #66). Он читает очередь
# соединением напрямую, а роль продукта на таблицах очереди умеет ровно одно —
# поставить задачу: полезная нагрузка ей не нужна. Одной ролью на веб и очередь
# это не сходится: рабочий процесс падает `permission denied for table
# django_q_ormq`. Логин-роль очереди на площадке состоит в двух ролях —
# `queue_worker` (разбирать очередь) и `app_user` (данные внутри задачи).
#
# Пусто — берётся APP_DB_USER, а если пусто и там, то POSTGRES_USER.
QUEUE_DB_USER=
QUEUE_DB_PASSWORD=

MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=

# Как ходить в базу с хоста: pytest, `python manage.py ...` из venv, psql.
# Внутри compose приложение использует не эту строку, а собранную из
# POSTGRES_* с хостом `db` — см. docker-compose.yml.
DATABASE_URL=postgresql://app:dev-only-change-me@127.0.0.1:5440/dodo_pnl

# Демо-стенд живёт отдельной базой: он пересоздаётся целиком и не должен
# иметь ни одного шанса задеть боевые данные (D016). Эту строку читают команды
# `seed_demo` и `demo_reset`, запущенные с хоста; внутри compose демо-службы
# получают свою — собранную из POSTGRES_* с хостом `db` (см. docker-compose.yml).
#
# Рядом с этой базой команда сброса заводит вторую — эталон
# `<имя базы>_template`. Отдельной переменной у него нет намеренно: ещё одна
# переменная — ещё одно место, где однажды окажется чужое имя базы.
DEMO_DATABASE_URL=postgresql://app:dev-only-change-me@127.0.0.1:5440/dodo_pnl_demo

# Имя демо-базы внутри compose. Отдельно от боевой POSTGRES_DB: это и есть
# разделение, ради которого всё написано.
POSTGRES_DEMO_DB=dodo_pnl_demo

# --- Демо-стенд ---
# Демо поднимается отдельным профилем compose и в обычный `up` не входит:
#     docker compose --profile demo up -d
#
# 1 — у экземпляра появляются адреса /demo/*: вход без регистрации одной
# кнопкой. В продукте переменной быть не должно: при DEMO_MODE=0 маршрутов нет
# вовсе, а не «страница отвечает отказом».
DEMO_MODE=0

# Порт демо на хосте. Свой, а не APP_PORT: демо и продукт — два разных
# экземпляра, поднятых рядом.
DEMO_APP_PORT=8010

# Лёгкий спидбамп на входе в демо: без ключа страница отдаёт 404.
# Секретом не является — охранять в демо-базе нечего, там выдуманные люди.
# Пусто — демо открыто всем, кто знает адрес.
DEMO_KEY=

# Пароль учёток ролей демо; логины — коды ролей. У администратора сети пароль
# свой (ниже): его учёткой показывают продукт целиком. Вход и так открыт одной
# кнопкой; переменная нужна, чтобы пароль можно было сменить на площадке, не
# пересобирая образ.
DEMO_USER_PASSWORD=demo-only-not-a-secret

# Пароль учётки `admin` — администратора сети, который может всё (D052).
# Простой намеренно: эту пару диктуют вслух при показе.
DEMO_ADMIN_PASSWORD=admin

# Простая учётка `demodemo` — для того, кто вышел из демо и оказался на форме
# входа: логины ролей там не угадать, а спросить не у кого.
DEMO_GUEST_PASSWORD=password

# Как часто демо возвращается к эталону, минут. Сброс идёт службой
# `demo-reset` и не требует ручных действий: демо, которое чинят руками,
# протухает в первый же день, когда на него никто не смотрит.
DEMO_RESET_MINUTES=60

# Язык интерфейса задаётся ОДНОЙ переменной — `UI_LANGUAGE`, она описана ниже.
# Здесь её нет намеренно: блоки `demo` и `web` строились параллельно и завели
# каждый своё имя (`DJANGO_LANGUAGE` и `UI_LANGUAGE`) для одного и того же.
# Сведено при приёмке — два имени одной настройки расходятся молча.

# --- Приложение ---
# Порт приложения на хосте: 8000 локально, 8030 на площадке (D006).
APP_PORT=8000
SECRET_KEY=change-me-any-long-random-string
DJANGO_SETTINGS_MODULE=config.settings
# 1 — трассировка на 500 и раздача статики под runserver. На площадке
# обязательно 0.
#
# Чего эта переменная больше НЕ решает (T099): 404 и 403 человек видит
# страницей продукта при любом её значении. Раньше с `1` на несуществующем
# адресе показывалась техническая страница Django с текстом исключения и
# перечнем маршрутов — а `1` здесь умолчание, то есть ровно то, с чем продукт
# поднимают локально и показывают коллеге. Трассировка на 500 при `1` осталась:
# 500 — это дефект, и трассировка нужна тому, кто его чинит.
DJANGO_DEBUG=1
# Через запятую, без пробелов. При DJANGO_DEBUG=0 обращение с чужим именем
# хоста получит 400.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Кнопки быстрого входа учётками тестового сида на странице входа. Отдельного
# способа проверить личность у них нет: кнопка подставляет пароль сида и идёт
# тем же путём. Умолчание зависит от DJANGO_DEBUG; на площадке — DEV_LOGIN=0,
# тогда кнопок нет, а выданные ими сессии перестают действовать.
DEV_LOGIN=1

# Пароль учёток тестового сида (логины: director, accountant, manager, admin) и
# тех самых кнопок. Данные для разработки, а не секрет площадки: сид на площадке
# не гоняется.
SEED_USER_PASSWORD=dodo-dev

# --- Сервер приложений ---
# Продукт и демо поднимаются gunicorn, а не `runserver`: тот сервер разработки,
# и Django говорит об этом прямо (issue #191). Одинаково локально и на площадке —
# автоперезагружать в контейнере нечего, исходники в образ скопированы, а не
# подмонтированы. Разработка с автоперезагрузкой идёт через `manage.py runserver`
# из venv, и её это не касается.

# Сколько процессов держит сервер. Два, а не один: ради присмотра за процессами
# боевой сервер и берут — застрявший воркер перезапускает арбитр, а второй в это
# время отвечает. Каждый процесс — это ещё ~110 МБ памяти.
APP_SERVER_WORKERS=2

# Потоков в каждом процессе. Воркер потоковый (gthread): Django здесь
# синхронный, а один медленный запрос не должен занимать процесс целиком.
APP_SERVER_THREADS=4

# Секунд молчания воркера, после которых сервер считает его застрявшим. Это
# сторож застрявшего процесса, а не срок на запрос: потоковый воркер (gthread)
# отмечается живым из главного цикла, поэтому долгий запрос его не убивает —
# проверено, запрос на 20 с при тайм-ауте 5 с отдал 200 и воркер уцелел. Запас
# нужен на случай, когда долгий расчёт держит GIL. Умолчание gunicorn — 30 с.
APP_REQUEST_TIMEOUT=120

# --- Фоновый расчёт периода ---
# Очередь живёт в той же базе (django-q2, брокер orm), отдельного сервиса
# очереди нет. Рабочий процесс поднимается службой `worker` в docker-compose.yml.
#
# 1 — расчёт уходит фоновой задачей, страница показывает ход работы.
# 0 — расчёт идёт прямо в запросе, и страница прогресса не обещает. Это
# осознанный режим для площадки без рабочего процесса, а не поломка: молчаливой
# подмены одного другим нет ни в одну сторону.
PAYRUN_BACKGROUND=1

# Сколько задач рабочий процесс берёт одновременно. Расчёт периода держит
# транзакцию, поэтому больше ядер базы ставить смысла нет.
PAYRUN_QUEUE_WORKERS=2

# Сколько секунд задаче даётся на расчёт, прежде чем очередь считает её
# потерянной. Возврат в очередь берётся отсюда же с запасом: retry меньше
# timeout означал бы выдачу той же задачи второму процессу, пока первый считает.
PAYRUN_QUEUE_TIMEOUT=600

# Сколько секунд задача может простоять непринятой, прежде чем страница скажет
# человеку, что рабочий процесс очереди, похоже, не запущен, и предложит
# посчитать прямо сейчас. Живая очередь забирает задачу за доли секунды.
PAYRUN_QUEUE_STALE_SECONDS=10

# Как часто рабочий процесс спрашивает у базы, не появилось ли задачи. Умолчание
# самой django-q2 — 0,2 с, то есть пять запросов в секунду круглосуточно при
# пустой очереди; на стенде в простое это стоило 6 % CPU рабочему процессу и
# 10 % базе (issue #190). Площадка — ноутбук, и такой расход не бесплатен.
#
# Ставится вместе с порогом выше и только меньше него: PAYRUN_QUEUE_STALE_SECONDS
# обязан быть хотя бы втрое больше опроса, иначе страница объявит мёртвой
# очередь, которая просто ещё не проснулась. Разъезд этих двух чисел приложение
# отвергает на старте, а не подгоняет молча.
PAYRUN_QUEUE_POLL_SECONDS=2

# --- Проверка здоровья ---
# Их читает docker/healthcheck.py. Когда появится отдельный эндпоинт проверки,
# достаточно поменять путь здесь — трогать код не нужно.
#
# Порта здесь нет намеренно (issue #107). Проверка ходит ВНУТРЬ контейнера, где
# приложение слушает 8000 всегда; APP_PORT выше — порт на хосте. Пока порт был
# переменной и лежал рядом с APP_PORT, их правили пачкой под второй стенд, и
# контейнер стоял `unhealthy` при работающем продукте.
HEALTHCHECK_PATH=/
HEALTHCHECK_TIMEOUT=5

# --- Сверка с настоящей таблицей бухгалтерии ---
# Файл содержит ФИО и суммы живых людей, поэтому лежит ВНЕ репозитория.
# Без этой переменной тесты сверки пропускаются, остальные идут как обычно.
# PAYROLL_FIXTURE=/Users/<имя>/Documents/projects/_private/dodo_pnl/plata-2026-06.xlsx

# --- Тесты схемы ---
# Куда подключаться, чтобы создать временную базу под тесты схемы и сида.
# Роль должна уметь create database; политики проверяются переключением на роль
# app_user, поэтому обычный владелец схемы подходит.
# С поднятым compose это база postgres в контейнере:
DODO_TEST_ADMIN_DSN=postgresql://app:dev-only-change-me@127.0.0.1:5440/postgres

# --- Язык интерфейса (T017) ---
# Пусто — язык выбирает человек: кнопкой в шапке, а до первого выбора по тому,
# что просит его браузер (не подошло ничего — русский, язык исходника).
#
# Заданный язык ЗАКРЕПЛЯЕТ страницы: выбор человека перестаёт действовать, и
# переключателя в шапке нет вовсе. Так поднимается демо-стенд (UI_LANGUAGE=en) —
# конституция требует, чтобы демо открывалось по-английски независимо от гостя.
# Значения: ru, en, sr-latn.
UI_LANGUAGE=
