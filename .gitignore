# Данные партнёров в репозиторий не попадают никогда: там ФИО, ставки и суммы
# живых людей. Исключение ровно одно — обезличенный файл, собранный
# `python tools/make_fixture.py` из выдуманных людей.
data/
*.xlsx
!tests/fixtures/plata-sample.xlsx

# Метаданные сборки: генерируются pip install -e, в git им делать нечего.
*.egg-info/

# Данные измерения покрытия
.coverage.*

# Собранная статика: результат `collectstatic`, в образе делается при сборке.
staticfiles/

# Снимки экранов и собранная страница гайда. В репозитории живёт ИСХОДНИК
# (`docs/guides/first-month.html`) со ссылками `{{SHOT:…}}`, а собранная копия
# весит мегабайты встроенных картинок и пересобирается одной командой —
# см. docs/user-guides.md.
# Пути от корня, а не «где угодно»: без ведущей косой черты `guide.html`
# скрыл бы и шаблон продукта `src/web/templates/web/guide.html`.
/guide-shots/
/guide.html
