msgid "Дата документа"
msgstr "Document date"

#: src/web/suppliers_views.py:421
#, python-format
msgid "«%(label)s»: счёт на ноль не вносится."
msgstr "“%(label)s”: an invoice for zero is not accepted."

#: src/web/suppliers_views.py:432 src/web/suppliers_views.py:572
msgid "Номер счёта"
msgstr "Invoice number"

#: src/web/suppliers_views.py:465 src/web/suppliers_views.py:562
