msgstr "Not sorted out."

#: web/templates/web/suppliers/paper.html:31
#, python-format
msgid "%(kind)s от %(date)s, точка %(unit)s"
msgstr "%(kind)s from %(date)s, unit %(unit)s"

#: web/templates/web/suppliers/paper.html:32
