msgstr[1] "ждут разбора %(counter)s бумаги"
msgstr[2] "ждут разбора %(counter)s бумаг"

#: src/web/templates/web/cash/expenses.html
# Формы 1 и 2 совпадают не по ошибке: у «строкам» дательный падеж
# множественного числа один и тот же что на 2, что на 5 («по 2 строкам», «по
# 5 строкам») — различается только форма 0, единственное число («по 1 строке»).
#, python-format
msgid "Итого по %(counter)s строке"
msgid_plural "Итого по %(counter)s строкам"
msgstr[0] "Итого по %(counter)s строке"
msgstr[1] "Итого по %(counter)s строкам"
msgstr[2] "Итого по %(counter)s строкам"

#: src/web/templates/web/suppliers/invoices.html
# Формы 1 и 2 совпадают не по ошибке: та же причина, что у строк выше —
# дательный падеж множественного числа один на 2 и на 5 («по 2 счетам», «по
# 5 счетам»), различается только форма 0 («по 1 счёту»).
#, python-format
msgid "Итого по %(counter)s счёту"
msgid_plural "Итого по %(counter)s счетам"
msgstr[0] "Итого по %(counter)s счёту"
msgstr[1] "Итого по %(counter)s счетам"
msgstr[2] "Итого по %(counter)s счетам"
