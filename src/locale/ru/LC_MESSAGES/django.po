# Множественные числа языка исходника (см. пояснение в шапке файла, issue #146).

#: src/web/templates/web/suppliers/inbox.html
#, python-format
msgid "ждёт разбора %(counter)s строка"
msgid_plural "ждут разбора %(counter)s строк"
msgstr[0] "ждёт разбора %(counter)s строка"
msgstr[1] "ждут разбора %(counter)s строки"
msgstr[2] "ждут разбора %(counter)s строк"

#: src/web/templates/web/suppliers/papers.html src/web/templates/web/suppliers/inbox.html
#, python-format
msgid "ждёт разбора %(counter)s бумага"
