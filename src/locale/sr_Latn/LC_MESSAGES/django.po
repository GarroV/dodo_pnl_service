#, python-format
msgid "нет условий найма на этот месяц: %(count)s чел. Расчёт без них выглядел бы верным, поэтому не выполняется."
msgstr "Nema uslova zapošljavanja za ovaj mesec: %(count)s osoba. Obračun bez njih bi izgledao ispravno, zato se ne izvršava."

msgid "за этот период нет ни одного табеля — считать нечего. Внесите часы и повторите."
msgstr "Za ovaj period ne postoji nijedna evidencija sati — nema šta da se obračuna. Unesite sate i pokušajte ponovo."

#, python-format
msgid "в правилах страны нет схем расчёта: %(schemes)s. Поправьте группу сотрудников или пресет."
msgstr "U pravilima zemlje nema šema obračuna: %(schemes)s. Ispravite grupu zaposlenih ili preset."

#, python-format
msgid "база для взносов не сходится с часами табеля: %(count)s чел. По ней считаются взносы и бруто, поэтому расчёт по устаревшей базе выглядел бы верным. Проверьте колонку «База взносов» в табеле."
msgstr "Osnovica doprinosa se ne poklapa sa satima iz evidencije sati: %(count)s osoba. Iz nje se računaju doprinosi i bruto, zato bi obračun po zastareloj osnovici izgledao ispravno. Proverite kolonu „Osnovica doprinosa“ u evidenciji sati."

msgid "Ведомость этого периода попадает в регистры учёта, недоступные вашей роли. Запустить расчёт может тот, кто видит их все."
msgstr "Obračunska lista ovog perioda spada u knjige koje nisu dostupne vašoj ulozi. Obračun može pokrenuti samo onaj ko vidi sve knjige."

msgid "Считаем сотрудников"
msgstr "Obračunavamo zaposlene"

msgid "партнёр недоступен"
msgstr "partner nedostupan"

msgid "Собираем табели и условия найма"
msgstr "Prikupljamo evidencije sati i uslove zapošljavanja"

msgid "Записываем ведомость"
msgstr "Upisujemo obračunsku listu"

msgid "Заморозка строки требует причины: напишите, из-за чего идёт спор. Причина попадёт в историю рядом с вашим именем."
msgstr "Zamrzavanje reda zahteva razlog: napišite oko čega je spor. Razlog će ući u istoriju pored vašeg imena."

msgid "Строка сотрудника заморожена: её числа не меняются и пересчёт её обходит. Чтобы вернуть человека в общий расчёт, заморозку нужно снять."
msgstr "Obračunski red zaposlenog je zamrznut: njegovi brojevi se ne menjaju, a ponovni obračun ga zaobilazi. Da bi se osoba vratila u zajednički obračun, zamrzavanje treba ukinuti."

msgid "Период утверждён: замораживать в нём нечего — заморожен весь расчёт. Чтобы менять расчёт, период нужно сначала открыть заново."
msgstr "Period je odobren: u njemu nema šta da se zamrzne — ceo obračun je već zamrznut. Da bi se obračun promenio, period prvo treba ponovo otvoriti."

msgid "Расчёт этого периода уже идёт. Дождитесь, пока он закончится: второй запуск не ускорит его, а ведомость всё равно будет одна."
msgstr "Obračun ovog perioda je već u toku. Sačekajte da se završi: drugo pokretanje ga neće ubrzati, a obračunska lista će i dalje biti jedna."

msgid "Задача принята, но её до сих пор не взяли в работу — похоже, рабочий процесс очереди не запущен. Расчёт можно выполнить прямо сейчас, не дожидаясь очереди."
msgstr "Zadatak je prihvaćen, ali još nije preuzet u rad — izgleda da radni proces reda čekanja nije pokrenut. Obračun se može izvršiti odmah, bez čekanja na red."

msgid "Расчёт оборвался из-за внутренней ошибки. Данные периода не изменились; покажите этот период тому, кто ведёт сервис."
msgstr "Obračun je prekinut zbog interne greške. Podaci perioda se nisu promenili; pokažite ovaj period onome ko održava servis."

msgid "Готово"
msgstr "Gotovo"

msgid "В очереди"
msgstr "U redu čekanja"

msgid "Считаем"
msgstr "Obračunavamo"

msgid "Черновик"
msgstr "Nacrt"

msgid "Посчитан"
msgstr "nije obračunat"

msgid "Утверждён"
msgstr "3. Odobrenje"

msgid "Открыт заново"
msgstr "Ponovo otvori"

msgid "Выплачен"
msgstr "Isplaćeno"

msgid "Период утверждён: расчёт и его данные заморожены. Чтобы пересчитать, период нужно сначала открыть заново."
msgstr "Period je odobren. Obračun i njegovi podaci su zamrznuti."

msgid "Откат периода требует причины: напишите, зачем открываете период. Причина попадёт в историю рядом с вашим именем."
msgstr "Ponovno otvaranje perioda zahteva razlog: napišite zašto otvarate period. Razlog će ući u istoriju pored vašeg imena."

msgid "Расчёта за этот период ещё не было: сначала посчитайте период."
msgstr "Za ovaj period još nije bilo obračuna: prvo obračunajte period."

#, python-format
msgid "Период сейчас в состоянии «%(from_title)s», перевести его в «%(to_title)s» нельзя. Открытый заново период нужно пересчитать, прежде чем утверждать снова."
msgstr "Period je trenutno u stanju „%(from_title)s“, ne može se preneti u stanje „%(to_title)s“. Ponovo otvoren period treba ponovo obračunati pre nego što se opet odobri."

msgid "Состояние периода изменилось, пока страница была открыта. Обновите страницу и посмотрите, что с ним стало."
msgstr "Stanje perioda se promenilo dok je stranica bila otvorena. Osvežite stranicu i pogledajte šta se desilo sa njim."

msgid "разница переносится в текущий период"
msgstr "razlika se prenosi u tekući period"

msgid "период открывается заново и пересчитывается"
msgstr "Period je ponovo otvoren. Razlog i vaše ime su zabeleženi u istoriji."

msgid "У этого партнёра правки задним числом ведутся пересчётом, а не переносом: закрытый период открывается заново с указанием причины и считается снова. Перенос разницы для него выключен настройкой."
msgstr ""
"Kod ovog partnera se izmene unazad rade ponovnim obračunom: ponovo otvorite period\n"
"    uz navođenje razloga i ponovo ga obračunajte."

msgid "Расхождений с сегодняшними данными нет: переносить нечего. Возможно, разницу уже перенесли — посмотрите период-получатель."
msgstr "Nema odstupanja u odnosu na današnje podatke: nema šta da se prenese. Razlika je možda već preneta — pogledajte period primaoca."

msgid "Перенос разницы делается только из закрытого месяца. Этот период ещё не утверждён — правьте данные и пересчитывайте его как обычно."
msgstr "Prenos razlike se radi samo iz zatvorenog meseca. Ovaj period još nije odobren — ispravite podatke i ponovo ga obračunajte kao i obično."

msgid "Разница за этот месяц попадает в регистры учёта, недоступные вашей роли. Перенести её может тот, кто видит их все."
msgstr "Razlika za ovaj mesec spada u knjige koje nisu dostupne vašoj ulozi. Preneti je može samo onaj ko vidi sve knjige."

msgid "Разница за этот месяц уже перенесена в утверждённый период и выплачена. Открыть его заново нельзя: пересчёт означал бы заплатить дважды."
msgstr "Razlika za ovaj mesec je već preneta u odobreni period i isplaćena. Ne može se ponovo otvoriti: ponovni obračun bi značio da se plati dvaput."

