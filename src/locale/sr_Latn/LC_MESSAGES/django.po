msgstr "Prema evidenciji sati za iste mesece; sati se ne dele po knjigama"

#: src/web/positions_views.py:76
msgid ""
"Шаблон условий найма: кого нанимаем, в какую группу он попадает и в каких "
"границах бывает его ставка."
msgstr ""
"Šablon uslova zaposlenja: koga zapošljavamo, u koju grupu ulazi i u kojim "
"granicama je njegova cena rada."

#: src/web/positions_views.py:79
msgid "Завести должность"
msgstr "Dodaj radno mesto"

#: src/web/positions_views.py:85
msgid "Должностей нет."
msgstr "Nema radnih mesta."

#: src/web/positions_views.py:86
msgid ""
"Пока их нет, условия найма набираются каждому человеку руками — это "
"работает, просто дольше."
msgstr ""
"Dok ih nema, uslovi zaposlenja se unose ručno za svakog čoveka — to radi, "
"samo duže traje."

#: src/web/positions_views.py:129
msgid "Новая должность"
msgstr "Novo radno mesto"

#: src/web/positions_views.py:131
msgid "← К должностям"
msgstr "← Na radna mesta"

