msgid "Для разнесения «%(method)s» нужно выбрать точку."
msgstr "Za raspodelu „%(method)s“ potrebno je izabrati objekat."

#: src/web/allocation.py:178
#, python-format
msgid ""
"Правило уже действует с %(from)s: новая версия не может начинаться раньше. "
"Возьмите дату позже."
msgstr ""
"Pravilo već važi od %(from)s: nova verzija ne može početi ranije. Izaberite "
"kasniji datum."

#: src/web/allocation.py:222
#, python-format
msgid ""
"Правило действует с %(from)s: убрать его можно только более поздней датой."
msgstr "Pravilo važi od %(from)s: ukloniti ga je moguće samo kasnijim datumom."

#: src/web/api.py:91
#, python-format
msgid "Этот вызов принимает только %(methods)s."
msgstr "Ovaj poziv prihvata samo %(methods)s."

#: src/web/api.py:97
msgid "Сначала войдите."
msgstr "Prvo se prijavite."

#: src/web/api.py:102
msgid "Вас ещё не завели ни к одному партнёру."
msgstr "Još niste dodati ni jednom partneru."

#: src/web/api.py:116
msgid "Расход не найден."
msgstr "Trošak nije pronađen."

#: src/web/api.py:143
msgid "Тело запроса не разобрано как JSON."
msgstr "Telo zahteva nije moglo da se parsira kao JSON."

#: src/web/api.py:145
msgid "Тело запроса должно быть объектом JSON."
msgstr "Telo zahteva mora biti JSON objekat."

#: src/web/api.py:206
#, python-format
msgid "«limit» больше %(max)s не бывает: спросите страницами."
msgstr "„limit“ ne može biti veći od %(max)s: tražite po stranicama."

#: src/web/api.py:210
msgid "«limit» должен быть больше нуля."
msgstr "„limit“ mora biti veći od nule."

#: src/web/api.py:220
#, python-format
msgid "«%(name)s»: это целое число, а не «%(value)s»."
msgstr "„%(name)s“ mora biti ceo broj, a ne „%(value)s“."

#: src/web/api.py:287 src/web/expenses_views.py:642
msgid "Эта строка уже заменена: правьте ту, что действует."
msgstr "Ovaj red je već zamenjen: uredite onaj koji je važeći."

#: src/web/api.py:374
msgid "Укажите месяц пересчёта: «period» в виде 2026-08, по одному за вызов."
msgstr ""
"Navedite mesec za ponovni obračun: „period“ u obliku 2026-08, jedan po "
"pozivu."

#: src/web/api.py:380
#, python-format
msgid "«period»: месяц пишется как 2026-08, а не «%(value)s»."
msgstr "„period“: mesec se piše kao 2026-08, a ne „%(value)s“."

#: src/web/cash.py:145
#, python-format
msgid ""
"Месяц %(month)s закрыт, и текущий месяц %(current)s тоже — расход записать "
"некуда. Откройте месяц заново с причиной."
msgstr ""
"Mesec %(month)s je zatvoren, a i tekući mesec %(current)s — nema gde da se "
"upiše trošak. Ponovo otvorite mesec sa razlogom."

#: src/web/cash.py:174
msgid "Точка не найдена."
msgstr "Objekat nije pronađen."

#: src/web/cash.py:190
msgid "Касса не найдена."
msgstr "Kasa nije pronađena."

#: src/web/cash.py:322
msgid "Месяц закрылся, пока расход вносили. Откройте форму заново."
msgstr "Mesec je zatvoren dok je trošak unošen. Otvorite formu ponovo."

#: src/web/cash.py:350
msgid ""
"Расход на всю сеть вносит тот, кто ведёт все точки партнёра. Выберите свою "
"точку."
msgstr ""
"Trošak za celu mrežu unosi onaj ko vodi sve objekte partnera. Izaberite svoj "
"objekat."

#: src/web/cash.py:533
msgid "Месяц закрылся, пока расход удаляли. Откройте список заново."
msgstr "Mesec je zatvoren dok je trošak brisan. Otvorite listu ponovo."

#: src/web/cash.py:760
msgid ""
"Форма устарела или испорчена. Откройте её заново и внесите расход ещё раз."
msgstr ""
"Forma je zastarela ili oštećena. Otvorite je ponovo i unesite trošak još "
"jednom."

#: src/web/cash_views.py:52
msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому вносить расход некуда. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati ni jednom partneru, pa nema gde da se unese trošak. "
"Zamolite administratora mreže da vas doda."

#: src/web/cash_views.py:111 src/web/cash_views.py:298
msgid "Дата расхода"
msgstr "Datum troška"

#: src/web/cash_views.py:114
#, python-format
msgid "«%(label)s»: расход на ноль не вносится."
msgstr "„%(label)s“: trošak sa iznosom nula se ne unosi."

#: src/web/cash_views.py:125 src/web/cash_views.py:335
#: src/web/templates/web/cash/expenses.html:61
msgid "Комментарий"
msgstr "Komentar"

#: src/web/cash_views.py:142 src/web/cash_views.py:145
msgid "Ставка НДС"
msgstr "Stopa PDV-a"

#: src/web/cash_views.py:145
#, python-format
msgid "«%(label)s»: ставки больше 100%% не бывает."
msgstr "„%(label)s“: stopa preko 100%% nije moguća."

#: src/web/cash_views.py:185 src/web/cash_views.py:244
#: src/web/directory_views.py:222 src/web/directory_views.py:230
