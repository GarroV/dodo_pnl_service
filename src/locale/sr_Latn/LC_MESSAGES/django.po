msgstr "Pravna lica"

#: src/web/directory_views.py:164
msgid "С кем работает бухгалтерия: название и налоговый номер"
msgstr "Sa kim radi računovodstvo: naziv i poreski broj"

#: src/web/directory_views.py:169 src/web/expense_items_views.py:219
