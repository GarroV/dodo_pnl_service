msgstr "%(count)s osobama"

msgid "Константы страны"
msgstr "Konstante zemlje"

msgid "Ставки налогов и взносов"
msgstr "Stope poreza i doprinosa"

msgid "Типы часов"
msgstr "Tipovi sati"

msgid "Надбавки"
msgstr "Dodaci"

msgid "Доплата до минимума"
msgstr "Doplata do minimuma"

msgid "Схемы расчёта"
msgstr "Šeme obračuna"

msgid "Пороги отчёта расхождений"
msgstr "Pragovi izveštaja o odstupanjima"

msgid "правила страны"
msgstr "pravila zemlje"

msgid "настройка партнёра"
msgstr "podešavanje partnera"

msgid "переопределение группы"
msgstr "izmena grupe"

msgid "переопределение по человеку"
msgstr "izmena zaposlenog"

#, python-format
msgid ""
"«%(label)s»: значения «%(value)s» нет в правилах страны. Допустимо: "
"%(allowed)s."
msgstr ""
"„%(label)s“: vrednost „%(value)s“ ne postoji u pravilima zemlje. Dozvoljeno: "
"%(allowed)s."

#, python-format
msgid "«%(label)s»: нужно «да» или «нет», а не «%(value)s»."
msgstr "„%(label)s“: potrebno je „da“ ili „ne“, a ne „%(value)s“."

#, python-format
msgid "«%(label)s»: значение обязательно."
msgstr "„%(label)s“: vrednost je obavezna."

msgid ""
"С этой даты расчёт берёт новое значение, месяцы до неё считаются по-"
"прежнему. Правила берутся на месяц целиком, поэтому дата внутри месяца "
"подействует только со следующего: чтобы правка сработала на весь месяц, "
"ставьте первое число."
msgstr ""
"Od ovog datuma obračun uzima novu vrednost, meseci pre njega se i dalje "
"računaju kao ranije. Pravila se uzimaju za mesec u celini, pa datum unutar "
"meseca deluje tek od sledećeg: da bi izmena važila za ceo mesec, unesite "
"prvi dan."

#, python-format
msgid ""
"Версия заведена с %(date)s, а действовать начнёт с расчёта за %(starts)s: "
"правила берутся на месяц целиком. %(inside)s останется посчитанным по-"
"прежнему — нужна была правка с начала месяца, заведите версию с %(first)s."
msgstr ""
"Verzija je zavedena od %(date)s, ali će važiti tek od obračuna za "
"%(starts)s: pravila se uzimaju za mesec u celini. %(inside)s ostaje "
"obračunat kao ranije — ako vam je trebala izmena od početka meseca, zavedite "
"verziju od %(first)s."

msgid ""
"Правила страны — общая база для всех партнёров этой страны, поэтому их ведёт "
"не партнёр, а администратор платформы. Для себя любое из них можно "
"переопределить формой ниже: правило страны от этого не меняется."
msgstr ""
"Pravila zemlje su zajednička osnova za sve partnere te zemlje, pa ih ne vodi "
"partner nego administrator platforme. Za sebe možete da izmenite bilo koje "
"od njih formom ispod: pravilo zemlje se time ne menja."

msgid ""
"Название правила страны заведено на всех языках сразу, и меняется оно вместе "
"с пресетом страны, а не с этого экрана."
msgstr ""
"Naziv pravila zemlje je zaveden na svim jezicima odjednom i menja se zajedno "
"sa presetom zemlje, a ne sa ovog ekrana."

msgid ""
"Правил этой страны на указанную дату в базе нет — менять нечего. Сначала "
"загрузите пресет страны: python manage.py load_presets"
msgstr ""
"Za ovu zemlju na ovaj datum u bazi nema pravila — nema šta da se menja. Prvo "
"učitajte preset zemlje: python manage.py load_presets"

msgid "Правила расчёта"
msgstr "Pravila obračuna"

msgid "Правил этой страны на указанную дату в базе нет — менять нечего."
msgstr ""
"Za ovu zemlju na ovaj datum u bazi nema pravila — nema šta da se menja."

msgid "Правило страны и так такое — новая версия не заведена."
msgstr "Pravilo zemlje je već takvo — nova verzija nije zavedena."

msgid "да"
msgstr "da"

msgid "нет"
msgstr "ne"

msgid "Поле «Действует с» обязательно."
msgstr "Polje „Od“ je obavezno."

#, python-format
msgid "«Действует с»: дата пишется как 2026-06-01, а не «%(value)s»."
msgstr "„Od“: datum se piše kao 2026-06-01, a ne „%(value)s“."

msgid ""
"Кто именно не прошёл проверку, видно тому, кому отдан весь расчёт партнёра, "
"— спросите бухгалтера или оперативного директора."
msgstr ""
"Ko tačno nije prošao proveru vidi onaj kome je dat ceo obračun partnera — "
"pitajte računovođu ili operativnog direktora."

msgid "У счёта нет ни одной строки: оплачивать нечего."
msgstr "Faktura nema nijednu stavku: nema šta da se plati."

#, python-format
msgid "Оплата счёта %(number)s"
msgstr "Plaćanje fakture %(number)s"

msgid "Оплата поставщику"
msgstr "Plaćanje dobavljaču"

msgid "Счёт не найден."
msgstr "Faktura nije pronađena."

msgid "Строка не найдена."
msgstr "Red nije pronađen."

msgid "Оплата"
msgstr "Plaćanje"

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому счетов у вас нет. Попросите "
"администратора сети добавить вас."
msgstr ""
"Još niste dodati nijednom partneru, pa nemate fakture. Zamolite "
"administratora mreže da vas doda."

msgid "оплачен"
msgstr "plaćena"

msgid "оплачен частично"
msgstr "delimično plaćena"

msgid "не оплачен"
msgstr "neplaćena"

msgid "Все контрагенты"
msgstr "Svi partneri"

msgid "Только неоплаченные"
msgstr "Samo neplaćene"

msgid "Только оплаченные"
msgstr "Samo plaćene"

msgid "Все счета"
msgstr "Sve fakture"

#, python-format
msgid "Счёт записан в период %(month)s."
msgstr "Faktura je zavedena u period %(month)s."

#, python-format
msgid ""
"Месяц %(month)s закрыт, поэтому счёт учтён в открытом периоде — дата "
"документа осталась прежней (правка задним числом идёт отдельной строкой)."
msgstr ""
"Mesec %(month)s je zatvoren, pa je faktura ušla u otvoreni period — datum "
"dokumenta je ostao isti (unos unazad ide kao poseban red)."

#, python-format
msgid "Оплата записана в период %(month)s."
msgstr "Plaćanje je zavedeno u period %(month)s."

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому вносить счёт некуда. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati nijednom partneru, pa nema gde da se unese faktura. "
"Zamolite administratora mreže da vas doda."

#, python-format
msgid "Счёт %(number)s"
msgstr "Faktura %(number)s"

msgid "Счёт"
msgstr "Faktura"

msgid "Новый счёт"
msgstr "Nova faktura"

msgid "Дата документа"
msgstr "Datum dokumenta"

#, python-format
msgid "«%(label)s»: счёт на ноль не вносится."
msgstr "„%(label)s“: faktura na nulu se ne unosi."

msgid "Номер счёта"
msgstr "Broj fakture"

msgid "Период учёта"
msgstr "Obračunski period"

#, python-format
msgid ""
"Контрагент «%(title)s» на %(date)s не действует: выберите другого или "
"поправьте даты в справочнике."
msgstr ""
"Partner „%(title)s“ ne važi na dan %(date)s: izaberite drugog ili ispravite "
"datume u šifarniku."

msgid "Дата на самом счёте."
msgstr "Datum koji stoji na samoj fakturi."

msgid ""
"Месяц, к которому счёт относится. Счёт за июнь приходит в июле — в P&L он "
"должен попасть в июнь. Пусто — месяц документа."
msgstr ""
"Mesec na koji se faktura odnosi. Faktura za jun stiže u julu — u P&L mora da "
"uđe u jun. Prazno znači mesec dokumenta."

msgid "Кому платим. Нет в списке — заведите его в справочнике контрагентов."
msgstr "Kome plaćamo. Nema ga na spisku — dodajte ga u šifarnik partnera."

msgid "Как счёт назван у поставщика. По нему его найдут в переписке."
msgstr "Broj koji je dao dobavljač. Po njemu se faktura pronalazi u prepisci."

msgid "Пока не разобрано"
msgstr "Još nije razvrstano"

msgid ""
"Можно не выбирать: счёт встанет в инбокс, и статью назначат там. Сумма при "
"этом видна в P&L, а не пропадает."
msgstr ""
"Ne morate birati: faktura ide u prijemno sanduče i stavka se dodeljuje tamo. "
"Iznos je i dalje vidljiv u P&L, ne nestaje."

msgid "Куда отнести расход. Регистр платежа приезжает из кассы отдельно."
msgstr "Gde trošak pripada. Registar plaćanja dolazi iz kase posebno."

msgid "Сумма документа, как она в счёте — с налогом, если он в нём есть."
msgstr "Iznos kako stoji na fakturi — sa porezom ako ga faktura sadrži."

msgid ""
"В процентах. Пусто — налог не выделен. В P&L по умолчанию едет сумма без "
"налога."
msgstr ""
"U procentima. Prazno znači da porez nije izdvojen. U P&L podrazumevano ide "
"iznos bez poreza."

msgid ""
"Чей это расход. «Вся сеть» — счёт на юрлицо целиком: его разнесёт правило "
"контрагента."
msgstr ""
"Čiji je to trošak. „Cela mreža“ znači da je faktura na pravno lice u celini: "
"raspodeliće je pravilo partnera."

#, python-format
msgid ""
"Месяц %(month)s закрыт. Правка не тронет его: в открытом периоде появятся "
"две строки — сторно прежней суммы и исправленная запись."
msgstr ""
"Mesec %(month)s je zatvoren. Izmena ga ne dira: u otvorenom periodu pojaviće "
"se dva reda — storno starog iznosa i ispravljeni unos."

msgid "наличными"
msgstr "gotovinom"

msgid "банком"
msgstr "preko banke"

msgid "Вас ещё не завели ни к одному партнёру, поэтому отмечать оплату нечему."
msgstr ""
"Još niste dodati nijednom partneru, pa nema šta da se označi kao plaćeno."

msgid "Отметить оплату"
msgstr "Označi plaćanje"

msgid "Сумма оплаты"
msgstr "Iznos plaćanja"

#, python-format
msgid "«%(label)s»: оплата на ноль не вносится."
msgstr "„%(label)s“: plaćanje na nulu se ne unosi."

msgid "Дата оплаты"
msgstr "Datum plaćanja"

msgid ""
"Когда деньги ушли. Это своя дата: она не обязана совпадать ни с датой счёта, "
"ни с периодом учёта."
msgstr ""
"Kada je novac otišao. To je zaseban datum: ne mora da se poklapa ni sa "
"datumom fakture ni sa obračunskim periodom."

msgid ""
"Меньше остатка — частичная оплата: остаток по счёту уменьшится на неё, а не "
"закроется."
msgstr ""
"Manje od preostalog iznosa znači delimično plaćanje: saldo se umanjuje, a ne "
"zatvara."

msgid "Оплачено банком"
msgstr "Plaćeno preko banke"

msgid "Если платили наличными. Регистр учёта тогда приезжает из кассы."
msgstr "Ako je plaćeno gotovinom. Registar tada dolazi iz kase."

msgid "Как у кассы"
msgstr "Kao kod kase"

msgid "Пусто — регистр берётся из кассы, а без кассы остаётся официальным."
msgstr "Prazno znači da se registar uzima iz kase, a bez kase ostaje zvanični."

msgid "Вас ещё не завели ни к одному партнёру, поэтому вносить оплату некуда."
msgstr "Još niste dodati nijednom partneru, pa nema gde da se unese plaćanje."

msgid "Когда деньги ушли. Счёта нет, поэтому расход признаётся этой датой."
msgstr "Kada je novac otišao. Fakture nema, pa se trošak priznaje tim datumom."

msgid "Кому заплатили. Нет в списке — заведите его в справочнике."
msgstr "Kome je plaćeno. Nema ga na spisku — dodajte ga u šifarnik."

msgid "Можно не выбирать: строка встанет в инбокс и будет видна числом."
msgstr ""
"Ne morate birati: red ide u prijemno sanduče i ostaje vidljiv kao broj."

msgid "Вас ещё не завели ни к одному партнёру, поэтому разбирать нечего."
msgstr "Još niste dodati nijednom partneru, pa nema šta da se razvrstava."

msgid ""
"Строка не разобрана: выберите статью и точку и попробуйте ещё раз. Строка "
"осталась в списке."
msgstr ""
"Red nije razvrstan: izaberite stavku i objekat pa pokušajte ponovo. Red je "
"ostao na spisku."

#, python-format
msgid "Строка разобрана и учтена в периоде %(month)s."
msgstr "Red je razvrstan i zaveden u period %(month)s."

#, python-format
msgid ""
"Месяц %(month)s закрыт, поэтому разбор лёг в открытый период двумя строками: "
"сторно прежней и разобранная запись."
msgstr ""
"Mesec %(month)s je zatvoren, pa je razvrstavanje ušlo u otvoreni period kao "
"dva reda: storno prethodnog i razvrstani unos."

msgid "Периоды"
msgstr "Periodi"

msgid "Внести расход"
msgstr "Unesi trošak"

msgid "Расход попадёт в P&L строкой своей статьи."
msgstr "Trošak ulazi u P&L kao stavka svoje kategorije."

msgid "Записано."
msgstr "Zapisano."

msgid "Не записано."
msgstr "Nije zapisano."

msgid "Записать расход"
msgstr "Sačuvaj trošak"

msgid "← К расходам"
msgstr "← Na troškove"

msgid "Месяц закрыт."
msgstr "Mesec zatvoren."

msgid "Удалить расход"
msgstr "Obriši trošak"

msgid "Строка больше не действует."
msgstr "Red više nije važeći."

msgid "Эта версия записи заменена: правьте ту, которая действует сейчас."
msgstr "Ova verzija zapisa je zamenjena: uredite onu koja je trenutno važeća."

msgid "Расходы"
msgstr "Troškovi"

msgid "Наличные из кассы точек."
msgstr "Gotovina iz kasa objekata."

msgid "Не показано."
msgstr "Nije prikazano."

msgid "Показать"
msgstr "Prikaži"

msgid "Дата"
msgstr "Datum"

msgid "Статья"
msgstr "Stavka"

msgid "НДС"
msgstr "PDV"

msgid "Состояние"
msgstr "Stanje"

#, python-format
msgid "учтён в %(month)s"
msgstr "obračunato za %(month)s"

#, python-format
msgid "Итого по %(counter)s строке"
msgid_plural "Итого по %(counter)s строкам"
msgstr[0] "Ukupno za %(counter)s red"
msgstr[1] "Ukupno za %(counter)s reda"
msgstr[2] "Ukupno za %(counter)s redova"

msgid "Расходов нет."
msgstr "Nema troškova."

msgid ""
"Под выбранный отбор ничего не подошло. Снимите точку, статью, регистр или\n"
"раздвиньте даты — и станет видно всё, что есть за месяц."
msgstr ""
"Za izabrani filter nije se našlo ništa. Uklonite objekat, stavku, knjigu ili "
"raširite datume — i videćete sve što postoji za mesec."

msgid "Показать весь месяц"
msgstr "Prikaži ceo mesec"

msgid "За этот месяц расходов ещё нет"
msgstr "Za ovaj mesec još nema troškova"

msgid ""
"Сюда попадает то, что тратят из кассы на точках: дата, сумма, статья "
"расхода\n"
"и точка. Управляющий вносит расход с телефона за минуту, и строка "
"появляется\n"
"здесь сразу — ждать конца месяца не нужно."
msgstr ""
"Ovde stiže ono što se troši iz kase na objektima: datum, iznos, stavka "
"troška i objekat. Menadžer unosi trošak sa telefona za minut, i red se "
"pojavljuje ovde odmah — nema potrebe čekati kraj meseca."

msgid "Внести первый расход"
msgstr "Unesi prvi trošak"

msgid "Нераспределённое"
msgstr "Neraspoređeno"

msgid "Расходы без точки: сумма есть по сети, но её нет ни на одной точке."
msgstr ""
"Troškovi bez objekta: iznos postoji na nivou mreže, ali ni na jednom objektu."

msgid "Пересчёт разнесения."
msgstr "Ponovni obračun raspodele."

msgid "Разнести по правилам"
msgstr "Raspodeli po pravilima"

msgid "Откуда"
msgstr "Poreklo"

msgid "Почему ждёт"
msgstr "Zašto čeka"

msgid "Итого ждёт разнесения"
msgstr "Ukupno čeka raspodelu"

msgid "Нераспределённого нет."
msgstr "Nema neraspoređenog."

msgid "Все расходы лежат на точках: закрывать месяц ничто не держит."
msgstr "Svi troškovi su na objektima: ništa ne sprečava zatvaranje meseca."

msgid "В таблице"
msgstr "U tabeli"

msgid "В расчёте"
msgstr "U obračunu"

msgid "Разница"
msgstr "Razlika"

msgid "Входы сошлись — расхождение даёт правило расчёта."
msgstr "Ulazi se poklapaju — odstupanje daje pravilo obračuna."

msgid "Выгрузки и сверка"
msgstr "Izvozi i usaglašavanje"

msgid "Ведомость к выплате"
msgstr "Obračunska lista za isplatu"

msgid "Строки для P&L"
msgstr "Redovi za P&L"

msgid "Строки для P&L с НДС"
msgstr "P&L redovi sa PDV-om"

msgid "Вид бухгалтера"
msgstr "Prikaz knjigovođe"

msgid "Сверка с таблицей"
msgstr "Usaglašavanje sa tabelom"

msgid "Основная навигация"
msgstr "Glavna navigacija"

msgid "Счета"
msgstr "Fakture"

msgid "Справочники"
msgstr "Imenici"

msgid "Правила"
msgstr "Pravila"

msgid "Роли"
msgstr "Uloge"

msgid "как это работает"
msgstr "kako ovo radi"

msgid ""
"На странице входа есть кнопки быстрого входа учётками сида (DEV_LOGIN=1)"
msgstr ""
"Stranica za prijavu ima dugmad za brzu prijavu sa seed nalozima (DEV_LOGIN=1)"

msgid "dev-вход"
msgstr "dev prijava"

msgid "Данные и итоги на всех страницах — только по этой точке"
msgstr "Podaci i zbirovi na svim stranicama — samo za ovaj objekat"

#, python-format
msgid "точка: %(code)s"
msgstr "objekat: %(code)s"

msgid "пароль"
msgstr "lozinka"

msgid "выйти"
msgstr "odjava"

msgid "войти"
msgstr "prijava"

msgid "Порядок работы за месяц"
msgstr "Redosled rada za mesec"

msgid "Этот экран вам не открыт."
msgstr "Ovaj ekran vam nije dostupan."

msgid "← К периодам"
msgstr "← Na periode"

msgid "Не сохранено."
msgstr "Nije sačuvano."

msgid "Выплаты по месяцам"
msgstr "Isplate po mesecima"

msgid "Карточка"
msgstr "Kartica"

msgid "Сохранить карточку"
msgstr "Sačuvaj karticu"

msgid "Условия найма"
msgstr "Uslovi zapošljavanja"

msgid ""
"Расчёт берёт версию, действующую в считаемом месяце. Поэтому закрытый месяц "
"не меняется от новой версии."
msgstr ""
"Obračun uzima verziju koja važi u mesecu koji se obračunava. Zato se "
"zatvoren mesec ne menja zbog nove verzije."

msgid "По"
msgstr "Do"

msgid "Условий найма нет."
msgstr "Nema uslova zapošljavanja."

msgid ""
"Без них расчёт не знает ни группы, ни точки, и человек не попадёт в "
"ведомость. Заведите первую версию формой ниже — с той даты, с которой "
"человек работает."
msgstr ""
"Bez njih obračun ne poznaje ni grupu ni objekat, i osoba neće ući u "
"obračunsku listu. Zavedite prvu verziju formom ispod — od datuma od kada "
"osoba radi."

msgid ""
"Без них расчёт не знает ни группы, ни точки, и человек не попадёт в "
"ведомость. Заводит их администратор сети."
msgstr ""
"Bez njih obračun ne poznaje ni grupu ni objekat, i osoba neće ući u "
"obračunsku listu. Zavodi ih administrator mreže."

msgid "Новая версия условий"
msgstr "Nova verzija uslova"

msgid ""
"Прежняя версия закрывается днём начала новой и остаётся в истории. Ничего не "
"изменилось — версия не заводится."
msgstr ""
"Prethodna verzija se zatvara danom početka nove i ostaje u istoriji. Ako se "
"ništa nije promenilo, verzija se ne zavodi."

msgid "Завести версию"
msgstr "Dodaj verziju"

msgid "Сохранено."
msgstr "Sačuvano."

msgid "Из чего расчёт берёт людей, ставки, точки и норму часов."
msgstr "Odakle obračun uzima ljude, stope, objekte i normu časova."

msgid "Часть месяцев уже закрыта"
msgstr "Deo meseci je već zatvoren"

msgid ""
"Схему расчёта и регистр группы это не касается: версий по датам у них нет\n"
"  вовсе, и такая правка задним числом по-прежнему отклоняется."
msgstr ""
"Ovo se ne odnosi na šemu obračuna i registar grupe: one uopšte nemaju "
"verzije po datumima, pa se takva izmena unazad i dalje odbija."

msgid "Справочник"
msgstr "Imenik"

msgid "Что в нём"
msgstr "Šta sadrži"

msgid "Записей"
msgstr "Zapisa"

msgid "Не загружено."
msgstr "Nije učitano."

msgid "Найти"
msgstr "Pretraga"

msgid "Файл бухгалтера (.xlsx)"
msgstr "Fajl knjigovođe (.xlsx)"

msgid "Строка P&L для статей, где её нет в файле"
msgstr "P&L red za stavke kod kojih ga nema u fajlu"

msgid "Не задана — такие строки будут пропущены"
msgstr "Nije podešeno — takvi redovi će biti preskočeni"

msgid "Доступ закрыт"
msgstr "Pristup zatvoren"

msgid "Это вам не открыто."
msgstr "Ovo vam nije otvoreno."

msgid ""
"Если работа требует этого раздела, попросите доступ у того, кто ведёт учётки."
msgstr ""
"Ako vam je za rad potreban ovaj odeljak, zatražite pristup od onoga ko vodi "
"naloge."

msgid "Страница устарела"
msgstr "Stranica je zastarela"

msgid "Действие не выполнено."
msgstr "Radnja nije izvršena."

msgid ""
"Откройте страницу заново и повторите — так бывает, если вкладка была открыта "
"долго или вы входили в другом окне."
msgstr ""
"Otvorite stranicu ponovo i pokušajte opet — to se dešava ako je kartica bila "
"dugo otvorena ili ste se prijavili u drugom prozoru."

msgid "Страница не найдена"
msgstr "Stranica nije pronađena"

msgid "Здесь ничего нет"
msgstr "Ovde nema ničega"

msgid ""
"Проверьте адрес: возможно, в нём опечатка или страница больше не открывается."
msgstr ""
"Proverite adresu: možda ima greške u kucanju ili se stranica više ne otvara."

msgid "К списку периодов"
msgstr "Na spisak perioda"

msgid "Что-то сломалось"
msgstr "Nešto se pokvarilo"

msgid "Как это работает"
msgstr "Kako ovo radi"

msgid ""
"Эта страница объясняет продукт целиком: что он делает, кто в нём\n"
"работает и как проходит месяц. Она открывается с любого экрана и читается\n"
"до входа — в том числе чтобы понять, кем входить."
msgstr ""
"Ova stranica objašnjava proizvod u celini: šta radi, ko u njemu radi i kako "
"protiče mesec. Otvara se sa svakog ekrana i čita se pre prijave — i zato da "
"bi se razumelo kojom ulogom se prijaviti."

msgid "Что это за продукт"
msgstr "Šta je ovaj proizvod"

msgid ""
"Продукт собирает первичные данные пиццерий партнёра и складывает из них\n"
"  P&amp;L единого формата. Первичные данные — это часы сотрудников, условия "
"найма,\n"
"  наличные расходы с точек, счета поставщиков и выручка. Раньше всё это жило "
"в\n"
"  таблицах Excel и считалось руками, каждый месяц заново."
msgstr ""
"Proizvod prikuplja primarne podatke picerija partnera i od njih sastavlja "
"P&amp;L jedinstvenog formata. Primarni podaci su sati zaposlenih, uslovi "
"zapošljavanja, gotovinski troškovi sa objekata, fakture dobavljača i prihod. "
"Ranije je sve to živelo u Excel tabelama i računalo se ručno, svakog meseca "
"ponovo."

msgid "Какую работу он снимает:"
msgstr "Koji posao preuzima na sebe:"

msgid "Повторный ввод."
msgstr "Ponovni unos."

msgid ""
"Часы, выручка и списания приходят из Dodo IS. Руками вносят только то, чего\n"
"      там нет или что разошлось с фактом на точке."
msgstr ""
"Sati, prihod i otpisi dolaze iz Dodo IS. Ručno se unosi samo ono čega tamo "
"nema ili što se razišlo sa stvarnim stanjem na objektu."

msgid "Подсчёт руками."
msgstr "Ručno računanje."

msgid ""
"Зарплата считается по правилам страны, а правила версионированы по датам:\n"
"      изменение ставки в июле не переписывает уже закрытый июнь."
msgstr ""
"Zarada se obračunava po pravilima zemlje, a pravila su verzionisana po "
"datumima: promena stope u julu ne prepisuje već zatvoreni jun."

msgid "Поиск, откуда взялась сумма."
msgstr "Traženje odakle je iznos došao."

msgid ""
"Любое число раскрывается до правил и входов, по которым оно посчитано.\n"
"      Это след расчёта, и он есть у каждой суммы, а не у избранных."
msgstr ""
"Svaki broj se može raširiti do pravila i ulaza po kojima je obračunat. To je "
"trag obračuna, i ima ga svaki iznos, a ne samo odabrani."

msgid "Сведение вручную."
msgstr "Ručno svođenje."

msgid ""
"Точки и юрлица сходятся в один отчёт без переклейки листов, а разные\n"
"      валюты — в одну валюту консолидации."
msgstr ""
"Objekti i pravna lica se slivaju u jedan izveštaj bez prelepljivanja "
"listova, a različite valute — u jednu valutu konsolidacije."

msgid "Месяц от начала до конца"
msgstr "Mesec od početka do kraja"

msgid ""
"Это главный сценарий продукта, и порядок в нём обязательный: каждый\n"
"  следующий шаг невозможен без предыдущего. На экранах месяца тот же "
"порядок\n"
"  показан полосой шагов, чтобы было видно, где вы сейчас."
msgstr ""
"Ovo je glavni scenario proizvoda, i redosled u njemu je obavezan: svaki "
"sledeći korak nije moguć bez prethodnog. Na ekranima meseca isti redosled je "
"prikazan trakom koraka, da bi se videlo gde ste sada."

msgid "Табель"
msgstr "Evidencija sati"

msgid ""
"Часы за месяц по каждой точке. Основная часть приезжает из Dodo IS;\n"
"      управляющий проверяет свою точку и правит то, что разошлось. Когда "
"часы\n"
"      точки готовы, их закрывают — по каждой точке отдельно, и месяц не "
"ждёт\n"
"      самую медленную."
msgstr ""
"Sati za mesec po svakom objektu. Osnovni deo dolazi iz Dodo IS; menadžer "
"proverava svoj objekat i ispravlja ono što se razišlo. Kada su sati objekta "
"gotovi, zatvaraju se — po svakom objektu odvojeno, i mesec ne čeka "
"najsporiji."

msgid ""
"Ведут: управляющие точек. Заканчивается тем, что часы всех точек закрыты."
msgstr ""
"Vode: menadžeri objekata. Završava se time što su sati svih objekata "
"zatvoreni."

msgid ""
"Расчёт берёт условия найма и правила, действующие на дату периода, и\n"
"      считает каждому человеку начисления, надбавки и удержания. Идёт в "
"фоне:\n"
"      со страницы можно уйти и вернуться, расчёт не прервётся."
msgstr ""
"Obračun uzima uslove zapošljavanja i pravila koja važe na datum perioda i "
"svakoj osobi obračunava primanja, dodatke i odbitke. Ide u pozadini: sa "
"stranice se može otići i vratiti, obračun se neće prekinuti."

msgid "Ведёт: тот, кто считает месяц. Заканчивается тем, что период посчитан."
msgstr ""
"Vodi: onaj ko obračunava mesec. Završava se time što je period obračunat."

msgid "Ведомость"
msgstr "Obračunska lista"

msgid ""
"Итог расчёта построчно: человек, компоненты выплаты, итого к выплате.\n"
"      Любую сумму можно раскрыть до правил и входов. Спорную строку — "
"заморозить,\n"
"      чтобы она не держала весь месяц; разницу за уже закрытый месяц — "
"перенести\n"
"      в текущий."
msgstr ""
"Rezultat obračuna red po red: osoba, komponente isplate, ukupno za isplatu. "
"Svaki iznos se može raširiti do pravila i ulaza. Sporni red se može "
"zamrznuti, da ne drži ceo mesec; razliku za već zatvoreni mesec — preneti u "
"tekući."

msgid ""
"Здесь же сверка с таблицей бухгалтера: расчёт продукта рядом с его "
"собственным."
msgstr ""
"Tu je i usaglašavanje sa tabelom knjigovođe: obračun proizvoda pored "
"njegovog sopstvenog."

msgid "Закрытие"
msgstr "Zatvaranje"

msgid ""
"Период утверждают. До утверждения продукт сам перечисляет, что мешает:\n"
"      незакрытые часы, замороженные строки, расходы без точки. Утверждённый "
"месяц\n"
"      дальше только читают — правка идёт откатом с причиной, и причина "
"остаётся\n"
"      в истории."
msgstr ""
"Period se odobrava. Do odobrenja proizvod sam navodi šta ga sprečava: "
"nezatvoreni sati, zamrznuti redovi, troškovi bez objekta. Odobreni mesec se "
"dalje samo čita — ispravka ide vraćanjem uz razlog, i razlog ostaje u "
"istoriji."

msgid ""
"Заканчивается тем, что месяц утверждён, а файлы к выплате и для P&L "
"выгружены."
msgstr ""
"Završava se time što je mesec odobren, a datoteke za isplatu i za P&L "
"izvezene."

msgid "Кто в нём работает"
msgstr "Ko u njemu radi"

msgid ""
"Роль — это набор прав, и у каждого набора своя работа и свой первый\n"
"  экран. Один и тот же экран показывает разным людям разные числа, поэтому "
"в\n"
"  шапке всегда написано, чьими глазами вы смотрите."
msgstr ""
"Uloga je skup prava, i svaki skup ima svoj posao i svoj prvi ekran. Isti "
"ekran prikazuje različitim ljudima različite brojeve, zato u zaglavlju uvek "
"stoji čijim očima gledate."

msgid ""
"За компьютером и подолгу, привык к Excel. Первым делом идёт не на витрину,\n"
"        а в список месяцев: ему нужно понять, в каком они состоянии и что от "
"него\n"
"        ждут сейчас. Настоящее доверие к продукту у него появляется на "
"экране\n"
"        сверки, где его собственная таблица стоит рядом с расчётом."
msgstr ""
"Za računarom i podugo, navikao je na Excel. Prvo ne ide na izlog, nego u "
"spisak meseci: treba mu da razume u kakvom su stanju i šta se od njega sada "
"očekuje. Pravo poverenje u proizvod dobija na ekranu usaglašavanja, gde "
"njegova sopstvena tabela stoji pored obračuna."

msgid ""
"С телефона, стоя на точке, заходит на две минуты. Его экран — несколько\n"
"        крупных действий и ничего больше: отметить часы, внести расход из "
"кассы,\n"
"        сфотографировать накладную. Сумм расчёта он не видит, и это не "
"урезание\n"
"        прав, а его работа: донести первичку, а не посчитать её."
msgstr ""
"Sa telefona, stojeći na objektu, ulazi na dva minuta. Njegov ekran su "
"nekoliko krupnih radnji i ništa više: označiti sate, uneti trošak iz kase, "
"fotografisati otpremnicu. Iznose obračuna ne vidi, i to nije skraćivanje "
"prava, nego njegov posao: doneti primarni dokument, a ne obračunati ga."

msgid ""
"Компьютер и телефон, урывками, между точками. Смотрит состояние сети "
"целиком:\n"
"        где часы не закрыты, где расчёт не запущен, где месяц висит "
"неутверждённым,\n"
"        что выбилось за порог и какие строки заморожены как спорные."
msgstr ""
"Računar i telefon, na prekide, između objekata. Gleda stanje mreže u celini: "
"gde sati nisu zatvoreni, gde obračun nije pokrenut, gde mesec visi "
"neodobren, šta je izašlo iz granica i koji su redovi zamrznuti kao sporni."

msgid ""
"Тот, кто отвечает деньгами. Заходит редко, но каждая его правка меняет\n"
"        расчёт, поэтому справочники и правила показывают даты действия и "
"историю\n"
"        версий. Данных расчёта ему при этом не открыто: он распоряжается\n"
"        устройством учёта, а не суммами."
msgstr ""
"Onaj ko odgovara novcem. Ulazi retko, ali svaka njegova ispravka menja "
"obračun, zato šifarnici i pravila prikazuju datume važenja i istoriju "
"verzija. Podaci obračuna mu pri tome nisu otvoreni: on upravlja ustrojstvom "
"evidencije, a ne iznosima."

msgid "только своя"
msgstr "samo svoj"

msgid "все точки партнёра"
msgstr "svi objekti partnera"

msgid "Что ведёт"
msgstr "Šta vodi"

msgid "только чтение"
msgstr "samo čitanje"

msgid ""
"Права режет сама база, а не экран. Строку, которой роль не видит, она не\n"
"  получит ни на странице, ни в выгрузке, ни через API — поэтому раздел, "
"которого\n"
"  у роли нет, в шапке не показывается вовсе, а не отвечает отказом по "
"нажатию."
msgstr ""
"Prava reže sama baza, a ne ekran. Red koji uloga ne vidi, ona neće dobiti ni "
"na stranici, ni u izvozu, ni preko API-ja — zato se odeljak koji uloga nema "
"u zaglavlju ne prikazuje uopšte, a ne odgovara odbijanjem na klik."

msgid "Наличные, расходы и поставщики"
msgstr "Gotovina, troškovi i dobavljači"

msgid ""
"Зарплата — не единственная первичка. Вторая половина P&amp;L собирается из\n"
"  того, что тратят на точках и платят поставщикам, и эта половина приходит "
"не\n"
"  файлом раз в месяц, а по одной записи каждый день."
msgstr ""
"Zarada nije jedini primarni podatak. Druga polovina P&amp;L sastavlja se od "
"onoga što se troši na objektima i plaća dobavljačima, i ta polovina ne "
"dolazi datotekom jednom mesečno, nego po jednom zapisu svakog dana."

msgid "Расход из кассы."
msgstr "Trošak iz kase."

msgid ""
"Управляющий вносит его с телефона за минуту: дата, сумма, статья, точка.\n"
"      Расход, у которого точки нет, попадает в нераспределённое — это трата\n"
"      юрлица целиком, и она разносится по точкам правилом, а не на глаз."
msgstr ""
"Menadžer ga unosi sa telefona za minut: datum, iznos, stavka, objekat. "
"Trošak koji nema objekat ide u neraspoređeno — to je trošak pravnog lica u "
"celini, i raspodeljuje se po objektima pravilom, a ne na oko."

msgid "Счёт и платёж — разные события."
msgstr "Faktura i plaćanje su različiti događaji."

msgid ""
"Счёт ставит расход в тот месяц, к которому относится, и виден в\n"
"      обязательствах, пока не оплачен. Платёж — это движение денег. Поэтому\n"
"      оплата, прошедшая позже, не переписывает уже закрытый месяц."
msgstr ""
"Faktura stavlja trošak u onaj mesec na koji se odnosi i vidi se u obavezama "
"dok nije plaćena. Plaćanje je kretanje novca. Zato uplata koja je prošla "
"kasnije ne prepisuje već zatvoreni mesec."

msgid "Инбокс классификации."
msgstr "Prijemno sanduče razvrstavanja."

msgid ""
"Всё, что продукт не смог отнести сам, собирается в одну очередь: платёж без\n"
"      статьи, бумага с точки, неразобранное вложение. Человек разбирает это\n"
"      пачкой в одном месте, а не ищет по экранам."
msgstr ""
"Sve što proizvod nije mogao sam da rasporedi skuplja se u jedan red: "
"plaćanje bez stavke, papir sa objekta, nerazvrstan prilog. Čovek to "
"razvrstava u grupi na jednom mestu, a ne traži po ekranima."

msgid "Бумага с точки."
msgstr "Papir sa objekta."

msgid ""
"Управляющий фотографирует накладную или чек и скидывает — считать ему\n"
"      ничего не нужно. В P&amp;L бумага попадёт после разбора, а не сразу: "
"до этого\n"
"      она лежит в очереди как непонятая."
msgstr ""
"Menadžer fotografiše otpremnicu ili račun i šalje ga — ne mora ništa da "
"obračunava. U P&amp;L papir stiže tek posle razvrstavanja, a ne odmah: do "
"tada čeka u redu kao nerazvrstan."

msgid "Регистры учёта"
msgstr "Knjige"

msgid ""
"Один и тот же месяц собирается в нескольких параллельных регистрах сразу.\n"
"  Регистр — свойство сотрудника, группы или отдельной операции, а не "
"компании:\n"
"  поэтому в одной ведомости строки разных регистров стоят рядом, и у каждой\n"
"  стоит своя метка."
msgstr ""
"Isti mesec se sastavlja u nekoliko paralelnih knjiga odjednom. Knjiga je "
"svojstvo zaposlenog, grupe ili pojedinačne operacije, a ne kompanije: zato u "
"jednoj obračunskoj listi redovi različitih knjiga stoje jedan pored drugog, "
"i svaki nosi svoju oznaku."

msgid ""
"Что из этого видно вам, задаёт ваша роль, и срез делают политики базы, а не\n"
"  фильтр на экране. Итоги всегда сходятся с тем, что вам видно: продукт не\n"
"  показывает сумму, собранную из строк, которых вы не можете прочитать."
msgstr ""
"Šta vam je od toga vidljivo, zadaje vaša uloga, a presek prave politike "
"baze, a ne filter na ekranu. Zbirovi se uvek slažu sa onim što vam je "
"vidljivo: proizvod ne prikazuje iznos sastavljen iz redova koje ne možete "
"pročitati."

#, python-format
msgid ""
"Вам сейчас видно: %(names)s. Тот же список стоит в шапке на каждой странице."
msgstr ""
"Vama je sada vidljivo: %(names)s. Isti spisak stoji u zaglavlju na svakoj "
"stranici."

msgid "Какие регистры видны именно вам, будет написано в шапке после входа."
msgstr ""
"Koje su knjige vidljive upravo vama, biće napisano u zaglavlju nakon prijave."

msgid "С чего начать"
msgstr "Odakle početi"

msgid ""
"Работа идёт внутри месяца: откройте список периодов и выберите тот, который\n"
"  ведёте. Если месяц ещё не начат, на его странице написано, что произойдёт "
"при\n"
"  открытии и с чего начать."
msgstr ""
"Rad se odvija unutar meseca: otvorite spisak perioda i izaberite onaj koji "
"vodite. Ako mesec još nije počet, na njegovoj stranici je napisano šta će se "
"dogoditi pri otvaranju i odakle početi."

msgid ""
"Пока вы не вошли, продукт не показывает ничего: без пользователя политики\n"
"  доступа отдают пустой результат, а не чужие данные. Логин и пароль выдаёт\n"
"  администратор сети — с ними станет видно ровно то, что положено вашей роли."
msgstr ""
"Dok se ne prijavite, proizvod ne prikazuje ništa: bez korisnika politike "
"pristupa vraćaju prazan rezultat, a ne tuđe podatke. Login i lozinku izdaje "
"administrator mreže — s njima ćete videti tačno ono što pripada vašoj ulozi."

msgid "Войти"
msgstr "Prijavi se"

msgid "Вход"
msgstr "Prijava"

msgid "Логин и пароль выдаёт администратор сети."
msgstr "Administrator mreže izdaje login i lozinku."

msgid "Это демо-стенд"
msgstr "Ovo je demo okruženje"

msgid ""
"Учётка здесь не нужна: демо открывается одним кликом и наполнено выдуманной\n"
"  сетью — два юрлица, три точки, тридцать человек и три месяца расчёта."
msgstr ""
"Ovde nije potreban račun: demo se otvara jednim klikom i napunjen je "
"izmišljenom mrežom — dva pravna lica, tri objekta, trideset ljudi i tri "
"meseca obračuna."

msgid "Открыть демо"
msgstr "Otvori demo"

msgid "Логин"
msgstr "Korisničko ime"

msgid "Пароль"
msgstr "Lozinka"

msgid "Быстрый вход на время стройки"
msgstr "Brza prijava za vreme gradnje"

msgid ""
"Кнопка подставляет пароль учётки тестового сида и идёт тем же путём, что "
"ввод\n"
"  руками — отдельного способа войти у неё нет. Выключается переменной "
"окружения\n"
"  <code>DEV_LOGIN=0</code>; выданные ею сессии при этом перестают "
"действовать."
msgstr ""
"Dugme automatski unosi lozinku test seed naloga i ide istim putem kao ručni\n"
"  unos — poseban način prijave ne postoji. Isključuje se promenljivom "
"okruženja\n"
"  <code>DEV_LOGIN=0</code>; sesije koje je izdalo tada prestaju da važe."

msgid "Смена пароля"
msgstr "Promena lozinke"

msgid "Пароль знает только его владелец: в базе лежит не он, а его хэш."
msgstr "Lozinku zna samo njen vlasnik: u bazi se ne čuva ona, već njen heš."

msgid "Пароль изменён."
msgstr "Lozinka promenjena."

msgid "Пароль не изменён."
msgstr "Lozinka nije promenjena."

msgid "Сменить"
msgstr "Promeni"

msgid "Расчёт выполнен. Ниже — то, что видно вашей роли."
msgstr "Obračun je završen. Ispod je ono što je vidljivo vašoj ulozi."

msgid "Расчёт принят и считается в фоне. Страницу можно не держать открытой."
msgstr ""
"Obračun je prihvaćen i računa se u pozadini. Stranicu ne morate držati "
"otvorenom."

#, python-format
msgid "%(done)s из %(total)s сотрудников"
msgstr "%(done)s od %(total)s zaposlenih"

msgid "Состояние расчёта не отвечает — пробуем ещё раз"
msgstr "Stanje obračuna ne odgovara — pokušavamo ponovo"

msgid "Идёт расчёт периода"
msgstr "Obračun perioda je u toku"

msgid "Посчитать прямо сейчас"
msgstr "Obračunaj odmah"

msgid "Обновите страницу, чтобы увидеть, чем закончился расчёт."
msgstr "Osvežite stranicu da vidite čime se obračun završio."

msgid "Период утверждён. Расчёт и его данные заморожены."
msgstr "Period je odobren. Obračun i njegovi podaci su zamrznuti."

msgid "Период открыт заново. Причина и ваше имя записаны в историю."
msgstr "Period je ponovo otvoren. Razlog i vaše ime su zabeleženi u istoriji."

msgid "Строка заморожена. Пересчёт её обходит, остальные считаются как прежде."
msgstr ""
"Red je zamrznut. Ponovni obračun ga zaobilazi, ostali se računaju kao i pre."

msgid "Заморозка снята. Человек вернулся в общий расчёт."
msgstr "Zamrzavanje je uklonjeno. Osoba se vratila u zajednički obračun."

msgid "Расчёт зарплаты"
msgstr "Obračun zarade"

msgid "Сотрудников в табеле"
msgstr "Zaposlenih u evidenciji sati"

msgid "Последний расчёт"
msgstr "Poslednji obračun"

msgid "не считался"
msgstr "nije obračunat"

msgid "Посчитать период"
msgstr "Obračunaj period"

msgid "Расхождения"
msgstr "Odstupanja"

msgid "Расчёт уйдёт в очередь, страница обновится сама."
msgstr "Obračun ide u red čekanja; stranica se sama osvežava."

msgid "Считается сразу."
msgstr "Računa se odmah."

msgid "Повторный запуск пересобирает ведомость заново."
msgstr "Ponovno pokretanje ponovo sastavlja obračunsku listu."

msgid "Разница перенесена. Закрытый период при этом не изменился."
msgstr "Razlika je preneta. Zatvoreni period pritom nije izmenjen."

msgid "Разница за закрытый месяц ещё не в ведомости."
msgstr "Razlika za zatvoreni mesec još nije u obračunskoj listi."

#, python-format
msgid ""
"Перенос за %(title)s отменён — этот месяц пересчитали, и разница\n"
"        вошла в него самого. В ведомости она пока осталась (%(shown)s):\n"
"        пересчитайте период."
msgstr ""
"Prenos za %(title)s je otkazan — taj mesec je ponovo obračunat, i razlika\n"
"        je ušla u njega samog. U obračunskoj listi ona je za sada ostala "
"(%(shown)s):\n"
"        ponovo obračunajte period."

#, python-format
msgid ""
"Перенос за %(title)s на сумму %(live)s в ведомость ещё не\n"
"        вошёл: пересчитайте период."
msgstr ""
"Prenos za %(title)s u iznosu od %(live)s još nije\n"
"        ušao u obračunsku listu: ponovo obračunajte period."

msgid "Сверить закрытый месяц с сегодняшними данными не удалось."
msgstr "Nije uspelo usaglašavanje zatvorenog meseca sa današnjim podacima."

msgid "Данные этого месяца изменились после утверждения"
msgstr "Podaci ovog meseca su se promenili posle odobrenja"

#, python-format
msgid ""
"Расхождение с тем, что хранит закрытый месяц: <strong>%(total)s</strong> по "
"%(employees)s чел."
msgstr ""
"Razlika u odnosu na ono što čuva zatvoreni mesec: <strong>%(total)s</strong> "
"za %(employees)s zaposlenih."

msgid "У этого партнёра разница переносится в текущий период."
msgstr "Kod ovog partnera razlika se prenosi u tekući period."

msgid "У этого партнёра период открывается заново и пересчитывается."
msgstr "Kod ovog partnera period se ponovo otvara i preračunava."

#, python-format
msgid "Перенести разницу в %(target)s"
msgstr "Prenesi razliku u %(target)s"

#, python-format
msgid ""
"Закрытый период не изменится: разница ляжет помеченной строкой в\n"
"    %(target)s, в тот же регистр учёта."
msgstr ""
"Zatvoreni period se neće promeniti: razlika će biti uneta kao označeni red "
"u\n"
"    %(target)s, u istu knjigu."

msgid ""
"У этого партнёра правки задним числом ведутся пересчётом: откройте период\n"
"    заново с указанием причины и посчитайте его снова."
msgstr ""
"Kod ovog partnera se izmene unazad rade ponovnim obračunom: ponovo otvorite "
"period\n"
"    uz navođenje razloga i ponovo ga obračunajte."

msgid "Утвердить период"
msgstr "Odobri period"

msgid "После утверждения расчёт и его данные меняться не будут."
msgstr "Posle odobrenja, obračun i njegovi podaci se neće menjati."

msgid "Причина попадёт в историю рядом с вашим именем."
msgstr "Razlog će biti zabeležen u istoriji pored vašeg imena."

msgid "Зачем открываете период"
msgstr "Zašto ponovo otvarate period"

msgid "например: ошиблись в часах за третью неделю"
msgstr "na primer: pogrešno uneti sati za treću nedelju"

msgid "История периода"
msgstr "Istorija perioda"

msgid "Когда"
msgstr "Kada"

msgid "Что стало"
msgstr "Šta je promenjeno"

msgid "Причина"
msgstr "Razlog"

msgid "мимо приложения"
msgstr "mimo aplikacije"

msgid "Разрез ведомости по регистрам"
msgstr "Prikaz obračunske liste po knjigama"

msgid "Спор"
msgstr "Spor"

#, python-format
msgid "Перерасчёт за %(title)s"
msgstr "Ponovni obračun za %(title)s"

msgid "Заморожена"
msgstr "Zamrznut"

msgid "Снять заморозку"
msgstr "Ukini zamrzavanje"

msgid "Заморозить"
msgstr "Zamrzni"

msgid "из-за чего спор"
msgstr "zbog čega je spor"

msgid "Как получилась эта сумма"
msgstr "Kako je dobijen ovaj iznos"

#, python-format
msgid "Итого · %(employees)s чел."
msgstr "Ukupno · %(employees)s zaposlenih"

msgid "Итоги по регистрам"
msgstr "Ukupno po knjigama"

msgid ""
"Итог посчитан по тому, что видно вашей роли: строки чужих регистров не "
"доезжают до страницы и не входят в сумму."
msgstr ""
"Zbir je izračunat na osnovu onoga što je vidljivo vašoj ulozi: redovi iz "
"tuđih knjiga ne stižu do stranice i ne ulaze u zbir."

#, python-format
msgid ""
"Сейчас показан один регистр — %(title)s;\n"
"  итог посчитан по нему."
msgstr ""
"Trenutno je prikazana jedna knjiga — %(title)s;\n"
"  zbir je izračunat na osnovu nje."

msgid "Ведомости пока нет"
msgstr "Obračunske liste još nema"

msgid ""
"Месяц начинается с часов: без них считать нечего. Внесите их в табеле\n"
"    руками или загрузите таблицей партнёра, а потом вернитесь сюда и "
"посчитайте\n"
"    период."
msgstr ""
"Mesec počinje satima: bez njih nema šta da se obračuna. Unesite ih u "
"evidenciju sati\n"
"    ručno ili učitajte tabelom partnera, a zatim se vratite ovde i "
"obračunajte\n"
"    period."

msgid "Перейти к табелю"
msgstr "Idi na evidenciju sati"

msgid ""
"Часы за месяц уже внесены — осталось посчитать период. Ведомость появится\n"
"    здесь же: строка на каждого сотрудника в каждом регистре, который видно\n"
"    вашей роли."
msgstr ""
"Sati za mesec su već uneti — ostalo je da se obračuna period. Obračunska "
"lista će se pojaviti\n"
"    ovde: red za svakog zaposlenog u svakoj knjizi koja je vidljiva\n"
"    vašoj ulozi."

msgid "Откройте месяц — работа идёт внутри него."
msgstr "Otvorite mesec — rad se odvija unutar njega."

msgid "Партнёр"
msgstr "Partner"

msgid "Учётных месяцев пока не видно"
msgstr "Obračunski meseci se još ne vide"

msgid ""
"Месяц заводится вместе с данными партнёра. Если продукт только что "
"поставили,\n"
"  наполните базу тестовыми данными командой <code>manage.py seed_dev</"
"code>.\n"
"  Если месяцы уже заведены, значит их не видит ваша роль — попросите доступ "
"у того,\n"
"  кто заводит пользователей."
msgstr ""
"Mesec se kreira zajedno sa podacima partnera. Ako je proizvod tek "
"instaliran,\n"
"  napunite bazu test podacima komandom <code>manage.py seed_dev</code>.\n"
"  Ako meseci već postoje, znači da ih vaša uloga ne vidi — zatražite pristup "
"od onoga\n"
"  ko kreira korisnike."

msgid "Сначала войдите"
msgstr "Prvo se prijavite"

msgid ""
"Пока вы не вошли, база не показывает ничего: без пользователя политики "
"доступа\n"
"  отдают пустой результат, а не чужие данные."
msgstr ""
"Dok se ne prijavite, baza ne prikazuje ništa: bez korisnika, politike "
"pristupa\n"
"  vraćaju prazan rezultat, a ne tuđe podatke."

#, python-format
msgid "Выплаты: %(name)s"
msgstr "Isplate: %(name)s"

msgid "← К карточке сотрудника"
msgstr "← Na karticu zaposlenog"

msgid "Как это шло"
msgstr "Kako je teklo"

msgid "Месяц за месяцем"
msgstr "Mesec po mesec"

msgid "Часы"
msgstr "Sati"

msgid "Начислено"
msgstr "Obračunati iznos"

msgid "На руки"
msgstr "Neto za isplatu"

msgid "Итого за всё время"
msgstr "Ukupno za sve vreme"

msgid "Из чего складывается"
msgstr "Od čega se sastoji"

msgid ""
"Строка — месяц и регистр учёта: регистр это свойство компонента, а не "
"человека, и у одного месяца их бывает два."
msgstr ""
"Red je mesec i knjiga: knjiga je svojstvo komponente, a ne osobe, i jedan "
"mesec ih ponekad ima dve."

msgid "Выплат по этому человеку не видно."
msgstr "Nema vidljivih isplata za ovu osobu."

msgid ""
"Месяц появляется здесь после расчёта — и только те месяцы, строки которых "
"видно вашей роли. Посчитать месяц можно на странице периода."
msgstr ""
"Mesec se ovde pojavljuje nakon obračuna — i to samo oni meseci čije redove "
"vidi vaša uloga. Mesec možete obračunati na stranici perioda."

#, python-format
msgid "Сверка · %(period_title)s"
msgstr "Usaglašavanje · %(period_title)s"

#, python-format
msgid "Сверка с таблицей бухгалтера · %(period_title)s"
msgstr "Usaglašavanje sa tabelom knjigovođe · %(period_title)s"

msgid ""
"Файл сравнивается с расчётом этого периода построчно. Он нигде не\n"
"  сохраняется — ни на диск, ни в базу: ответ живёт только на этой странице."
msgstr ""
"Fajl se poredi sa obračunom ovog perioda red po red. Nigde se ne\n"
"  čuva — ni na disk, ni u bazu: rezultat postoji samo na ovoj stranici."

msgid "Таблица бухгалтера (.xlsx)"
msgstr "Tabela knjigovođe (.xlsx)"

msgid "Сверить"
msgstr "Uporedi"

msgid "Сверка не выполнена."
msgstr "Usaglašavanje nije izvršeno."

msgid "Что получилось"
msgstr "Rezultat"

msgid "Итог сверки"
msgstr "Rezultat usaglašavanja"

msgid "Сошлось до копейки"
msgstr "Poklopilo se do pare"

msgid "Разошлось на копейки (округление)"
msgstr "Odstupilo za pare (zaokruživanje)"

msgid "Разошлось"
msgstr "Odstupilo"

msgid "Сверены только входы — деньги не сравнивались"
msgstr "Upoređeni samo ulazi — iznosi nisu upoređeni"

msgid "Есть в таблице, нет в вашей части расчёта"
msgstr "Ima u tabeli, nema u vašem delu obračuna"

msgid "Есть в расчёте, нет в таблице"
msgstr "Postoji u obračunu, ne postoji u tabeli"

msgid "не проверялось"
msgstr "nije provereno"

#, python-format
msgid ""
"К выплате по сверенным строкам: в таблице %(expected)s,\n"
"          в расчёте %(actual)s"
msgstr ""
"Za isplatu po usaglašenim redovima: u tabeli %(expected)s,\n"
"          u obračunu %(actual)s"

msgid ""
"Деньги не сравнивались ни по одной строке: итоги расчёта\n"
"          вам не отданы. Ноль в такой сумме означал бы совпадение, поэтому\n"
"          её здесь нет."
msgstr ""
"Iznosi nisu upoređeni ni za jedan red: ukupni iznosi obračuna\n"
"          vam nisu dati. Nula u takvom iznosu bi značila poklapanje, zato\n"
"          je ovde nema."

msgid ""
"Деньги не сравнивались: ни одна строка файла не сопоставлена с\n"
"          расчётом этого периода. Дело не в доступе — сверять было нечего;\n"
"          что именно не сопоставилось, видно в разделах ниже."
msgstr ""
"Iznosi nisu upoređivani: nijedan red fajla nije povezan sa obračunom ovog\n"
"          perioda. Nije stvar u pristupu — nije imalo šta da se uporedi;\n"
"          šta tačno nije povezano vidi se u odeljcima ispod."

msgid ""
"Деньги не сравнивались: итогов расчёта по этим людям нет в самом\n"
"          расчёте. Доступ здесь ни при чём — период посчитан не по ним."
msgstr ""
"Iznosi nisu upoređivani: u samom obračunu nema ukupnih iznosa za ove\n"
"          ljude. Pristup tu nije u pitanju — period za njih nije obračunat."

msgid ""
"Деньги не сравнивались: в файле нет ни одного числа, которое сверка\n"
"          сравнивает, — ни к выплате, ни бруто, ни взносов."
msgstr ""
"Iznosi nisu upoređivani: u fajlu nema nijednog broja koji usaglašavanje\n"
"          poredi — ni za isplatu, ni bruto, ni doprinose."

msgid ""
"Деньги не сравнивались: числа есть с обеих сторон, но ни разу не\n"
"          встретились в одной строке."
msgstr ""
"Iznosi nisu upoređivani: brojevi postoje na obe strane, ali se nijednom "
"nisu\n"
"          našli u istom redu."

msgid "Всё сошлось до копейки, и файл прочитан целиком."
msgstr "Sve se poklopilo do pare, i fajl je pročitan u celosti."

msgid ""
"<strong>Кого расчёт посчитал сверх вашей таблицы — не проверялось.</strong>\n"
"  Расчёт периода отдаётся вашей роли не весь, поэтому сказать, чего в\n"
"  принесённом файле не хватает, сверка не может: она сравнила бы вашу "
"таблицу с\n"
"  той частью, которую видит сама, и назвала бы это фактом о расчёте. Всё\n"
"  остальное выше сверено полностью — по каждой строке вашего файла."
msgstr ""
"<strong>Koga je obračun obuhvatio van vaše tabele — nije provereno.</"
"strong>\n"
"Obračun perioda vašoj ulozi nije ustupljen u celini, pa provera ne može da "
"kaže\n"
"šta nedostaje u donetom fajlu: uporedila bi vašu tabelu sa delom koji sama "
"vidi\n"
"i to nazvala činjenicom o obračunu. Sve ostalo iznad provereno je u celini "
"—\n"
"za svaki red vašeg fajla."

msgid ""
"Сверху то, что разошлось сильнее. Под каждой строкой — что разошлось на\n"
"  входе: если входы сошлись, а итог нет, значит разошлось правило расчёта."
msgstr ""
"Na vrhu je ono što najviše odstupa. Ispod svakog reda — šta je odstupilo na\n"
"  ulazu: ako su ulazi poklopljeni, a zbir nije, znači da je odstupilo "
"pravilo obračuna."

msgid "Разошлось на копейки"
msgstr "Odstupilo za pare"

msgid ""
"Меньше динара — округление на стороне бухгалтерии. Это не совпадение, но и\n"
"  не повод искать ошибку в правиле."
msgstr ""
"Manje od dinara — zaokruživanje na strani knjigovodstva. To nije poklapanje, "
"ali\n"
"  ni razlog da se traži greška u pravilu."

#, python-format
msgid "Сверены только входы · %(inputs_count)s"
msgstr "Upoređeni samo ulazi · %(inputs_count)s"

msgid ""
"Итоги расчёта по этим строкам вам не отданы: нето, бруто и взносы посчитаны\n"
"  по строке ведомости целиком, и база показывает их только роли, которой "
"видны\n"
"  все регистры учёта. Поэтому <strong>деньги здесь не сравнивались</strong> "
"— ни\n"
"  одного нашего числа по ним не показано, и совпадением это не считается."
msgstr ""
"Ukupni iznosi obračuna za ove redove vam nisu dati: neto, bruto i doprinosi "
"se računaju\n"
"  za obračunski red u celini, a baza ih prikazuje samo ulozi kojoj su "
"vidljive\n"
"  sve knjige. Zato <strong>iznosi ovde nisu upoređeni</strong> — nijedan\n"
"  naš broj za njih nije prikazan, i to se ne smatra poklapanjem."

msgid ""
"Сверено то, что от регистра не зависит: часы, ставка, коэффициент. "
"Расхождение\n"
"  чаще всего сидит именно там."
msgstr ""
"Upoređeno je ono što ne zavisi od knjige: sati, stopa, koeficijent. "
"Odstupanje\n"
"  najviše leži baš tu."

msgid "Что со входами"
msgstr "Šta je sa ulazima"

msgid "Входы сошлись с таблицей."
msgstr "Ulazi su se poklopili sa tabelom."

msgid "В файле нет ни часов, ни ставки — сравнивать было нечего."
msgstr "U fajlu nema ni sati ni stope — nije imalo šta da se uporedi."

msgid ""
"По этим строкам сверять нечего: в расчёт, отданный вам, они не входят. Это\n"
"  <strong>не значит</strong>, что расчёта по ним не было: сверка показывает\n"
"  ровно то, что база показывает вам, и отличить «строки нет вовсе» от "
"«строка\n"
"  вам не видна» она не может. Ни одного числа с нашей стороны здесь не\n"
"  показано — сравнивать не с чем."
msgstr ""
"Za ove redove nema šta da se uporedi: nisu u obračunu koji vam je predat. "
"To\n"
"  <strong>ne znači</strong> da obračuna za njih nije bilo: usaglašavanje\n"
"  prikazuje tačno ono što vam baza prikazuje, i ne može da razlikuje „reda\n"
"  uopšte nema“ od „red vam nije vidljiv“. Nijedan naš broj ovde nije\n"
"  prikazan — nema sa čim da se uporedi."

msgid ""
"Это не предупреждения: перечисленное в сверку <strong>не попало</strong>,\n"
"  поэтому сошедшееся выше сошлось не по всему файлу."
msgstr ""
"Ovo nisu upozorenja: navedeno <strong>nije ušlo</strong> u usaglašavanje,\n"
"  zato se poklapanje prikazano iznad ne odnosi na ceo fajl."

#, python-format
msgid "Сошлось до копейки · %(matched_count)s"
msgstr "Poklopilo se do pare · %(matched_count)s"

msgid "Роли и права"
msgstr "Uloge i prava"

msgid ""
"Роль — это набор прав, а человеку можно дать несколько ролей сразу. Так "
"бухгалтер, который ведёт весь проект, становится ещё и администратором, а "
"там, где это разные люди, разделение обязанностей остаётся."
msgstr ""
"Uloga je skup prava, a jedna osoba može imati više uloga odjednom. Tako "
"računovođa koji vodi ceo projekat postaje i administrator, a tamo gde su to "
"različiti ljudi podela odgovornosti ostaje."

msgid "Что позволяет роль"
msgstr "Šta uloga dozvoljava"

msgid "Права"
msgstr "Prava"

msgid "У кого какая роль"
msgstr "Ko ima koju ulogu"

msgid ""
"В списке только те, кому уже выдана хотя бы одна роль: он и собирается из\n"
"выданных ролей. Человек, у которого ролей нет, здесь не появится — и это не\n"
"значит, что его нет в системе."
msgstr ""
"U spisku su samo oni kojima je izdata barem jedna uloga: on se i sastavlja "
"od izdatih uloga. Osoba koja nema nijednu ulogu ovde se ne pojavljuje — i to "
"ne znači da je nema u sistemu."

msgid "Человек"
msgstr "Osoba"

msgid "Выдать роль"
msgstr "Dodeli ulogu"

msgid "Снять роль"
msgstr "Ukloni ulogu"

msgid "Выдать"
msgstr "Dodeli"

msgid ""
"Страна поставляется готовым набором правил. Партнёр меняет только отличия — "
"новой версией с датой: закрытый месяц от этого не двигается, потому что "
"расчёт берёт версию, действовавшую в считаемом месяце."
msgstr ""
"Zemlja dolazi sa spremnim skupom pravila. Partner menja samo razlike — novom "
"verzijom sa datumom: zatvoren mesec se time ne pomera, jer obračun uzima "
"verziju koja je važila u mesecu koji se obračunava."

msgid "Действующие на"
msgstr "Na dan"

msgid "Правило"
msgstr "Pravilo"

msgid "Часть кода правила: night, sick, net_factor"
msgstr "Deo koda pravila: night, sick, net_factor"

#, python-format
msgid "Набор правил: %(code)s (%(country)s)"
msgstr "Skup pravila: %(code)s (%(country)s)"

msgid "Значение"
msgstr "Vrednost"

msgid "Задано отдельно"
msgstr "Zadato posebno"

msgid "По этому запросу правил нет."
msgstr "Za ovaj upit nema pravila."

msgid ""
"Поиск идёт по коду правила — той самой строке, которой правило адресуется "
"расчёту: hour_types.night.pay_percent. Очистите поле, чтобы увидеть весь "
"набор."
msgstr ""
"Pretraga ide po kodu pravila — onom istom nizu znakova kojim se pravilo "
"obraća obračunu: hour_types.night.pay_percent. Ispraznite polje da vidite "
"ceo skup."

msgid "Правил расчёта для этой страны на эту дату в базе нет."
msgstr "Za ovu zemlju na ovaj datum u bazi nema pravila obračuna."

msgid ""
"Первичная загрузка страны делается командой load_presets — до неё считать "
"нечем, и показывать здесь тоже нечего."
msgstr ""
"Prvo učitavanje zemlje se radi komandom load_presets — pre toga nema čime da "
"se računa, pa nema ni šta da se prikaže ovde."

msgid "← К правилам"
msgstr "← Na pravila"

#, python-format
msgid "Сейчас действует: %(value)s — %(origin)s"
msgstr "Trenutno važi: %(value)s — %(origin)s"

#, python-format
msgid "с %(day)s"
msgstr "od %(day)s"

msgid "Правило страны"
msgstr "Pravilo zemlje"

#, python-format
msgid "В правилах %(country)s: %(value)s — набор %(preset)s"
msgstr "U pravilima %(country)s: %(value)s — preset %(preset)s"

msgid "Заведена"
msgstr "Zavedena"

msgid "в продукте"
msgstr "u proizvodu"

msgid "из пресета страны"
msgstr "iz preseta zemlje"

msgid ""
"Новая версия правил страны действует на всех партнёров этой страны. Прежняя "
"закрывается днём начала новой и остаётся в истории: уже посчитанные месяцы "
"собираются своей версией и не двигаются."
msgstr ""
"Nova verzija pravila zemlje važi za sve partnere te zemlje. Prethodna se "
"zatvara danom početka nove i ostaje u istoriji: već obračunati meseci se "
"sastavljaju od svoje verzije i ne pomeraju se."

msgid "Значение в правилах страны"
msgstr "Vrednost u pravilima zemlje"

msgid "Завести версию правил страны"
msgstr "Dodaj verziju pravila zemlje"

msgid ""
"Название правила заведено на всех языках сразу и меняется вместе с пресетом "
"страны, а не с этого экрана."
msgstr ""
"Naziv pravila je zaveden na svim jezicima odjednom i menja se zajedno sa "
"presetom zemlje, a ne sa ovog ekrana."

msgid "Версии переопределений"
msgstr "Verzije izmena"

msgid "Уровень"
msgstr "Nivo"

msgid "Кому"
msgstr "Kome"

msgid "Это правило никто не переопределял."
msgstr "Za ovo pravilo nema nijedne izmene."

msgid ""
"Значение приходит из правил страны. Первая же версия ниже станет "
"переопределением — на том уровне и с той даты, которые вы укажете."
msgstr ""
"Vrednost dolazi iz pravila zemlje. Prva verzija ispod postaje izmena — na "
"nivou i od datuma koji navedete."

msgid "Новая версия правила"
msgstr "Nova verzija pravila"

msgid ""
"Уровни складываются: значение группы сильнее значения партнёра, значение "
"человека сильнее обоих."
msgstr ""
"Nivoi se nadograđuju: vrednost grupe je jača od vrednosti partnera, a "
"vrednost osobe je jača od obe."

msgid "Через запятую."
msgstr "Odvojeno zarezom."

msgid "Инбокс"
msgstr "Prijemno sanduče"

msgid "← К счетам"
msgstr "← Nazad na fakture"

msgid "Строки без статьи. Деньги уже в P&L, но не там, где их будут искать."
msgstr "Redovi bez stavke. Novac je već u P&L, ali ne tamo gde će ga tražiti."

msgid "Бумаги с точек"
msgstr "Papiri sa objekata"

#, python-format
msgid "ждёт разбора %(counter)s строка"
msgid_plural "ждут разбора %(counter)s строк"
msgstr[0] "%(counter)s red čeka razvrstavanje"
msgstr[1] "%(counter)s reda čeka razvrstavanje"
msgstr[2] "%(counter)s redova čeka razvrstavanje"

msgid "Разобрать"
msgstr "Razvrstaj"

msgid "Итого без статьи"
msgstr "Ukupno bez stavke"

msgid "Инбокс пуст."
msgstr "Prijemno sanduče je prazno."

msgid "У всех строк есть статья: разбирать нечего."
msgstr "Svi redovi imaju stavku: nema šta da se razvrstava."

#, python-format
msgid "ждёт разбора %(counter)s бумага"
msgid_plural "ждут разбора %(counter)s бумаг"
msgstr[0] "%(counter)s papir čeka razvrstavanje"
msgstr[1] "%(counter)s papira čeka razvrstavanje"
msgstr[2] "%(counter)s papira čeka razvrstavanje"

msgid "суммы со слов управляющих, в P&L их нет"
msgstr "iznosi po izjavi menadžera, njih nema u P&L-u"

msgid "Сумма со слов"
msgstr "Iznos po izjavi"

msgid "Открыть бумагу"
msgstr "Otvori papir"

msgid "Бумаг на разбор нет."
msgstr "Nema papira koji čekaju razvrstavanje."

msgid "Всё, что принесли с точек, разобрано."
msgstr "Sve što je doneto sa objekata je razvrstano."

#, python-format
msgid "Сумма %(amount)s · оплачено %(paid)s · остаток %(left)s"
msgstr "Iznos %(amount)s · plaćeno %(paid)s · preostalo %(left)s"

msgid "Сохранить счёт"
msgstr "Sačuvaj fakturu"

msgid "Платежи по счёту"
msgstr "Plaćanja po fakturi"

msgid "Чем"
msgstr "Čime"

msgid "Оплат ещё не было."
msgstr "Još nema plaćanja."

msgid ""
"Счёт выставлен и висит в обязательствах: расход в P&L уже есть, деньги ещё "
"не ушли."
msgstr ""
"Faktura je izdata i stoji u obavezama: trošak je već u P&L, novac još nije "
"otišao."

msgid "Внести счёт"
msgstr "Unesi fakturu"

msgid "Что нам выставили поставщики и что из этого оплачено."
msgstr "Šta su nam dobavljači fakturisali i koliko je od toga plaćeno."

msgid "Оплата без счёта"
msgstr "Plaćanje bez fakture"

msgid "Номер"
msgstr "Broj"

msgid "Оплачено"
msgstr "Plaćeni iznos"

msgid "Остаток"
msgstr "Preostalo"

msgid "исправлен"
msgstr "ispravljena"

#, python-format
msgid "Итого по %(counter)s счёту"
msgid_plural "Итого по %(counter)s счетам"
msgstr[0] "Ukupno za %(counter)s fakturu"
msgstr[1] "Ukupno za %(counter)s fakture"
msgstr[2] "Ukupno za %(counter)s faktura"

msgid "не оплачено"
msgstr "još nije plaćeno"

msgid "Счетов нет."
msgstr "Nema faktura."

msgid ""
"Под выбранный отбор ничего не подошло. Снимите контрагента, регистр или\n"
"состояние оплаты, либо раздвиньте даты — и станет видно всё, что есть за "
"месяц."
msgstr ""
"Za izabrani filter nije se našlo ništa. Uklonite kontragenta, knjigu ili "
"stanje plaćanja, ili raširite datume — i videćete sve što postoji za mesec."

msgid "За этот месяц счетов ещё нет"
msgstr "Za ovaj mesec još nema faktura"

msgid ""
"Счёт от поставщика ставит расход в тот месяц, к которому относится, и висит\n"
"здесь в обязательствах, пока не оплачен. Платёж — уже отдельное событие,\n"
"поэтому оплата задним числом не переписывает закрытый месяц."
msgstr ""
"Faktura dobavljača stavlja trošak u onaj mesec na koji se odnosi i visi ovde "
"u obavezama dok nije plaćena. Plaćanje je već odvojen događaj, zato uplata "
"sa zakašnjenjem ne prepisuje zatvoreni mesec."

msgid "Внести первый счёт"
msgstr "Unesi prvu fakturu"

msgid "← К бумагам"
msgstr "← Nazad na papire"

msgid "Не разобрано."
msgstr "Nije razvrstano."

#, python-format
msgid "%(kind)s от %(date)s, точка %(unit)s"
msgstr "%(kind)s od %(date)s, objekat %(unit)s"

#, python-format
msgid "поставщик: %(party)s"
msgstr "dobavljač: %(party)s"

#, python-format
msgid "сумма со слов: %(amount)s"
msgstr "iznos po izjavi: %(amount)s"

msgid "Снимок принесённой бумаги"
msgstr "Snimak donetog papira"

#, python-format
msgid "Скачать файл (%(size)s)"
msgstr "Preuzmi fajl (%(size)s)"

msgid "Бумага ещё не разобрана."
msgstr "Papir još nije razvrstan."

msgid ""
"В P&L её нет: там живут строки учёта, а у этой бумаги их пока ни одной. "
"Назначьте поставщика, статью и период — и сумма встанет в отчёт."
msgstr ""
"Nije u P&L-u: tamo žive knjigovodstveni redovi, a ovaj papir ih još nema "
"nijednog. Dodelite dobavljača, stavku i period — i iznos će ući u izveštaj."

msgid "Разобрать бумагу"
msgstr "Razvrstaj papir"

msgid "Разобрать и учесть"
msgstr "Razvrstaj i zavedi"

msgid ""
"Разбирает бумагу тот, кто ведёт месяц: бухгалтер или оперативный директор. "
"Вы её донесли — этого достаточно, дальше сумма встанет в отчёт без вас."
msgstr ""
"Papir razvrstava onaj ko vodi mesec: knjigovođa ili operativni direktor. Vi "
"ste ga doneli — to je dovoljno, iznos će stići u izveštaj i bez vas."

msgid "Бумага разобрана."
msgstr "Papir je razvrstan."

msgid "Строки учтены и видны в P&L. Дальше правят счёт, а не бумагу."
msgstr ""
"Redovi su zavedeni i vidljivi u P&L-u. Dalje se menja faktura, a ne papir."

msgid "Открыть счёт"
msgstr "Otvori fakturu"

msgid "Скинуть накладную или чек"
msgstr "Pošalji otpremnicu ili račun"

msgid ""
"Сфотографируйте бумагу и приложите снимок. Поставщика, статью и период "
"назначит бухгалтер."
msgstr ""
"Fotografišite papir i priložite snimak. Dobavljača, stavku i period dodeliće "
"knjigovođa."

msgid "Не принято."
msgstr "Nije prihvaćeno."

msgid "Отправить бумагу"
msgstr "Pošalji papir"

msgid ""
"Накладные и чеки, принесённые с точек. Пока бухгалтер их не разобрал, в P&L "
"их нет."
msgstr ""
"Otpremnice i računi doneti sa objekata. Dok ih knjigovođa ne razvrsta, nema "
"ih u P&L-u."

msgid "сумма со слов, не расход"
msgstr "iznos po izjavi, nije trošak"

msgid "Всё разобрано."
msgstr "Sve je razvrstano."

msgid "Ни одна бумага не ждёт: у каждой есть строка в учёте."
msgstr "Nijedan papir ne čeka: svaki već ima red u knjigovodstvu."

msgid "ждёт разбора"
msgstr "čeka razvrstavanje"

#, python-format
msgid "разобрана, период %(month)s"
msgstr "razvrstan, period %(month)s"

msgid "Бумаг ещё не приносили."
msgstr "Papiri još nisu doneti."

msgid ""
"Управляющий фотографирует накладную или чек и скидывает сюда — считать ему "
"ничего не нужно."
msgstr ""
"Menadžer fotografiše otpremnicu ili račun i šalje ovde — on ne mora ništa da "
"računa."

msgid "← К счёту"
msgstr "← Nazad na fakturu"

#, python-format
msgid "сумма %(amount)s, остаток %(left)s"
msgstr "iznos %(amount)s, preostalo %(left)s"

msgid "Записать оплату"
msgstr "Zabeleži plaćanje"

msgid ""
"Мелкая покупка, за которую бумаги не будет: расход попадёт в P&L датой "
"оплаты."
msgstr ""
"Sitna kupovina za koju neće biti papira: trošak ulazi u P&L na datum "
"plaćanja."

msgid "След расчёта"
msgstr "Trag obračuna"

#, python-format
msgid "разрез: %(cut)s"
msgstr "prikaz: %(cut)s"

msgid "вернуться в ведомость"
msgstr "nazad na obračunsku listu"

msgid "Объяснить эту сумму нечем."
msgstr "Nema čime da se objasni ovaj iznos."

msgid "Сохранённые числа ниже показаны как есть."
msgstr "Sačuvani brojevi ispod su prikazani onakvi kakvi jesu."

#, python-format
msgid ""
"\n"
"  След <strong>сохранён</strong> при расчёте: показано то, чем считали, а "
"не\n"
"  пересчёт по сегодняшним правилам. Сходится с суммой строки до копейки\n"
"  (%(total)s).\n"
"  "
msgstr ""
"\n"
"  Trag je <strong>sačuvan</strong> prilikom obračuna: prikazuje ono čime se "
"računalo,\n"
"  a ne ponovni obračun po današnjim pravilima. Poklapa se sa iznosom reda do "
"pare\n"
"  (%(total)s).\n"
"  "

#, python-format
msgid ""
"\n"
"  След <strong>сохранён</strong> при расчёте, но с суммой строки\n"
"  <strong>не сходится</strong>: сохранено %(stored)s, шаги дают %(traced)s.\n"
"  Две записи одного расчёта разошлись — так бывает только от правки в обход\n"
"  продукта. Строки, где разошлось, помечены ниже.\n"
"  "
msgstr ""
"\n"
"  Trag je <strong>sačuvan</strong> prilikom obračuna, ali se sa iznosom "
"reda\n"
"  <strong>ne poklapa</strong>: sačuvano %(stored)s, koraci daju %(traced)s.\n"
"  Dva zapisa istog obračuna su se razišla — to se dešava samo od izmene "
"mimo\n"
"  proizvoda. Redovi gde je odstupilo označeni su ispod.\n"
"  "

#, python-format
msgid ""
"\n"
"  Сохранённого следа у этой строки нет — она посчитана раньше, чем он "
"появился,\n"
"  поэтому объяснение <strong>пересобрано</strong> по сегодняшним правилам.\n"
"  Сверено с сохранённой суммой строки: <strong>сходится</strong> до копейки\n"
"  (%(total)s), значит правила с момента расчёта не менялись.\n"
"  "
msgstr ""
"\n"
"  Za ovaj red nema sačuvanog traga — obračunat je pre nego što je trag "
"uveden,\n"
"  zato je objašnjenje <strong>ponovo sastavljeno</strong> po današnjim "
"pravilima.\n"
"  Upoređeno sa sačuvanim iznosom reda: <strong>poklapa se</strong> do pare\n"
"  (%(total)s), što znači da se pravila od obračuna nisu menjala.\n"
"  "

#, python-format
msgid ""
"\n"
"  Сохранённого следа у этой строки нет — она посчитана раньше, чем он "
"появился,\n"
"  поэтому объяснение <strong>пересобрано</strong> по сегодняшним правилам, — "
"и с\n"
"  сохранённой суммой <strong>не сходится</strong>: сохранено %(stored)s,\n"
"  сегодняшние правила дают %(traced)s. Строки, где разошлось, помечены "
"ниже.\n"
"  Ведомость показывает сохранённое — менять его этот экран не может и не "
"должен.\n"
"  "
msgstr ""
"\n"
"  Za ovaj red nema sačuvanog traga — obračunat je pre nego što je trag "
"uveden,\n"
"  zato je objašnjenje <strong>ponovo sastavljeno</strong> po današnjim "
"pravilima — i\n"
"  <strong>ne poklapa se</strong> sa sačuvanim iznosom: sačuvano %(stored)s,\n"
"  današnja pravila daju %(traced)s. Redovi gde je odstupilo označeni su "
"ispod.\n"
"  Obračunska lista prikazuje sačuvano — ovaj ekran ne može i ne sme da ga "
"menja.\n"
"  "

msgid ""
"Период утверждён: его числа неизменны, и объяснение выше — то самое, "
"которым\n"
"  их посчитали."
msgstr ""
"Period je odobren: njegovi brojevi su nepromenljivi, a objašnjenje iznad je "
"upravo ono\n"
"  kojim su izračunati."

msgid ""
"Период утверждён. Его числа неизменны, а объяснение — нет: оно "
"пересобирается\n"
"  каждый раз заново, поэтому сверка выше и нужна."
msgstr ""
"Period je odobren. Njegovi brojevi su nepromenljivi, a objašnjenje nije: ono "
"se ponovo sastavlja\n"
"  svaki put iznova, zato je usaglašavanje iznad i potrebno."

msgid "Шаг"
msgstr "Korak"

msgid "Из чего собрано"
msgstr "Sastavljeno od"

msgid "шага не было в расчёте"
msgstr "koraka nije bilo u obračunu"

#, python-format
msgid "было %(stored)s"
msgstr "bilo je %(stored)s"

msgid "Итого по следу"
msgstr "Ukupno po tragu"

msgid "Объяснять нечего"
msgstr "Nema šta da se objasni"

msgid "Шагов расчёта нет: посчитать заново нечем."
msgstr "Nema koraka obračuna: nema čime da se ponovo obračuna."

msgid "По этой строке нет ни одного шага, доступного вашей роли."
msgstr "Za ovaj red nema nijednog koraka dostupnog vašoj ulozi."

msgid "Перенос из закрытого месяца"
msgstr "Prenos iz zatvorenog meseca"

msgid "За какой месяц"
msgstr "Za koji mesec"

msgid "Итого строки ведомости"
msgstr "Ukupno obračunskog reda"

msgid ""
"Разница посчитана правилами того месяца, из которого приехала. Её след — на\n"
"  странице периода-источника, а не здесь: показать её шагами этого месяца\n"
"  значило бы объяснить сумму не тем расчётом."
msgstr ""
"Razlika je obračunata pravilima meseca iz kog je stigla. Njen trag je na\n"
"  stranici izvornog perioda, a ne ovde: prikazati je koracima ovog meseca\n"
"  značilo bi objasniti iznos pogrešnim obračunom."

msgid "Производные величины"
msgstr "Izvedene vrednosti"

msgid "Величина"
msgstr "Vrednost"

msgid ""
"Это не слагаемые строки, а следствия: складывать их с начислениями нельзя."
msgstr ""
"Ovo nisu sabirci reda, već posledice: ne mogu se sabirati sa stavkama "
"obračuna."

msgid "Расхождения с прошлым месяцем"
msgstr "Odstupanja u odnosu na prošli mesec"

#, python-format
msgid " против %(previous)s"
msgstr " u odnosu na %(previous)s"

#, python-format
msgid " · разрез: %(cut)s"
msgstr " · prikaz: %(cut)s"

msgid "Сравнивать не с чем"
msgstr "Nema sa čim da se poredi"

#, python-format
msgid ""
"Сравнивать не с чем: за %(previous)s в базе нет ни одной суммы,\n"
"  доступной вашей роли. Отчёт сравнивает месяц с предыдущим, поэтому у "
"первого\n"
"  посчитанного месяца расхождений не бывает по построению."
msgstr ""
"Nema sa čim da se poredi: za %(previous)s u bazi nema nijednog iznosa\n"
"  dostupnog vašoj ulozi. Izveštaj poredi mesec sa prethodnim, zato prvi\n"
"  obračunati mesec po definiciji nema odstupanja."

msgid "Разрез отчёта по регистрам"
msgstr "Prikaz izveštaja po knjigama"

msgid "Было"
msgstr "Bilo"

msgid "Стало"
msgstr "Postalo"

msgid "Отклонение"
msgstr "Odstupanje"

msgid "Порог"
msgstr "Prag"

#, python-format
msgid "Выросло · строк: %(grew_count)s"
msgstr "Poraslo · redova: %(grew_count)s"

#, python-format
msgid "Снизилось · строк: %(fell_count)s"
msgstr "Palo · redova: %(fell_count)s"

#, python-format
msgid ""
"Отклонения нашлись у %(employees_count)s чел. Одним числом они не "
"складываются:\n"
"  прибавка одному гасит убавку другому, и такая сумма читалась бы как «всё\n"
"  сошлось» над списком того, что не сошлось. Поэтому рост и снижение "
"показаны\n"
"  врозь."
msgstr ""
"Odstupanja su nađena kod %(employees_count)s zaposlenih. Ne sabiraju se u "
"jedan\n"
"  broj: rast kod jednog poništava pad kod drugog, i takav zbir bi se čitao "
"kao\n"
"  „sve se slaže“ iznad spiska onoga što se ne slaže. Zato su rast i pad\n"
"  prikazani odvojeno."

#, python-format
msgid ""
"Сравнено пар «сотрудник × компонент»: %(compared_count)s. Показаны только "
"те, где\n"
"  превышены оба порога сразу — процент и сумма. Пороги задаются правилами\n"
"  страны и переопределяются партнёром; в коде их нет."
msgstr ""
"Upoređeno parova „zaposleni × komponenta“: %(compared_count)s. Prikazani su "
"samo oni gde su\n"
"  prekoračena oba praga istovremeno — procenat i iznos. Pragovi su "
"definisani pravilima\n"
"  zemlje i partner ih može promeniti; u kodu ih nema."

msgid "Отклонений нет"
msgstr "Nema odstupanja"

#, python-format
msgid ""
"Отклонений выше порогов нет. Сравнено пар «сотрудник × компонент»:\n"
"  %(compared_count)s — то есть сравнение состоялось, а не было пропущено."
msgstr ""
"Nema odstupanja iznad pragova. Upoređeno parova „zaposleni × komponenta“:\n"
"  %(compared_count)s — što znači da je poređenje izvršeno, a ne preskočeno."

msgid ""
"Коробки, из которых платят наличными. Регистр учёта расхода приезжает из "
"кассы, а не выбирается к каждой трате."
msgstr ""
"Kutije iz kojih se plaća gotovinom. Knjiga troška dolazi iz kase, a ne bira "
"se za svaki trošak posebno."

msgid "Завести кассу"
msgstr "Dodaj kasu"

msgid "Касс нет."
msgstr "Nema kasa."

msgid ""
"Пока кассы не заведены, расход вносится без неё, а регистр учёта выбирается "
"руками."
msgstr ""
"Dok kase nisu zavedene, trošak se unosi bez nje, a knjiga se bira ručno."

msgid "Новая касса"
msgstr "Nova kasa"

msgid "← К кассам"
msgstr "← Na kase"

msgid "Короткий код кассы, например NS1-main."
msgstr "Kratka šifra kase, na primer NS1-main."

msgid "Касса стоит на точке, и расход из неё — расход этой точки."
msgstr "Kasa je na objektu, i trošak iz nje je trošak tog objekta."

msgid ""
"В него по умолчанию попадёт расход, оплаченный из этой кассы. Поменять "
"регистр у отдельной траты по-прежнему можно."
msgstr ""
"U nju će po podrazumevanoj vrednosti pasti trošak plaćen iz ove kase. Knjigu "
"za pojedinačni trošak i dalje je moguće promeniti."

msgid ""
"Касса закрывается датой, а не удалением: закрытые месяцы на неё ссылаются."
msgstr ""
"Kasa se zatvara datumom, a ne brisanjem: zatvoreni meseci se pozivaju na nju."

msgid "Открыт"
msgstr "Otvoren"

msgid "Закрыт"
msgstr "Zatvoren"

msgid "Заблокирован"
msgstr "Blokiran"

msgid ""
"Заморозка строки вам недоступна: она относится к строке ведомости целиком, а "
"расчёт строки отдаётся вашей роли не весь. Спорную строку заморозит тот, кто "
"ведёт месяц полностью. Утверждению периода это не мешает."
msgstr ""
"Zamrzavanje reda vam nije dostupno: odnosi se na red obračunskog lista u "
"celini, a obračun tog reda vašoj ulozi nije ustupljen u celini. Sporni red "
"zamrzava onaj ko vodi mesec u celini. Odobravanju perioda to ne smeta."

#, python-format
msgid "производственный календарь %(country)s"
msgstr "proizvodni kalendar %(country)s"

#, python-format
msgid "календарь %(country)s на этот месяц не заведён"
msgstr "kalendar za %(country)s za ovaj mesec nije unet"

msgid "Расчёт не выполнен."
msgstr "Obračun nije izvršen."

msgid "Период не утверждён."
msgstr "Period nije odobren."

msgid "Период не открыт."
msgstr "Period nije otvoren."

msgid "Разница не перенесена."
msgstr "Razlika nije preneta."

msgid "Строка не заморожена."
msgstr "Red nije zamrznut."

msgid "Заморозка не снята."
msgstr "Zamrzavanje nije ukinuto."

msgid "часов"
msgstr "sati"

msgid "ставка за час"
msgstr "stopa po satu"

msgid "процент оплаты"
msgstr "procenat plaćanja"

msgid "минимум за час"
msgstr "minimum po satu"

msgid "типы часов"
msgstr "tipovi sati"

msgid "пропорция"
msgstr "proporcija"

msgid "за полную норму"
msgstr "za punu normu"

msgid "отработано дней"
msgstr "odrađeni dani"

msgid "рабочих дней в месяце"
msgstr "radnih dana u mesecu"

msgid "отработано часов"
msgstr "odrađeni sati"

msgid "норма часов"
msgstr "norma sati"

msgid "способ"
msgstr "način"

