#: web/onboarding.py:28
msgid "1. Часы"
msgstr "1. Sati"

#: web/onboarding.py:29
msgid "Внесите отработанные часы в табеле или загрузите их таблицей."
msgstr "Unesite odrađene sate u evidenciju sati ili ih učitajte tabelom."

#: web/onboarding.py:33
msgid "2. Расчёт"
msgstr "2. Obračun"

#: web/onboarding.py:34
msgid "Посчитайте период — получится ведомость по видимым вам регистрам."
msgstr ""
"Obračunajte period — dobićete obračunsku listu za knjige koje su vam "
"vidljive."

#: web/onboarding.py:38
msgid "3. Утверждение"
msgstr "3. Odobrenje"

#: web/onboarding.py:39
msgid "Утвердите период: расчёт замораживается, откат — только с причиной."
msgstr ""
"Odobrite period: obračun se zamrzava, vraćanje unazad — samo uz razlog."

#: web/papers.py:149
msgid "Выберите, что за бумага: накладная или чек."
msgstr "Izaberite kakav je papir: otpremnica ili račun."

#: web/papers.py:151
msgid "Файл не приложен: без фотографии разбирать нечего."
msgstr "Fajl nije priložen: bez fotografije nema šta da se razvrstava."

#: web/papers.py:154
#, python-format
msgid ""
"Файл больше %(limit)s МБ. Сфотографируйте бумагу ещё раз или уменьшите "
"снимок."
msgstr ""
"Fajl je veći od %(limit)s MB. Fotografišite papir ponovo ili smanjite snimak."

#: web/papers.py:160 web/receipts.py:77
msgid ""
"Такой файл продукт не примет: нужна фотография (JPEG, PNG, WebP, HEIC) или "
"PDF."
msgstr ""
"Proizvod neće prihvatiti ovakav fajl: potrebna je fotografija (JPEG, PNG, "
"WebP, HEIC) ili PDF."

#: web/papers.py:231
msgid "У бумаги должна быть точка: укажите, с какой она пришла."
msgstr "Papir mora imati objekat: navedite sa kog je stigao."

#: web/papers.py:236 web/suppliers.py:408 web/suppliers_views.py:646
#: web/suppliers_views.py:650
msgid "Контрагент не найден."
msgstr "Partner nije pronađen."

#: web/papers_views.py:54
msgid "Накладная"
msgstr "Otpremnica"

#: web/papers_views.py:55 web/templates/web/cash/expense.html:47
#: web/templates/web/cash/expense_edit.html:54
#: web/templates/web/cash/expenses.html:133
msgid "Чек"
msgstr "Račun"

#: web/papers_views.py:84 web/papers_views.py:173
msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому бумаги вам некуда нести. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati nijednom partneru, pa nema gde da se donese papir. Zamolite "
"administratora mreže da vas doda."

#: web/papers_views.py:204 web/papers_views.py:280
#: web/templates/web/suppliers/inbox.html:146
#: web/templates/web/suppliers/papers.html:37
msgid "Дата на бумаге"
msgstr "Datum na papiru"

#: web/papers_views.py:206 web/papers_views.py:212 web/papers_views.py:295
msgid "Сумма с бумаги"
msgstr "Iznos sa papira"

#: web/papers_views.py:211
#, python-format
msgid ""
"«%(label)s»: ноль не сумма. Оставьте поле пустым, если сумма неизвестна."
msgstr ""
"„%(label)s“: nula nije iznos. Ostavite polje prazno ako iznos nije poznat."

#: web/papers_views.py:220 web/papers_views.py:299
#: web/templates/web/cash/split.html:26
#: web/templates/web/cash/unallocated.html:33
#: web/templates/web/reports/pnl_line.html:20
#: web/templates/web/suppliers/inbox.html:58
#: web/templates/web/suppliers/inbox.html:150
#: web/templates/web/suppliers/invoice.html:77
#: web/templates/web/suppliers/paper.html:78
#: web/templates/web/suppliers/papers.html:41
msgid "Что это"
msgstr "Šta je to"

#: web/papers_views.py:230 web/papers_views.py:274
#: web/templates/web/suppliers/inbox.html:147
#: web/templates/web/suppliers/papers.html:38
msgid "Что за бумага"
msgstr "Kakav papir"

#: web/papers_views.py:247
msgid ""
"Бумагу приносят с точки, а не со всей сети: выберите точку, с которой она "
"пришла."
msgstr ""
"Papir stiže sa objekta, a ne iz cele mreže: izaberite objekat sa kog je "
"stigao."

#: web/papers_views.py:277
msgid ""
"Накладная — бумага поставщика на товар. Чек — то, что заплатили на месте."
msgstr ""
"Otpremnica je dobavljačev papir za robu. Račun je ono što je plaćeno na licu "
"mesta."

#: web/papers_views.py:282
msgid "Дата, которая напечатана на самой бумаге."
msgstr "Datum koji je odštampan na samom papiru."

#: web/papers_views.py:284
msgid "Фотография или PDF"
msgstr "Fotografija ili PDF"

#: web/papers_views.py:286
msgid ""
"Снимок с телефона годится. Главное — чтобы читались поставщик, дата и сумма."
msgstr ""
"Snimak telefonom je dovoljan. Bitno je da se vide dobavljač, datum i iznos."

#: web/papers_views.py:289 web/templates/web/cash/split.html:25
#: web/templates/web/suppliers/inbox.html:149
#: web/templates/web/suppliers/papers.html:40
msgid "Поставщик"
msgstr "Dobavljač"

#: web/papers_views.py:292
msgid "Не знаю или нет в списке"
msgstr "Ne znam ili nema na spisku"

#: web/papers_views.py:293
msgid "Можно не выбирать: поставщика назначит бухгалтер при разборе."
msgstr ""
"Ne morate birati: dobavljača će dodeliti knjigovođa prilikom razvrstavanja."

#: web/papers_views.py:297
msgid ""
"Необязательно. Это сумма со слов, а не расход: в P&L она попадёт только "
"после разбора."
msgstr ""
"Nije obavezno. Ovo je iznos po izjavi, a ne trošak: u P&L ulazi tek posle "
"razvrstavanja."

#: web/papers_views.py:301
msgid ""
"Одной строкой: от кого бумага и за что. Поможет бухгалтеру найти поставщика."
msgstr ""
"U jednoj rečenici: od koga je papir i za šta. Pomoći će knjigovođi da "
"pronađe dobavljača."

#: web/papers_views.py:315
msgid ""
"С какой точки бумага. Не куда ляжет расход — это решает бухгалтер при "
"разборе."
msgstr ""
"Sa kog je objekta papir. Ne gde će trošak pasti — to odlučuje knjigovođa "
"prilikom razvrstavanja."

#: web/papers_views.py:344
msgid "Вас ещё не завели ни к одному партнёру, поэтому бумаг у вас нет."
msgstr "Još niste dodati nijednom partneru, pa nemate papira."

#: web/papers_views.py:381
#, python-format
msgid "%(kind)s с точки %(unit)s"
msgstr "%(kind)s sa objekta %(unit)s"

#: web/papers_views.py:458
msgid ""
"Бумага принята и ждёт разбора бухгалтером. В P&L её ещё нет: сумма появится "
"там, когда бухгалтер назначит статью и период."
msgstr ""
"Papir je primljen i čeka da ga knjigovođa razvrsta. U P&L-u ga još nema: "
"iznos će se tamo pojaviti kada knjigovođa dodeli stavku i period."

#: web/papers_views.py:464
#, python-format
msgid "Бумага разобрана: строка учтена в периоде %(month)s."
msgstr "Papir je razvrstan: red je zaveden u period %(month)s."

#: web/papers_views.py:469
#, python-format
msgid ""
"Месяц %(month)s закрыт, поэтому строка легла в открытый период — с исходной "
"датой и не сдвинув закрытый месяц."
msgstr ""
"Mesec %(month)s je zatvoren, pa je red ušao u otvoreni period — sa izvornim "
"datumom, ne dirajući zatvoreni mesec."

#: web/papers_views.py:481
#, python-format
msgid ""
"Месяц %(month)s закрыт. Разбор его не тронет: строка ляжет в открытый период "
"с исходной датой документа."
msgstr ""
"Mesec %(month)s je zatvoren. Razvrstavanje ga ne dira: red će ući u otvoreni "
"period sa izvornim datumom dokumenta."

#: web/permissions.py:92
msgid "Правка табеля"
msgstr "Izmena evidencije sati"

#: web/permissions.py:93
