#: src/web/person_views.py:58
msgid ""
"«Начислено» — сумма показанных строк. Бруто, налог, взносы и каналы выплаты "
"посчитаны по всем регистрам учёта сразу, поэтому показываются тому, кому "
"видны все регистры, и по месяцам не складываются."
msgstr ""
"„Obračunati iznos“ je zbir prikazanih redova. Bruto, porez, doprinosi i "
"kanali isplate se računaju za sve knjige odjednom, zato se prikazuju samo "
"onome ko vidi sve knjige, i ne sabiraju se po mesecima."

#: src/web/person_views.py:68
