msgstr "Dodaj kasu"

#: web/tills_views.py:71
msgid "Касс нет."
msgstr "Nema kasa."

#: web/tills_views.py:72
msgid ""
"Пока кассы не заведены, расход вносится без неё, а регистр учёта выбирается "
"руками."
msgstr ""
"Dok kase nisu zavedene, trošak se unosi bez nje, a knjiga se bira ručno."

#: web/tills_views.py:137
msgid "Новая касса"
msgstr "Nova kasa"

#: web/tills_views.py:139
msgid "← К кассам"
msgstr "← Na kase"

