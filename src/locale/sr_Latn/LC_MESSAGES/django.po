#: src/web/tills_views.py:119 src/web/tills_views.py:155
msgid "Регистр учёта"
msgstr "Knjiga"

#: src/web/cash_views.py:300
msgid "Когда деньги вышли из кассы."
msgstr "Kada je novac izašao iz kase."

#: src/web/cash_views.py:303
msgid "Сумма из чека — с налогом, если он в ней есть."
msgstr "Iznos sa računa — sa porezom, ako ga račun sadrži."

#: src/web/cash_views.py:308
msgid "Ставка НДС, %"
msgstr "Stopa PDV-a, %"

#: src/web/cash_views.py:310
msgid ""
"В Сербии 20 или 10. Пусто — налог не выделяем: в P&L такая трата пойдёт "
"полной суммой. С заполненной ставкой в P&L по умолчанию поедет сумма без НДС."
msgstr ""
"U Srbiji je 20 ili 10. Prazno — porez se ne izdvaja: trošak u P&L ide u "
"punom iznosu. Sa popunjenom stopom u P&L po podrazumevanoj vrednosti ide "
"iznos bez PDV-a."

#: src/web/cash_views.py:320
msgid ""
"Статьи ведёт администратор сети. Нужной нет — попросите завести: выдумывать "
"название на месте нельзя, иначе одна трата назовётся по-разному."
msgstr ""
"Stavke troškova održava administrator mreže. Ako nedostaje ona koja vam "
"treba, zamolite ga da je doda — nije dozvoljeno smišljati naziv u hodu, jer "
"bi se isti trošak svaki put zvao drugačije."

#: src/web/cash_views.py:331
msgid "Из кассы"
msgstr "Iz kase"

#: src/web/cash_views.py:332
msgid ""
"Пусто — регистр берётся из выбранной кассы; без кассы это официальный. "
"Выбранное здесь значение сильнее кассы."
msgstr ""
"Prazno — knjiga se uzima iz izabrane kase; bez kase je to zvanična. Vrednost "
"izabrana ovde jača je od kase."

#: src/web/cash_views.py:337
msgid "Зачем потратили. Через месяц это единственное, по чему строку узнают."
msgstr ""
"Zašto je potrošeno. Za mesec dana to je jedino po čemu će se red prepoznati."

#: src/web/cash_views.py:365 src/web/templates/web/cash/expenses.html:58
msgid "Касса"
msgstr "Kasa"

#: src/web/cash_views.py:366
msgid "Без кассы"
msgstr "Bez kase"

#: src/web/cash_views.py:367
msgid ""
"Откуда взяли деньги. Регистр учёта расхода приезжает из кассы, а точка — та, "
"на которой она стоит."
msgstr ""
"Odakle je novac uzet. Knjiga troška dolazi iz kase, a objekat je onaj na "
"kome je kasa."

#: src/web/cash_views.py:393
#, python-format
msgid ""
"Месяц %(closed)s закрыт: расход ляжет в %(month)s, а эта дата останется при "
"нём."
msgstr ""
"Mesec %(closed)s je zatvoren: trošak upada u %(month)s, a ovaj datum ostaje "
"uz njega."

#: src/web/cash_views.py:425 src/web/expenses_views.py:252
msgid "Вся сеть"
msgstr "Cela mreža"

#: src/web/cash_views.py:426
msgid ""
"«Вся сеть» — расход юрлица целиком (аренда офиса, реклама): он разойдётся по "
"точкам правилом статьи."
msgstr ""
"„Cela mreža“ — trošak celog pravnog lica (kirija kancelarije, reklama): "
"raspodeliće se po objektima pravilom stavke."

#: src/web/cash_views.py:446
#, python-format
msgid "Расход записан в месяц %(month)s."
msgstr "Trošak je zapisan za %(month)s."

#: src/web/cash_views.py:449
#, python-format
msgid ""
"Месяц %(closed)s закрыт, поэтому расход записан в %(month)s — с исходной "
"датой и не сдвинув закрытый месяц."
msgstr ""
"Mesec %(closed)s je zatvoren, zato je trošak zapisan za %(month)s — sa "
"originalnim datumom i bez pomeranja zatvorenog meseca."

#: src/web/cash_views.py:474
#, python-format
msgid ""
" Точки у расхода нет, поэтому он ждёт разнесения — и виден в списке "
"нераспределённых: %(url)s"
msgstr ""
" Trošak nema objekat, pa čeka raspodelu — i vidljiv je na listi "
"neraspoređenog: %(url)s"

#: src/web/cash_views.py:480
#, python-format
msgid " Расход разнесён по точкам правилом статьи: строк — %(count)s."
msgstr ""
" Trošak je raspodeljen po objektima pravilom stavke: redova — %(count)s."

#: src/web/cash_views.py:484
msgid ""
" Разнести его по точкам может тот, кто ведёт все точки: строки разнесения "
"ложатся и на чужие точки."
msgstr ""
" Da ga raspodeli po objektima može samo onaj ko vodi sve objekte: redovi "
"raspodele padaju i na tuđe objekte."

