msgid "role.director"
msgstr "Operativni direktor"

#: src/web/i18n.py:55
msgid "role.accountant"
msgstr "Knjigovođa"

#: src/web/i18n.py:56
msgid "role.manager"
msgstr "Menadžer objekta"

#: src/web/i18n.py:57
