msgstr "Polje „%(label)s“ je obavezno."

#: src/web/cash_views.py:185 src/web/cash_views.py:189
#: src/web/cash_views.py:314 src/web/dbrefusal.py:113
#: src/web/expenses_views.py:155 src/web/expenses_views.py:313
msgid "Статья расхода"
msgstr "Stavka troška"

#: src/web/cash_views.py:191
msgid "Статья не найдена."
msgstr "Stavka troška nije pronađena."

#: src/web/cash_views.py:195
#, python-format
msgid ""
"Статья «%(title)s» на %(date)s не действует: выберите другую или поправьте "
"её в справочнике."
msgstr ""
"Stavka troška „%(title)s“ nije važeća na %(date)s: izaberite drugu ili je "
"ispravite u imeniku."

#: src/web/cash_views.py:228
msgid ""
"Расход на всю сеть из кассы не оплачивается: у кассы есть точка. Уберите "
"кассу или выберите её точку."
msgstr ""
"Trošak za celu mrežu se ne plaća iz kase: kasa ima objekat. Uklonite kasu "
"ili izaberite njen objekat."

#: src/web/cash_views.py:233
#, python-format
msgid ""
"Касса «%(till)s» стоит на точке %(unit)s — выберите её или уберите кассу."
msgstr ""
"Kasa „%(till)s“ je na objektu %(unit)s — izaberite ga ili uklonite kasu."

#: src/web/cash_views.py:271 src/web/cash_views.py:327 src/web/dbrefusal.py:115
