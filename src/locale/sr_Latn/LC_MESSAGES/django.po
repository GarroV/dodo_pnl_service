#: web/permissions.py:95
msgid "Откат периода"
msgstr "Vraćanje perioda"

#: web/permissions.py:96
msgid "Закрытие часов по точке"
msgstr "Zatvaranje sati objekta"

#: web/permissions.py:97
msgid "Заморозка строки ведомости"
msgstr "Zamrzavanje reda obračunske liste"

#: web/permissions.py:98
msgid "Перенос разницы за закрытый месяц"
msgstr "Prenos razlike za zatvoreni mesec"

#: web/permissions.py:99
msgid "Ведение справочников"
msgstr "Upravljanje imenicima"

#: web/permissions.py:100
msgid "Ведение правил расчёта"
msgstr "Upravljanje pravilima obračuna"

#: web/permissions.py:101
msgid "Ведение ролей"
msgstr "Upravljanje ulogama"

#: web/permissions.py:102
msgid "Разбор первички"
msgstr "Razvrstavanje primarne dokumentacije"

#: web/permissions.py:131
#, python-format
msgid ""
"%(action)s не входит в права вашей роли «%(role)s». Вы ведёте роли — "
"откройте «Роли и права» и выдайте его."
msgstr ""
"%(action)s nije u pravima vaše uloge „%(role)s“. Vi vodite uloge — otvorite "
"„Uloge i prava“ i dodelite ga."

#: web/permissions.py:135
#, python-format
msgid ""
"%(action)s не входит в права вашей роли. Вы ведёте роли — откройте «Роли и "
"права» и выдайте его."
msgstr ""
"%(action)s nije u pravima vaše uloge. Vi vodite uloge — otvorite „Uloge i "
"prava“ i dodelite ga."

#: web/permissions.py:140
#, python-format
msgid ""
"%(action)s не входит в права вашей роли «%(role)s». Попросите того, у кого "
"это право есть."
msgstr ""
"%(action)s nije u ovlašćenjima vaše uloge „%(role)s“. Zamolite nekoga ko ima "
"to ovlašćenje."

#: web/permissions.py:144
#, python-format
msgid ""
"%(action)s не входит в права вашей роли. Попросите того, у кого это право "
"есть."
msgstr ""
"%(action)s nije u ovlašćenjima vaše uloge. Zamolite nekoga ko ima to "
"ovlašćenje."

#: web/person_views.py:58
msgid ""
"«Начислено» — сумма показанных строк. Бруто, налог, взносы и каналы выплаты "
"посчитаны по всем регистрам учёта сразу, поэтому показываются тому, кому "
"видны все регистры, и по месяцам не складываются."
msgstr ""
"„Obračunati iznos“ je zbir prikazanih redova. Bruto, porez, doprinosi i "
"kanali isplate se računaju za sve knjige odjednom, zato se prikazuju samo "
"onome ko vidi sve knjige, i ne sabiraju se po mesecima."

#: web/person_views.py:68
#, python-format
msgid "на карту %(bank)s · в кассу %(cash)s"
msgstr "preko banke %(bank)s · gotovinom %(cash)s"

#: web/person_views.py:163
msgid "Начислено за всё время"
msgstr "Obračunato za sve vreme"

#: web/person_views.py:165
msgid "Сумма показанных строк по всем месяцам"
msgstr "Zbir prikazanih redova za sve mesece"

#: web/person_views.py:168
msgid "Месяцев с выплатами"
msgstr "Meseci sa isplatama"

#: web/person_views.py:170
msgid "Считаются только месяцы, строки которых вам видно"
msgstr "Računaju se samo meseci čiji su redovi vama vidljivi"

#: web/person_views.py:173
msgid "В среднем за месяц"
msgstr "Prosek po mesecu"

#: web/person_views.py:177
msgid "Начислено, поделённое на число этих месяцев"
msgstr "Obračunati iznos podeljen brojem tih meseci"

#: web/person_views.py:180
msgid "Часов отработано"
msgstr "Odrađeni sati"

#: web/person_views.py:182
msgid "По табелю за те же месяцы; часы регистром не делятся"
msgstr "Prema evidenciji sati za iste mesece; sati se ne dele po knjigama"

#: web/positions_views.py:76
msgid ""
"Шаблон условий найма: кого нанимаем, в какую группу он попадает и в каких "
"границах бывает его ставка."
msgstr ""
"Šablon uslova zaposlenja: koga zapošljavamo, u koju grupu ulazi i u kojim "
"granicama je njegova cena rada."

#: web/positions_views.py:79
msgid "Завести должность"
msgstr "Dodaj radno mesto"

#: web/positions_views.py:85
msgid "Должностей нет."
msgstr "Nema radnih mesta."

#: web/positions_views.py:86
msgid ""
"Пока их нет, условия найма набираются каждому человеку руками — это "
"работает, просто дольше."
msgstr ""
"Dok ih nema, uslovi zaposlenja se unose ručno za svakog čoveka — to radi, "
"samo duže traje."

#: web/positions_views.py:129
msgid "Новая должность"
msgstr "Novo radno mesto"

#: web/positions_views.py:131
msgid "← К должностям"
msgstr "← Na radna mesta"

#: web/positions_views.py:137
msgid "Короткий код, например pizzamaker."
msgstr "Kratka šifra, na primer pizzamaker."

#: web/positions_views.py:144
msgid ""
"Умолчание для нанятых на эту должность. В условиях найма человека величину "
"можно поставить свою."
msgstr ""
"Podrazumevana vrednost za zaposlene na ovom radnom mestu. U uslovima "
"zaposlenja čoveka može se postaviti svoja."

#: web/positions_views.py:155
msgid ""
"Куда попадёт нанятый: группа решает, как считается его работа и в какую "
"строку P&L уходят его деньги."
msgstr ""
"Gde ulazi zaposleni: grupa određuje kako se računa njegov rad i u koju "
"stavku P&L-a idu njegove pare."

#: web/preview.py:80
msgid "Часов за этот месяц нет — начислять пока нечего."
msgstr "Za ovaj mesec još nema sati — nema šta da se obračuna."

#: web/printing_views.py:55
msgid "Печатная форма"
msgstr "Forma za štampu"

#: web/printing_views.py:94
msgid "Платёжная ведомость"
msgstr "Platni spisak"

#: web/printing_views.py:99
#, python-format
msgid "Платёжная ведомость за %(month)s"
msgstr "Platni spisak za %(month)s"

#: web/printing_views.py:175
msgid "Расчётный листок"
msgstr "Obračun zarade"

#: web/printing_views.py:180
#, python-format
msgid "Расчётный листок за %(month)s"
msgstr "Obračun zarade za %(month)s"

