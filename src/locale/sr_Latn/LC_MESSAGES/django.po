msgstr "Prazno znači da se registar uzima iz kase, a bez kase ostaje zvanični."

#: src/web/suppliers_views.py:955
msgid "Вас ещё не завели ни к одному партнёру, поэтому вносить оплату некуда."
msgstr "Još niste dodati nijednom partneru, pa nema gde da se unese plaćanje."

#: src/web/suppliers_views.py:1013
msgid "Когда деньги ушли. Счёта нет, поэтому расход признаётся этой датой."
msgstr "Kada je novac otišao. Fakture nema, pa se trošak priznaje tim datumom."

#: src/web/suppliers_views.py:1018
msgid "Кому заплатили. Нет в списке — заведите его в справочнике."
msgstr "Kome je plaćeno. Nema ga na spisku — dodajte ga u šifarnik."

#: src/web/suppliers_views.py:1030
msgid "Можно не выбирать: строка встанет в инбокс и будет видна числом."
msgstr ""
