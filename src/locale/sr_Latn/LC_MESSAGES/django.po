msgstr "obračunski red zamrznut: %(reason)s"

msgid "строка заморожена"
msgstr "obračunski red zamrznut"

#, python-format
msgid "человек: %(count)s"
msgstr "osoba: %(count)s"

msgid "Без статьи"
msgstr "Bez stavke"

#, python-format
msgid "Строки для P&L · %(sub)s"
msgstr "Redovi za P&L · %(sub)s"

msgid "Статья P&L"
msgstr "Stavka P&L-a"

msgid "Тип строки"
msgstr "Tip reda"

msgid "Компонент"
msgstr "Komponenta"

