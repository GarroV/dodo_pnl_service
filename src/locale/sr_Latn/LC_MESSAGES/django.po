#: web/templates/web/rules/rule.html:60
msgid "с будущей даты"
msgstr "od budućeg datuma"

#: web/templates/web/rules/rule.html:70
msgid "в продукте"
msgstr "u proizvodu"

#: web/templates/web/rules/rule.html:70
