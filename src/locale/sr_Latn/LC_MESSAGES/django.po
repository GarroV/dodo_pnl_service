msgid "Официальный"
msgstr "Zvanična"

#: src/web/format.py:46
msgid "Дополнительный"
msgstr "Dopunska"

#: src/web/format.py:47
msgid "Внутренний"
msgstr "Interna"

#: src/web/format.py:106 src/web/navigation.py:69
msgid "Наличные расходы"
msgstr "Gotovinski troškovi"

#: src/web/format.py:107
msgid "Разнесение накладных"
msgstr "Raspoređivanje faktura"

#: src/web/format.py:108
msgid "Разбор выписки"
msgstr "Obrada izvoda"

#: src/web/format.py:112
msgid "Телефон управляющего: короткий список, который читают целиком."
msgstr "Telefon menadžera: kratak spisak koji se pročita do kraja."

#: src/web/format.py:113
msgid "Разбор накладной поставщика бухгалтером."
msgstr "Knjigovođa obrađuje fakturu dobavljača."

#: src/web/format.py:114
msgid "Разбор банковской выписки."
msgstr "Obrada bankovnog izvoda."

#: src/web/format.py:187
#, python-format
msgid "%(percent)s и %(amount)s"
msgstr "%(percent)s i %(amount)s"

