msgid "не входит в доступную вам часть расчёта этого периода"
msgstr "nije u delu obračuna ovog perioda koji vam je dostupan"

msgid "в загруженной таблице такой строки нет"
msgstr "takav obračunski red ne postoji u učitanoj tabeli"

msgid "своего расчёта в этом месяце у строки нет — только перенос за прошлый"
msgstr "ovaj obračunski red nema sopstveni obračun ovog meseca — samo prenos iz prethodnog"

msgid "В правилах страны не заданы пороги отклонений. Отчёт без них показывал бы либо всё подряд, либо ничего — и то и другое выглядело бы как настроенное поведение. Задайте раздел «variance» в пресете страны (и перезагрузите его: python manage.py load_presets)."
msgstr "U pravilima zemlje nisu podešeni pragovi odstupanja. Izveštaj bez njih bi prikazivao ili sve redom, ili ništa — i jedno i drugo bi izgledalo kao podešeno ponašanje. Podesite odeljak „variance“ u presetu zemlje (i ponovo ga učitajte: python manage.py load_presets)."

#, python-format
msgid "Часы точки %(unit)s за %(month)s закрыты. Чтобы их править, точку нужно открыть заново."
msgstr "Sati objekta %(unit)s za %(month)s su zatvoreni. Da biste ih izmenili, objekat treba ponovo otvoriti."

#, python-format
msgid "%(who)s: отрицательные часы (%(kinds)s)"
msgstr "%(who)s: negativni sati (%(kinds)s)"

#, python-format
msgid "%(who)s: в файле нет ни одного часа — строка табеля будет пустой"
msgstr "%(who)s: u fajlu nema nijednog sata — red evidencije sati će biti prazan"

#, python-format
msgid "%(who)s: %(total)s ч при норме %(norm)s ч"
msgstr "%(who)s: %(total)s h pri normi od %(norm)s h"

#, python-format
msgid "%(who)s: уволен %(date)s, а в файле %(total)s ч за этот месяц"
msgstr "%(who)s: otpušten %(date)s, a u fajlu je %(total)s h za ovaj mesec"

msgid "такого сотрудника нет в справочнике партнёра"
msgstr "ovaj zaposleni ne postoji u partnerovom imeniku"

msgid "нет условий найма на этот месяц — неизвестно, на какой точке"
msgstr "nema uslova zapošljavanja za ovaj mesec — nepoznato je na kom objektu"

#, python-format
msgid "часы точки %(unit)s за этот месяц закрыты — строка не загружена"
msgstr "sati objekta %(unit)s za ovaj mesec su zatvoreni — red nije učitan"

#, python-format
msgid "типа часов «%(kind)s» нет в правилах страны — эти часы не загружены"
msgstr "vrsta sati „%(kind)s“ ne postoji u pravilima zemlje — ovi sati nisu učitani"

#, python-format
msgid "«%(value)s» — это не число часов"
msgstr "„%(value)s“ nije broj sati"

msgid "часы задаются с точностью до сотой"
msgstr "sati se unose sa tačnošću do stotog dela"

msgid "отрицательной сдельной величины не бывает"
msgstr "vrednost učinka ne može biti negativna"

#, python-format
msgid "больше %(limit)s за месяц не бывает — проверьте, не лишний ли ноль"
msgstr "ne može biti više od %(limit)s za mesec — proverite da li ima suvišnu nulu"

#, python-format
msgid "типа часов «%(kind)s» нет в правилах страны"
msgstr "vrsta sati „%(kind)s“ ne postoji u pravilima zemlje"

msgid "отрицательных часов не бывает"
msgstr "sati ne mogu biti negativni"

#, python-format
msgid "больше %(limit)s часов в месяце не бывает"
msgstr "ne može biti više od %(limit)s sati u mesecu"

msgid "ручную правку нельзя записать без следа: нужен автор и причина"
msgstr "ručna izmena se ne može sačuvati bez traga: potreban je autor i razlog"

#, python-format
msgid "По часам табеля в базу для взносов входит %(declared)s ч, а записано %(recorded)s ч. Пока числа не сойдутся, период не считается."
msgstr "Prema satima iz evidencije sati, u osnovicu doprinosa treba da uđe %(declared)s h, a upisano je %(recorded)s h. Dok se brojevi ne poklope, period se ne obračunava."

#, python-format
msgid "по часам %(declared)s"
msgstr "po satima: %(declared)s"

#, python-format
msgid "Табель · %(title)s"
msgstr "Evidencija sati · %(title)s"

msgid "← К месяцу"
msgstr "← Na mesec"

msgid "Табель показать нельзя."
msgstr "Evidencija sati se ne može prikazati."

#, python-format
msgid "%(people_count)s чел."
msgstr "%(people_count)s osoba"

msgid "только ваши точки"
msgstr "samo vaši objekti"

msgid "часы за месяц; сохраняются сразу, кнопки «сохранить» нет"
msgstr "sati za mesec; čuvaju se odmah, nema dugmeta „sačuvaj“"

msgid "часы за месяц, только на просмотр"
msgstr "sati za mesec, samo za pregled"

#, python-format
msgid "%(unit_count)s чел."
msgstr "%(unit_count)s osoba"

#, python-format
msgid "часы закрыты %(closed_at)s"
msgstr "sati zatvoreni %(closed_at)s"

msgid "Открыть заново"
msgstr "Ponovo otvori"

msgid "часы открыты"
msgstr "sati otvoreni"

msgid "Закрыть часы точки"
msgstr "Zatvori sate objekta"

msgid "Загрузить таблицу партнёра (.xlsx)"
msgstr "Učitaj partnerovu tabelu (.xlsx)"

msgid "Загрузить"
msgstr "Učitaj"

msgid "Повторная загрузка того же файла ничего не изменит."
msgstr "Ponovno učitavanje istog fajla neće ništa promeniti."

msgid "Часов за этот месяц ещё нет"
msgstr "Za ovaj mesec još nema sati"

msgid ""
"По вашим точкам за этот месяц не заведено ни одного сотрудника. Если люди\n"
"      работали, скажите тому, кто ведёт справочник сотрудников: строки табеля\n"
"      появляются вместе с ними."
msgstr ""
"Za vaše objekte ovog meseca nije upisan nijedan zaposleni. Ako su ljudi\n"
"      radili, recite onome ko vodi imenik zaposlenih: redovi evidencije sati\n"
"      se pojavljuju zajedno sa njima."

msgid ""
"Строки табеля появляются вместе с сотрудниками месяца. Заведите их в\n"
"      справочнике или загрузите таблицу партнёра формой выше — она заводит\n"
"      строки табеля сама."
msgstr ""
"Redovi evidencije sati se pojavljuju zajedno sa zaposlenima za mesec. Upišite ih u\n"
"      imenik ili učitajte partnerovu tabelu pomoću forme iznad — ona sama\n"
"      kreira redove evidencije sati."

msgid ""
"За этот месяц не заведено ни одного сотрудника, поэтому и часов пока нет.\n"
"      Вносит их тот, у кого есть право на правку табеля."
msgstr ""
"Za ovaj mesec nije upisan nijedan zaposleni, pa zato još nema ni sati.\n"
"      Unosi ih onaj ko ima pravo izmene evidencije sati."

msgid "Не принято, в ячейке прежнее значение."
msgstr "Nije prihvaćeno, u ćeliji je prethodna vrednost."

msgid "В ячейке — то, что сейчас в базе."
msgstr "U ćeliji je ono što je trenutno u bazi."

#, python-format
msgid "Не удалось сохранить «%%(value)s»: %%(reason)s. В ячейке прежнее значение."
msgstr "Nije uspelo čuvanje „%%(value)s“: %%(reason)s. U ćeliji je prethodna vrednost."

msgid "нет связи с сервером"
msgstr "nema veze sa serverom"

msgid "Правило не подтверждено бухгалтером"
msgstr "Pravilo nije potvrđeno od strane knjigovođe"

msgid "Чем меряется работа группы, задано правилом; у почасовых групп величины нет"
msgstr "Čime se meri rad grupe, određuje pravilo; satne grupe nemaju vrednost"

msgid "Сдельно"
msgstr "Po učinku"

msgid "Вход расчёта наравне с часами: по ней считаются взносы и бруто"
msgstr "Ulaz u obračun ravnopravno sa satima: iz nje se obračunavaju doprinosi i bruto"

msgid "База взносов"
msgstr "Osnovica doprinosa"

msgid "Норма"
msgstr "Norma"

msgid "Эти часы не оплачиваются: работа группы меряется сдельно"
msgstr "Ovi sati se ne plaćaju: rad grupe se meri po učinku"

msgid "Работа этой группы меряется часами"
msgstr "Rad ove grupe se meri satima"

msgid ""
"Стрелки — переход между ячейками, Enter — вниз, Tab — вправо. Каждая ячейка\n"
"  уходит на сервер сразу, как только вы её покинули."
msgstr ""
"Strelice — prelazak između ćelija, Enter — dole, Tab — desno. Svaka ćelija\n"
"  se šalje na server čim je napustite."

#, python-format
msgid "Загрузка таблицы · %(title)s"
msgstr "Učitavanje tabele · %(title)s"

msgid "Таблица не загружена."
msgstr "Tabela nije učitana."

msgid "Что сделано"
msgstr "Šta je urađeno"

msgid "Строк"
msgstr "Redova"

msgid "Сопоставлено сотрудникам"
msgstr "Upareno sa zaposlenima"

msgid "Заведено строк табеля"
msgstr "Uneto redova evidencije sati"

msgid "Изменено"
msgstr "Izmenjeno"

msgid "Без изменений"
msgstr "Bez izmena"

msgid "Не сопоставлено"
msgstr "Nije upareno"

msgid "Файл разобран целиком, подозрительного не нашлось."
msgstr "Fajl je u potpunosti obrađen, ništa sumnjivo nije pronađeno."

msgid "Не загружено: некому записать"
msgstr "Nije učitano: nema kome da se upiše"

msgid "Эти строки в файле есть, а в табеле их нет."
msgstr "Ovi redovi postoje u fajlu, ali ih nema u evidenciji sati."

msgid "Лист"
msgstr "List"

msgid "Кто"
msgstr "Ko"

msgid "Почему"
msgstr "Zašto"

msgid "Не разобрано в файле"
msgstr "Nije obrađeno u fajlu"

msgid "Это не предупреждения: перечисленного в табеле <strong>нет</strong>."
msgstr "Ovo nisu upozorenja: navedenog u evidenciji sati <strong>nema</strong>."

msgid "Где"
msgstr "Gde"

msgid "Что"
msgstr "Šta"

msgid "Загружено, но стоит посмотреть"
msgstr "Učitano, ali vredi proveriti"

msgid ""
