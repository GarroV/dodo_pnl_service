msgstr "%(what)s: %(expected)s u tabeli, %(actual)s u obračunu"

#: src/web/reports_views.py:364
msgid ""
"Решение записывается вместе с объяснением: без него «ошибка в файле» через "
"полгода не отличить от «не разбирались»."
msgstr ""
"Odluka se beleži zajedno sa objašnjenjem: bez njega «greška u fajlu» se za "
"pola godine ne razlikuje od «niko nije pogledao»."

#: src/web/roles_views.py:162 src/web/roles_views.py:198
msgid "Такой роли у этого партнёра нет."
msgstr "Ovaj partner nema takvu ulogu."

#: src/web/roles_views.py:173
msgid "Права роли не изменены: база не приняла запись."
msgstr "Prava nisu izmenjena: baza nije prihvatila upis."

#: src/web/roles_views.py:177
#, python-format
