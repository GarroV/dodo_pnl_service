#, python-format
msgid "%(sheet)s, строка %(row)s"
msgstr "%(sheet)s, red %(row)s"

#, python-format
msgid ""
"колонка «%(column)s» (%(key)s) не найдена — значения этого поля в загрузку "
"не попали"
msgstr ""
"kolona „%(column)s“ (%(key)s) nije pronađena — vrednosti tog polja nisu ušle "
"u učitavanje"

#, python-format
msgid "строка не пронумерована и не загружена: «%(name)s»"
msgstr "red nije numerisan i nije učitan: „%(name)s“"

msgid "у строки нет имени или фамилии — она не загружена"
msgstr "red nema ime ili prezime — nije učitan"

#, python-format
msgid "«%(value)s» в колонке «%(column)s» — не число, строка не загружена"
msgstr "„%(value)s“ u koloni „%(column)s“ nije broj, red nije učitan"

msgid "лист не входит в формат PLATA — ни одна его строка не загружена"
msgstr "list ne odgovara formatu PLATA — nijedan njegov red nije učitan"

msgid "лист формата не найден в файле — сотрудников с него в загрузке нет"
msgstr ""
"list formata nije pronađen u fajlu — sa njega nema zaposlenih u učitavanju"

msgid ""
"нет условий найма на этот месяц. Расчёт без них выглядел бы верным, поэтому "
"не выполняется."
msgstr ""
"Nema uslova zapošljavanja za ovaj mesec. Obračun bez njih bi izgledao "
"ispravno, zato se ne izvršava."

msgid ""
"за этот период нет ни одного табеля — считать нечего. Внесите часы и "
"повторите."
msgstr ""
"Za ovaj period ne postoji nijedna evidencija sati — nema šta da se obračuna. "
"Unesite sate i pokušajte ponovo."

#, python-format
msgid ""
"в правилах страны нет схем расчёта: %(schemes)s. Поправьте группу "
"сотрудников или пресет."
msgstr ""
"U pravilima zemlje nema šema obračuna: %(schemes)s. Ispravite grupu "
"zaposlenih ili preset."

#, python-format
msgid ""
"в правилах страны нет способов измерения работы: %(measures)s. Поправьте "
"настройку группы или пресет."
msgstr ""
"U pravilima zemlje nema načina merenja rada: %(measures)s. Ispravite "
"podešavanje grupe ili preset."

msgid ""
"база для взносов не сходится с часами табеля. По ней считаются взносы и "
"бруто, поэтому расчёт по устаревшей базе выглядел бы верным. Проверьте "
"колонку «База взносов» в табеле."
msgstr ""
"Osnovica doprinosa se ne poklapa sa satima iz evidencije sati. Iz nje se "
"računaju doprinosi i bruto, zato bi obračun po zastareloj osnovici izgledao "
"ispravno. Proverite kolonu „Osnovica doprinosa“ u evidenciji sati."

msgid ""
"Ведомость этого периода попадает в регистры учёта, недоступные вашей роли. "
"Запустить расчёт может тот, кто видит их все."
msgstr ""
"Obračunska lista ovog perioda spada u knjige koje nisu dostupne vašoj ulozi. "
"Obračun može pokrenuti samo onaj ko vidi sve knjige."

msgid "Считаем сотрудников"
msgstr "Obračunavamo zaposlene"

msgid "партнёр недоступен"
msgstr "partner nedostupan"

msgid "Собираем табели и условия найма"
msgstr "Prikupljamo evidencije sati i uslove zapošljavanja"

msgid "Записываем ведомость"
msgstr "Upisujemo obračunsku listu"

msgid ""
"Заморозка строки требует причины: напишите, из-за чего идёт спор. Причина "
"попадёт в историю рядом с вашим именем."
msgstr ""
"Zamrzavanje reda zahteva razlog: napišite oko čega je spor. Razlog će ući u "
"istoriju pored vašeg imena."

msgid ""
"Строка сотрудника заморожена: её числа не меняются и пересчёт её обходит. "
"Чтобы вернуть человека в общий расчёт, заморозку нужно снять."
msgstr ""
"Obračunski red zaposlenog je zamrznut: njegovi brojevi se ne menjaju, a "
"ponovni obračun ga zaobilazi. Da bi se osoba vratila u zajednički obračun, "
"zamrzavanje treba ukinuti."

msgid ""
"Период утверждён: замораживать в нём нечего — заморожен весь расчёт. Чтобы "
"менять расчёт, период нужно сначала открыть заново."
msgstr ""
"Period je odobren: u njemu nema šta da se zamrzne — ceo obračun je već "
"zamrznut. Da bi se obračun promenio, period prvo treba ponovo otvoriti."

msgid ""
"Расчёт этого периода уже идёт. Дождитесь, пока он закончится: второй запуск "
"не ускорит его, а ведомость всё равно будет одна."
msgstr ""
"Obračun ovog perioda je već u toku. Sačekajte da se završi: drugo pokretanje "
"ga neće ubrzati, a obračunska lista će i dalje biti jedna."

msgid ""
"Задача принята, но её до сих пор не взяли в работу — похоже, рабочий процесс "
"очереди не запущен. Расчёт можно выполнить прямо сейчас, не дожидаясь "
"очереди."
msgstr ""
"Zadatak je prihvaćen, ali još nije preuzet u rad — izgleda da radni proces "
"reda čekanja nije pokrenut. Obračun se može izvršiti odmah, bez čekanja na "
"red."

msgid ""
"Расчёт оборвался из-за внутренней ошибки. Данные периода не изменились; "
"покажите этот период тому, кто ведёт сервис."
msgstr ""
"Obračun je prekinut zbog interne greške. Podaci perioda se nisu promenili; "
"pokažite ovaj period onome ko održava servis."

msgid "Готово"
msgstr "Gotovo"

msgid "В очереди"
msgstr "U redu čekanja"

msgid "Считаем"
msgstr "Obračunavamo"

msgid "Черновик"
msgstr "Nacrt"

msgid "Посчитан"
msgstr "Obračunat"

msgid "Утверждён"
msgstr "Odobren"

msgid "Открыт заново"
msgstr "Ponovo otvoren"

msgid "Выплачен"
msgstr "Isplaćeno"

msgid ""
"Период утверждён: расчёт и его данные заморожены. Чтобы пересчитать, период "
"нужно сначала открыть заново."
msgstr ""
"Period je odobren: obračun i njegovi podaci su zamrznuti. Da biste ga ponovo "
"obračunali, prvo ponovo otvorite period."

msgid ""
"Откат периода требует причины: напишите, зачем открываете период. Причина "
"попадёт в историю рядом с вашим именем."
msgstr ""
"Ponovno otvaranje perioda zahteva razlog: napišite zašto otvarate period. "
"Razlog će ući u istoriju pored vašeg imena."

msgid "Расчёта за этот период ещё не было: сначала посчитайте период."
msgstr "Za ovaj period još nije bilo obračuna: prvo obračunajte period."

#, python-format
msgid ""
"Период сейчас в состоянии «%(from_title)s», перевести его в «%(to_title)s» "
"нельзя. Открытый заново период нужно пересчитать, прежде чем утверждать "
"снова."
msgstr ""
"Period je trenutno u stanju „%(from_title)s“, ne može se preneti u stanje "
"„%(to_title)s“. Ponovo otvoren period treba ponovo obračunati pre nego što "
"se opet odobri."

msgid ""
"Состояние периода изменилось, пока страница была открыта. Обновите страницу "
"и посмотрите, что с ним стало."
msgstr ""
"Stanje perioda se promenilo dok je stranica bila otvorena. Osvežite stranicu "
"i pogledajte šta se desilo sa njim."

msgid ""
"У этого партнёра правки задним числом ведутся пересчётом, а не переносом: "
"закрытый период открывается заново с указанием причины и считается снова. "
"Перенос разницы для него выключен настройкой."
msgstr ""
"Kod ovog partnera se izmene unazad rade ponovnim obračunom, a ne prenosom: "
"zatvoreni period se ponovo otvara uz navođenje razloga i ponovo se "
"obračunava. Prenos razlike je za njega isključen podešavanjem."

msgid ""
"Расхождений с сегодняшними данными в доступном вам срезе нет: переносить "
"нечего. Возможно, разницу уже перенесли — посмотрите период-получатель."
msgstr ""
"U delu koji vam je dostupan nema odstupanja od današnjih podataka: nema šta "
"da se prenese. Razlika je možda već preneta — pogledajte period-primalac."

msgid ""
"Перенос разницы делается только из закрытого месяца. Этот период ещё не "
"утверждён — правьте данные и пересчитывайте его как обычно."
msgstr ""
"Prenos razlike se radi samo iz zatvorenog meseca. Ovaj period još nije "
"odobren — ispravite podatke i ponovo ga obračunajte kao i obično."

msgid ""
"Разница за этот месяц уже перенесена в утверждённый период и выплачена. "
"Открыть его заново нельзя: пересчёт означал бы заплатить дважды."
msgstr ""
"Razlika za ovaj mesec je već preneta u odobreni period i isplaćena. Ne može "
"se ponovo otvoriti: ponovni obračun bi značio da se plati dvaput."

#, python-format
msgid "Ведомость к выплате · %(sub)s"
msgstr "Obračunska lista za isplatu · %(sub)s"

msgid "№"
msgstr "Br."

msgid "Сотрудник"
msgstr "Zaposleni"

msgid "Точка"
msgstr "Objekat"

msgid "Регистр"
msgstr "Knjiga"

msgid "Итого"
msgstr "Ukupno"

msgid "Примечание"
msgstr "Napomena"

#, python-format
msgid "разница за %(date)s"
msgstr "razlika za %(date)s"

#, python-format
msgid "строка заморожена: %(reason)s"
msgstr "obračunski red zamrznut: %(reason)s"

msgid "строка заморожена"
msgstr "obračunski red zamrznut"

#, python-format
msgid "человек: %(count)s"
msgstr "osoba: %(count)s"

msgid ""
"Налоговая часть в этот файл не вошла: налог и взносы считаются по строке "
"ведомости целиком, и разрезу по регистру они не принадлежат. Для P&L с "
"налогами возьмите файл без разреза."
msgstr ""
"Poreski deo nije ušao u ovaj fajl: porez i doprinosi se obračunavaju za red "
"obračunske liste u celini, i ne pripadaju prikazu po knjizi. Za P&L sa "
"porezima uzmite fajl bez prikaza."

msgid ""
"Налоговая часть в этот файл не вошла: налог и взносы считаются по строке "
"ведомости целиком, а итоги расчёта вашей роли не отданы. Собранный по этому "
"файлу P&L окажется без налогов на зарплату — возьмите файл у того, кому "
"отдан весь расчёт."
msgstr ""
"Poreski deo nije ušao u ovaj fajl: porez i doprinosi se obračunavaju za red "
"obračunske liste u celini, a rezultati obračuna nisu ustupljeni vašoj ulozi "
"u celini. P&L sastavljen na osnovu ovog fajla biće bez poreza na zarade — "
"uzmite fajl od onoga kome je ceo obračun ustupljen."

msgid ""
"Налоговая часть в этот файл не вошла: налог и взносы в расчёте этого месяца "
"не посчитаны."
msgstr ""
"Poreski deo nije ušao u ovaj fajl: porez i doprinosi u obračunu ovog meseca "
"uopšte nisu obračunati."

msgid "Без статьи"
msgstr "Bez stavke"

msgid "Суммы расходов — с НДС, как в документе."
msgstr "Iznosi troškova — sa PDV-om, kao u dokumentu."

msgid "Суммы расходов — без НДС."
msgstr "Iznosi troškova — bez PDV-a."

#, python-format
msgid "Строки для P&L · %(sub)s"
msgstr "Redovi za P&L · %(sub)s"

msgid "Статья P&L"
msgstr "Stavka P&L-a"

msgid "Тип строки"
msgstr "Tip reda"

msgid "Компонент"
msgstr "Komponenta"

msgid "Сумма"
msgstr "Iznos"

msgid "Начисление"
msgstr "Obračunato"

msgid "Расход"
msgstr "Trošak"

msgid "Налог"
msgstr "Porez"

msgid "Налог на доход"
msgstr "Porez na dohodak"

msgid "Взносы"
msgstr "Doprinosi"

msgid ""
"лист не похож на выгрузку «Вид бухгалтера» — ни одна его строка не загружена"
msgstr ""
"list ne liči na izvoz „Prikaz za knjigovođu“ — nijedan njegov red nije učitan"

msgid "у строки нет имени — она не загружена"
msgstr "red nema ime — nije učitan"

msgid "не входит в доступную вам часть расчёта этого периода"
msgstr "nije u delu obračuna ovog perioda koji vam je dostupan"

msgid "в загруженной таблице такой строки нет"
msgstr "takav obračunski red ne postoji u učitanoj tabeli"

#, python-format
msgid ""
"в расчёте под этим именем несколько человек (%(count)s) — по имени их не "
"различить, и по ним сверка ничего не говорит"
msgstr ""
"u obračunu pod ovim imenom ima više osoba (%(count)s) — po imenu se ne "
"razlikuju, pa o njima usaglašavanje ne govori ništa"

msgid "своего расчёта в этом месяце у строки нет — только перенос за прошлый"
msgstr ""
"ovaj obračunski red nema sopstveni obračun ovog meseca — samo prenos iz "
"prethodnog"

msgid ""
"В правилах страны не заданы пороги отклонений. Отчёт без них показывал бы "
"либо всё подряд, либо ничего — и то и другое выглядело бы как настроенное "
"поведение. Задайте раздел «variance» в пресете страны (и перезагрузите его: "
"python manage.py load_presets)."
msgstr ""
"U pravilima zemlje nisu podešeni pragovi odstupanja. Izveštaj bez njih bi "
"prikazivao ili sve redom, ili ništa — i jedno i drugo bi izgledalo kao "
"podešeno ponašanje. Podesite odeljak „variance“ u presetu zemlje (i ponovo "
"ga učitajte: python manage.py load_presets)."

#, python-format
msgid ""
"Часы точки %(unit)s за %(month)s закрыты. Чтобы их править, точку нужно "
"открыть заново."
msgstr ""
"Sati objekta %(unit)s za %(month)s su zatvoreni. Da biste ih izmenili, "
"objekat treba ponovo otvoriti."

msgid "такого сотрудника нет в справочнике партнёра"
msgstr "ovaj zaposleni ne postoji u partnerovom imeniku"

msgid "нет условий найма на этот месяц — неизвестно, на какой точке"
msgstr "nema uslova zapošljavanja za ovaj mesec — nepoznato je na kom objektu"

#, python-format
msgid "часы точки %(unit)s за этот месяц закрыты — строка не загружена"
msgstr "sati objekta %(unit)s za ovaj mesec su zatvoreni — red nije učitan"

#, python-format
msgid "типа часов «%(kind)s» нет в правилах страны — эти часы не загружены"
msgstr ""
"vrsta sati „%(kind)s“ ne postoji u pravilima zemlje — ovi sati nisu učitani"

#, python-format
msgid "«%(value)s» — это не число часов"
msgstr "„%(value)s“ nije broj sati"

msgid "часы задаются с точностью до сотой"
msgstr "sati se unose sa tačnošću do stotog dela"

msgid "отрицательной сдельной величины не бывает"
msgstr "vrednost učinka ne može biti negativna"

#, python-format
msgid "больше %(limit)s за месяц не бывает — проверьте, не лишний ли ноль"
msgstr ""
"ne može biti više od %(limit)s za mesec — proverite da li ima suvišnu nulu"

msgid "отрицательной базы для взносов не бывает"
msgstr "osnovica doprinosa ne može biti negativna"

#, python-format
msgid "больше %(limit)s часов в месяце не бывает"
msgstr "ne može biti više od %(limit)s sati u mesecu"

#, python-format
msgid "типа часов «%(kind)s» нет в правилах страны"
msgstr "vrsta sati „%(kind)s“ ne postoji u pravilima zemlje"

msgid "отрицательных часов не бывает"
msgstr "sati ne mogu biti negativni"

msgid "ручную правку нельзя записать без следа: нужен автор и причина"
msgstr "ručna izmena se ne može sačuvati bez traga: potreban je autor i razlog"

#, python-format
msgid "%(who)s: отрицательные часы (%(kinds)s)"
msgstr "%(who)s: negativni sati (%(kinds)s)"

#, python-format
msgid "%(who)s: ни одного часа за этот месяц — строка табеля пустая"
msgstr "%(who)s: nijedan sat ovog meseca — red evidencije je prazan"

#, python-format
msgid "%(who)s: %(total)s ч при норме %(norm)s ч"
msgstr "%(who)s: %(total)s h pri normi od %(norm)s h"

#, python-format
msgid "%(who)s: уволен %(date)s, а часов за этот месяц %(total)s"
msgstr "%(who)s: otpušten %(date)s, a ima %(total)s sati ovog meseca"

msgid "Стоит посмотреть до расчёта"
msgstr "Vredi pogledati pre obračuna"

msgid ""
"Ни одно из этих чисел не ошибка само по себе — но незамеченными они и "
"становятся неверной зарплатой. Сохранению они не мешают."
msgstr ""
"Nijedan od ovih brojeva sam po sebi nije greška — ali neprimećeni upravo "
"tako postaju pogrešna zarada. Ne sprečavaju čuvanje reda."

msgid "Вход расчёта наравне с часами: по ней считаются взносы и бруто"
msgstr ""
"Ulaz u obračun ravnopravno sa satima: iz nje se obračunavaju doprinosi i "
"bruto"

#, python-format
msgid ""
"По часам табеля в базу для взносов входит %(declared)s ч, а записано "
"%(recorded)s ч. Пока числа не сойдутся, период не считается."
msgstr ""
"Prema satima iz evidencije sati, u osnovicu doprinosa treba da uđe "
"%(declared)s h, a upisano je %(recorded)s h. Dok se brojevi ne poklope, "
"period se ne obračunava."

msgid "База взносов"
msgstr "Osnovica doprinosa"

#, python-format
msgid "по часам %(declared)s"
msgstr "po satima: %(declared)s"

msgid "проверьте"
msgstr "proverite"

#, python-format
msgid "Табель · %(title)s"
msgstr "Evidencija sati · %(title)s"

msgid "← К месяцу"
msgstr "← Na mesec"

msgid "Табель показать нельзя."
msgstr "Evidencija sati se ne može prikazati."

#, python-format
msgid "%(people_count)s чел."
msgstr "%(people_count)s osoba"

msgid "только ваши точки"
msgstr "samo vaši objekti"

msgid "часы за месяц; сохраняются сразу, кнопки «сохранить» нет"
msgstr "sati za mesec; čuvaju se odmah, nema dugmeta „sačuvaj“"

msgid "часы за месяц, только на просмотр"
msgstr "sati za mesec, samo za pregled"

#, python-format
msgid "%(unit_count)s чел."
msgstr "%(unit_count)s osoba"

#, python-format
msgid "часы закрыты %(closed_at)s"
msgstr "sati zatvoreni %(closed_at)s"

msgid "Открыть заново"
msgstr "Ponovo otvori"

msgid "часы открыты"
msgstr "sati otvoreni"

msgid "Закрыть часы точки"
msgstr "Zatvori sate objekta"

msgid "Загрузить таблицу партнёра (.xlsx)"
msgstr "Učitaj partnerovu tabelu (.xlsx)"

msgid "Загрузить"
msgstr "Učitaj"

msgid "Повторная загрузка того же файла ничего не изменит."
msgstr "Ponovno učitavanje istog fajla neće ništa promeniti."

msgid "Часов за этот месяц ещё нет"
msgstr "Za ovaj mesec još nema sati"

msgid ""
"По вашим точкам за этот месяц не заведено ни одного сотрудника. Если люди\n"
"      работали, скажите тому, кто ведёт справочник сотрудников: строки "
"табеля\n"
"      появляются вместе с ними."
msgstr ""
"Za vaše objekte ovog meseca nije upisan nijedan zaposleni. Ako su ljudi\n"
"      radili, recite onome ko vodi imenik zaposlenih: redovi evidencije "
"sati\n"
"      se pojavljuju zajedno sa njima."

msgid ""
"Строки табеля появляются вместе с сотрудниками месяца. Заведите их в\n"
"      справочнике или загрузите таблицу партнёра формой выше — она заводит\n"
"      строки табеля сама."
msgstr ""
"Redovi evidencije sati se pojavljuju zajedno sa zaposlenima za mesec. "
"Upišite ih u\n"
"      imenik ili učitajte partnerovu tabelu pomoću forme iznad — ona sama\n"
"      kreira redove evidencije sati."

msgid ""
"За этот месяц не заведено ни одного сотрудника, поэтому и часов пока нет.\n"
"      Вносит их тот, у кого есть право на правку табеля."
msgstr ""
"Za ovaj mesec nije upisan nijedan zaposleni, pa zato još nema ni sati.\n"
"      Unosi ih onaj ko ima pravo izmene evidencije sati."

msgid "Не принято, в ячейке прежнее значение."
msgstr "Nije prihvaćeno, u ćeliji je prethodna vrednost."

msgid "В ячейке — то, что сейчас в базе."
msgstr "U ćeliji je ono što je trenutno u bazi."

#, python-format
msgid ""
"Не удалось сохранить «%%(value)s»: %%(reason)s. В ячейке прежнее значение."
msgstr ""
"Nije uspelo čuvanje „%%(value)s“: %%(reason)s. U ćeliji je prethodna "
"vrednost."

msgid "нет связи с сервером"
msgstr "nema veze sa serverom"

msgid "Правило не подтверждено бухгалтером"
msgstr "Pravilo nije potvrđeno od strane knjigovođe"

msgid ""
"Чем меряется работа группы, задано правилом; у почасовых групп величины нет"
msgstr "Čime se meri rad grupe, određuje pravilo; satne grupe nemaju vrednost"

msgid "Сдельно"
msgstr "Po učinku"

msgid "Норма"
msgstr "Norma"

msgid "Эти часы не оплачиваются: работа группы меряется сдельно"
msgstr "Ovi sati se ne plaćaju: rad grupe se meri po učinku"

msgid "Работа этой группы меряется часами"
msgstr "Rad ove grupe se meri satima"

msgid ""
"Стрелки — переход между ячейками, Enter — вниз, Tab — вправо. Каждая ячейка\n"
"  уходит на сервер сразу, как только вы её покинули."
msgstr ""
"Strelice — prelazak između ćelija, Enter — dole, Tab — desno. Svaka ćelija\n"
"  se šalje na server čim je napustite."

msgid ""
"Наведите на ячейку — увидите, кто поставил это число и когда. «Не записано»\n"
"  значит, что часы попали в табель не с этого экрана и не загрузкой файла. "
"База для\n"
"  взносов, которую никто не задавал руками, так и говорит — «посчитано по "
"часам\n"
"  табеля»: её никто не ставил, её посчитали."
msgstr ""
"Pređite mišem preko ćelije — videćete ko je uneo broj i kada. „Nije "
"zabeleženo“\n"
"  znači da su sati stigli u evidenciju mimo ovog ekrana i mimo učitavanja "
"fajla. Osnovica za\n"
"  doprinose koju niko nije uneo ručno tako i kaže — „izračunato po satima iz "
"evidencije“: nju niko nije uneo, ona je izračunata."

#, python-format
msgid "Загрузка таблицы · %(title)s"
msgstr "Učitavanje tabele · %(title)s"

msgid "Таблица не загружена."
msgstr "Tabela nije učitana."

msgid "Что сделано"
msgstr "Šta je urađeno"

msgid "Строк"
msgstr "Redova"

msgid "Сопоставлено сотрудникам"
msgstr "Upareno sa zaposlenima"

msgid "Заведено строк табеля"
msgstr "Uneto redova evidencije sati"

msgid "Изменено"
msgstr "Izmenjeno"

msgid "Без изменений"
msgstr "Bez izmena"

msgid "Сопоставлено, но не загружено"
msgstr "Upareno, ali nije učitano"

msgid "Не сопоставлено"
msgstr "Nije upareno"

msgid "Файл разобран целиком, подозрительного не нашлось."
msgstr "Fajl je u potpunosti obrađen, ništa sumnjivo nije pronađeno."

msgid "Не загружено: человек найден, а строка не записана"
msgstr "Nije učitano: osoba je pronađena, ali red nije upisan"

msgid ""
"Этих людей продукт узнал, но записывать было некуда — причина у каждой "
"строки своя."
msgstr ""
"Ove osobe su prepoznate, ali red nije imao gde da se upiše — razlog stoji uz "
"svaki red."

msgid "Лист"
msgstr "List"

msgid "Кто"
msgstr "Ko"

msgid "Почему"
msgstr "Zašto"

msgid "Не загружено: некому записать"
msgstr "Nije učitano: nema kome da se upiše"

msgid "Этих людей в справочнике партнёра нет — неизвестно, о ком строка."
msgstr ""
"Ovih osoba nema u šifarniku partnera — ne zna se na koga se red odnosi."

msgid "Не разобрано в файле"
msgstr "Nije obrađeno u fajlu"

msgid "Это не предупреждения: перечисленного в табеле <strong>нет</strong>."
msgstr ""
"Ovo nisu upozorenja: navedenog u evidenciji sati <strong>nema</strong>."

msgid "Где"
msgstr "Gde"

msgid "Что"
msgstr "Šta"

msgid "Загружено, но стоит посмотреть"
msgstr "Učitano, ali vredi proveriti"

msgid ""
"Эти числа приняты. Ни одно из них не ошибка само по себе — но незамеченными\n"
"  они и становятся неверной зарплатой."
msgstr ""
"Ovi brojevi su prihvaćeni. Nijedan od njih sam po sebi nije greška — ali ako "
"prođu\n"
"  neprimećeno, postaju pogrešna plata."

msgid "К табелю"
msgstr "Ka evidenciji sati"

msgid "К периоду"
msgstr "Ka periodu"

msgid "кто поставил, не записано"
msgstr "ko je ovo uneo nije zabeleženo"

#, python-format
msgid "поставил %(who)s, %(when)s"
msgstr "uneo %(who)s, %(when)s"

msgid "посчитано по часам табеля"
msgstr "izračunato po satima iz evidencije"

msgid "точка не найдена"
msgstr "objekat nije pronađen"

msgid "Файл не выбран."
msgstr "Fajl nije izabran."

#, python-format
msgid "Файл больше %(limit)s МБ — это не зарплатная таблица."
msgstr "Fajl je veći od %(limit)s MB — ovo nije platna tabela."

#, python-format
msgid "Файл не удалось прочитать как книгу Excel: %(reason)s"
msgstr "Fajl nije moguće pročitati kao Excel radnu svesku: %(reason)s"

msgid "Поровну между точками"
msgstr "Podjednako između objekata"

msgid "Пропорционально выручке"
msgstr "Proporcionalno prihodu"

msgid "На одну точку"
msgstr "Na jedan objekat"

msgid "Спрашивать каждый раз"
msgstr "Pitaj svaki put"

msgid ""
"«Пропорционально выручке» пока не разносит ничего: выручки в продукте нет — "
"она появится с коннектором Dodo IS."
msgstr ""
"„Proporcionalno prihodu“ trenutno ne raspodeljuje ništa: prihoda u proizvodu "
"nema — pojaviće se sa konektorom Dodo IS."

msgid ""
"«Спрашивать каждый раз» означает, что точку у такого расхода выбирают "
"руками, в самом расходе: отдельного экрана вопроса нет."
msgstr ""
"„Pitaj svaki put“ znači da se objekat za takav trošak bira ručno, u samom "
"trošku: posebnog ekrana za pitanje nema."

msgid ""
"Правила разнесения у статьи нет: заведите его в карточке статьи или укажите "
"точку в самом расходе."
msgstr ""
"Stavka nema pravilo raspodele: podesite ga na kartici stavke ili navedite "
"objekat u samom trošku."

msgid ""
"Правило статьи — «Спрашивать каждый раз»: точку у такого расхода выбирают "
"руками. Откройте расход и укажите её."
msgstr ""
"Pravilo stavke je „Pitaj svaki put“: objekat za takav trošak se bira ručno. "
"Otvorite trošak i navedite ga."

msgid ""
"Правило статьи — «Пропорционально выручке», но выручки в продукте пока нет: "
"она появится с коннектором Dodo IS. Пока укажите точку руками или смените "
"правило."
msgstr ""
"Pravilo stavke je „Proporcionalno prihodu“, ali prihoda u proizvodu još "
"nema: pojaviće se sa konektorom Dodo IS. Za sada navedite objekat ručno ili "
"promenite pravilo."

msgid ""
"Правило у статьи есть, но разносить не на что: ни одна точка не подошла под "
"него в этом месяце."
msgstr ""
"Stavka ima pravilo, ali nema šta da se raspodeli: nijedan objekat mu nije "
"odgovarao ovog meseca."

msgid "Разносит расходы по точкам тот, кто ведёт все точки партнёра."
msgstr "Troškove po objektima raspodeljuje onaj ko vodi sve objekte partnera."

msgid "Правило у статьи есть — нажмите «Разнести по правилам»."
msgstr "Stavka ima pravilo — kliknite „Raspodeli po pravilima“."

#, python-format
msgid "«%(label)s»: такого варианта нет."
msgstr "„%(label)s“: takva opcija ne postoji."

msgid "Разнесение"
msgstr "Raspodela"

#, python-format
msgid "Для разнесения «%(method)s» нужно выбрать точку."
msgstr "Za raspodelu „%(method)s“ potrebno je izabrati objekat."

#, python-format
msgid ""
"Правило уже действует с %(from)s: новая версия не может начинаться раньше. "
"Возьмите дату позже."
msgstr ""
"Pravilo već važi od %(from)s: nova verzija ne može početi ranije. Izaberite "
"kasniji datum."

#, python-format
msgid ""
"Правило действует с %(from)s: убрать его можно только более поздней датой."
msgstr "Pravilo važi od %(from)s: ukloniti ga je moguće samo kasnijim datumom."

#, python-format
msgid "Этот вызов принимает только %(methods)s."
msgstr "Ovaj poziv prihvata samo %(methods)s."

msgid "Сначала войдите."
msgstr "Prvo se prijavite."

msgid "Вас ещё не завели ни к одному партнёру."
msgstr "Još niste dodati ni jednom partneru."

msgid "Расход не найден."
msgstr "Trošak nije pronađen."

msgid "Тело запроса не разобрано как JSON."
msgstr "Telo zahteva nije moglo da se parsira kao JSON."

msgid "Тело запроса должно быть объектом JSON."
msgstr "Telo zahteva mora biti JSON objekat."

#, python-format
msgid "«limit» больше %(max)s не бывает: спросите страницами."
msgstr "„limit“ ne može biti veći od %(max)s: tražite po stranicama."

msgid "«limit» должен быть больше нуля."
msgstr "„limit“ mora biti veći od nule."

#, python-format
msgid "«%(name)s»: это целое число, а не «%(value)s»."
msgstr "„%(name)s“ mora biti ceo broj, a ne „%(value)s“."

msgid "Эта строка уже заменена: правьте ту, что действует."
msgstr "Ovaj red je već zamenjen: uredite onaj koji je važeći."

msgid "Укажите месяц пересчёта: «period» в виде 2026-08, по одному за вызов."
msgstr ""
"Navedite mesec za ponovni obračun: „period“ u obliku 2026-08, jedan po "
"pozivu."

#, python-format
msgid "«period»: месяц пишется как 2026-08, а не «%(value)s»."
msgstr "„period“: mesec se piše kao 2026-08, a ne „%(value)s“."

#, python-format
msgid ""
"Месяц %(month)s закрыт, и текущий месяц %(current)s тоже — расход записать "
"некуда. Откройте месяц заново с причиной."
msgstr ""
"Mesec %(month)s je zatvoren, a i tekući mesec %(current)s — nema gde da se "
"upiše trošak. Ponovo otvorite mesec sa razlogom."

msgid "Точка не найдена."
msgstr "Objekat nije pronađen."

msgid "Касса не найдена."
msgstr "Kasa nije pronađena."

msgid "Месяц закрылся, пока расход вносили. Откройте форму заново."
msgstr "Mesec je zatvoren dok je trošak unošen. Otvorite formu ponovo."

msgid ""
"Расход на всю сеть вносит тот, кто ведёт все точки партнёра. Выберите свою "
"точку."
msgstr ""
"Trošak za celu mrežu unosi onaj ko vodi sve objekte partnera. Izaberite svoj "
"objekat."

msgid "Месяц закрылся, пока расход удаляли. Откройте список заново."
msgstr "Mesec je zatvoren dok je trošak brisan. Otvorite listu ponovo."

msgid ""
"Форма устарела или испорчена. Откройте её заново и внесите расход ещё раз."
msgstr ""
"Forma je zastarela ili oštećena. Otvorite je ponovo i unesite trošak još "
"jednom."

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому вносить расход некуда. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati ni jednom partneru, pa nema gde da se unese trošak. "
"Zamolite administratora mreže da vas doda."

msgid "Дата расхода"
msgstr "Datum troška"

#, python-format
msgid "«%(label)s»: расход на ноль не вносится."
msgstr "„%(label)s“: trošak sa iznosom nula se ne unosi."

msgid "Комментарий"
msgstr "Komentar"

msgid "Ставка НДС"
msgstr "Stopa PDV-a"

#, python-format
msgid "«%(label)s»: ставки больше 100%% не бывает."
msgstr "„%(label)s“: stopa preko 100%% nije moguća."

#, python-format
msgid "Поле «%(label)s» обязательно."
msgstr "Polje „%(label)s“ je obavezno."

msgid "Статья расхода"
msgstr "Stavka troška"

msgid "Статья не найдена."
msgstr "Stavka troška nije pronađena."

#, python-format
msgid ""
"Статья «%(title)s» на %(date)s не действует: выберите другую или поправьте "
"её в справочнике."
msgstr ""
"Stavka troška „%(title)s“ nije važeća na %(date)s: izaberite drugu ili je "
"ispravite u imeniku."

msgid ""
"Расход на всю сеть из кассы не оплачивается: у кассы есть точка. Уберите "
"кассу или выберите её точку."
msgstr ""
"Trošak za celu mrežu se ne plaća iz kase: kasa ima objekat. Uklonite kasu "
"ili izaberite njen objekat."

#, python-format
msgid ""
"Касса «%(till)s» стоит на точке %(unit)s — выберите её или уберите кассу."
msgstr ""
"Kasa „%(till)s“ je na objektu %(unit)s — izaberite ga ili uklonite kasu."

msgid "Регистр учёта"
msgstr "Knjiga"

msgid "Когда деньги вышли из кассы."
msgstr "Kada je novac izašao iz kase."

msgid "Сумма из чека — с налогом, если он в ней есть."
msgstr "Iznos sa računa — sa porezom, ako ga račun sadrži."

msgid "Ставка НДС, %"
msgstr "Stopa PDV-a, %"

msgid ""
"В Сербии 20 или 10. Пусто — налог не выделяем: в P&L такая трата пойдёт "
"полной суммой. С заполненной ставкой в P&L по умолчанию поедет сумма без НДС."
msgstr ""
"U Srbiji je 20 ili 10. Prazno — porez se ne izdvaja: trošak u P&L ide u "
"punom iznosu. Sa popunjenom stopom u P&L po podrazumevanoj vrednosti ide "
"iznos bez PDV-a."

msgid ""
"Статьи ведёт администратор сети. Нужной нет — попросите завести: выдумывать "
"название на месте нельзя, иначе одна трата назовётся по-разному."
msgstr ""
"Stavke troškova održava administrator mreže. Ako nedostaje ona koja vam "
"treba, zamolite ga da je doda — nije dozvoljeno smišljati naziv u hodu, jer "
"bi se isti trošak svaki put zvao drugačije."

msgid "Из кассы"
msgstr "Iz kase"

msgid ""
"Пусто — регистр берётся из выбранной кассы; без кассы это официальный. "
"Выбранное здесь значение сильнее кассы."
msgstr ""
"Prazno — knjiga se uzima iz izabrane kase; bez kase je to zvanična. Vrednost "
"izabrana ovde jača je od kase."

msgid "Зачем потратили. Через месяц это единственное, по чему строку узнают."
msgstr ""
"Zašto je potrošeno. Za mesec dana to je jedino po čemu će se red prepoznati."

msgid "Касса"
msgstr "Kasa"

msgid "Без кассы"
msgstr "Bez kase"

msgid ""
"Откуда взяли деньги. Регистр учёта расхода приезжает из кассы, а точка — та, "
"на которой она стоит."
msgstr ""
"Odakle je novac uzet. Knjiga troška dolazi iz kase, a objekat je onaj na "
"kome je kasa."

#, python-format
msgid ""
"Месяц %(closed)s закрыт: расход ляжет в %(month)s, а эта дата останется при "
"нём."
msgstr ""
"Mesec %(closed)s je zatvoren: trošak upada u %(month)s, a ovaj datum ostaje "
"uz njega."

msgid "Вся сеть"
msgstr "Cela mreža"

msgid ""
"«Вся сеть» — расход юрлица целиком (аренда офиса, реклама): он разойдётся по "
"точкам правилом статьи."
msgstr ""
"„Cela mreža“ — trošak celog pravnog lica (kirija kancelarije, reklama): "
"raspodeliće se po objektima pravilom stavke."

#, python-format
msgid "Расход записан в месяц %(month)s."
msgstr "Trošak je zapisan za %(month)s."

#, python-format
msgid ""
"Месяц %(closed)s закрыт, поэтому расход записан в %(month)s — с исходной "
"датой и не сдвинув закрытый месяц."
msgstr ""
"Mesec %(closed)s je zatvoren, zato je trošak zapisan za %(month)s — sa "
"originalnim datumom i bez pomeranja zatvorenog meseca."

#, python-format
msgid ""
" Точки у расхода нет, поэтому он ждёт разнесения — и виден в списке "
"нераспределённых: %(url)s"
msgstr ""
" Trošak nema objekat, pa čeka raspodelu — i vidljiv je na listi "
"neraspoređenog: %(url)s"

#, python-format
msgid " Расход разнесён по точкам правилом статьи: строк — %(count)s."
msgstr ""
" Trošak je raspodeljen po objektima pravilom stavke: redova — %(count)s."

msgid ""
" Разнести его по точкам может тот, кто ведёт все точки: строки разнесения "
"ложатся и на чужие точки."
msgstr ""
" Da ga raspodeli po objektima može samo onaj ko vodi sve objekte: redovi "
"raspodele padaju i na tuđe objekte."

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому контрагентов у вас нет. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati nijednom partneru, pa nemate nijednog dobavljača. Zamolite "
"administratora mreže da vas doda."

msgid "Контрагенты"
msgstr "Partneri"

msgid ""
"Поставщики и получатели платежей. Один контрагент — одна карточка: иначе "
"траты одного поставщика рассыпаются по написаниям названия."
msgstr ""
"Dobavljači i primaoci uplata. Jedan partner — jedna kartica: inače se "
"troškovi istog dobavljača rasipaju po različitim ispisima naziva."

msgid "← К справочникам"
msgstr "← Na imenike"

msgid "Поиск по названию, написаниям и номеру"
msgstr "Pretraga po nazivu, ispisu ili broju"

msgid "Завести контрагента"
msgstr "Dodaj partnera"

msgid "Название"
msgstr "Naziv"

msgid "Налоговый номер"
msgstr "Poreski broj"

msgid "Ключ Dodo IS"
msgstr "Dodo IS ključ"

msgid "Действует с"
msgstr "Od"

msgid "Закрыт с"
msgstr "Zatvoren od"

msgid "Контрагентов нет."
msgstr "Nema partnera."

msgid "Ничего не нашлось."
msgstr "Ništa nije pronađeno."

msgid "Пока справочник пуст, счёт выписать не на кого."
msgstr "Dok je imenik prazan, račun nema na koga da se upiše."

msgid ""
"Попробуйте другое написание: поиск смотрит и на название, и на другие "
"написания, и на номера."
msgstr ""
"Probajte drugi ispis: pretraga gleda i naziv, i druge ispise, i brojeve."

#, python-format
msgid "«%(label)s»: дата закрытия должна быть позже даты начала (%(from)s)."
msgstr ""
"\"%(label)s\": datum zatvaranja mora biti kasniji od datuma početka "
"(%(from)s)."

msgid "Новый контрагент"
msgstr "Novi partner"

msgid "← К контрагентам"
msgstr "← Na partnere"

msgid "Сохранить"
msgstr "Sačuvaj"

msgid ""
"Как этот поставщик называется у вас. Название у партнёра одно: две карточки "
"означают, что траты одного поставщика не сложатся."
msgstr ""
"Kako se ovaj dobavljač zove kod vas. Naziv je jedan po partneru: dve kartice "
"znače da se troškovi istog dobavljača neće sabrati."

msgid "ПИБ или его аналог. По нему сходятся фактура и выписка."
msgstr "PIB ili njegov ekvivalent. Po njemu se spajaju faktura i izvod."

msgid "Другие написания"
msgstr "Drugi ispisi"

msgid ""
"Через запятую: как этого поставщика пишут в выписке и в файлах. Поиск "
"смотрит и сюда."
msgstr ""
"Odvojeno zarezom: kako se ovaj dobavljač piše u izvodu i u fajlovima. "
"Pretraga gleda i ovde."

msgid ""
"Идентификатор поставщика в справочнике Dodo IS. Можно оставить пустым: он "
"понадобится, когда появится коннектор."
msgstr ""
"Identifikator dobavljača u Dodo IS imeniku. Može ostati prazan: trebaće kada "
"stigne konektor."

msgid "С какой даты работаем с этим контрагентом."
msgstr "Od kog datuma radimo sa ovim partnerom."

msgid ""
"Контрагент закрывается датой, а не удалением: закрытые месяцы на него "
"ссылаются."
msgstr ""
"Partner se zatvara datumom, a ne brisanjem: zatvoreni meseci se pozivaju na "
"njega."

msgid "Для человека: чем занимается, кто ведёт переписку."
msgstr "Za čoveka: čime se bave, ko vodi prepisku."

msgid "Код"
msgstr "Šifra"

msgid "Сквозной ключ"
msgstr "Eksterni ID"

msgid "Месяц"
msgstr "Mesec"

msgid "Дата курса"
msgstr "Datum kursa"

msgid "Страна"
msgstr "Zemlja"

msgid "Юрлицо"
msgstr "Pravno lice"

msgid "Группа"
msgstr "Grupa"

msgid "Строка P&L"
msgstr "P&L red"

msgid "Контрагент"
msgstr "Kontrahent"

msgid "Роль"
msgstr "Uloga"

msgid "Пользователь"
msgstr "Korisnik"

msgid "Расчёт"
msgstr "Obračun"

msgid "Строка ведомости"
msgstr "Red obračunske liste"

#, python-format
msgid ""
"Такая запись уже есть: %(fields)s не повторяется. Задайте другое значение."
msgstr ""
"Ovaj zapis već postoji: %(fields)s se ne ponavlja. Podesite drugu vrednost."

#, python-format
msgid "%(fields)s: строка не найдена. Выберите значение из списка."
msgstr "%(fields)s: red nije pronađen. Izaberite vrednost sa liste."

#, python-format
msgid "Этот период уже занят другой версией (%(fields)s). Поправьте даты."
msgstr ""
"Ovaj period je već zauzet drugom verzijom (%(fields)s). Ispravite datume."

#, python-format
msgid "«%(field)s»"
msgstr "\"%(field)s\""

#, python-format
msgid ""
"Правку отклонили: %(what)s нельзя изменить, потому что зарплата за %(month)s "
"уже утверждена, а версий по датам у этой настройки нет — правка переписала "
"бы закрытый месяц задним числом. Переопределите нужное человеку в условиях "
"найма: там правка идёт с даты. Либо откройте месяц заново с причиной."
msgstr ""
"Izmena je odbijena: %(what)s se ne može promeniti jer je plata za %(month)s "
"već odobrena, a ovo podešavanje nema verzije po datumima — izmena bi "
"retroaktivno prepisala zatvoreni mesec. Podesite ono što vam treba "
"pojedinačnom zaposlenom u uslovima zaposlenja: tamo izmena važi od datuma. "
"Ili ponovo otvorite mesec uz obrazloženje."

#, python-format
msgid ""
"Зарплата утверждена по %(edge)s включительно. Правку с более ранней датой "
"продукт примет, но закрытый месяц ею не переписывается: если она изменит его "
"числа, разница ляжет помеченной строкой в ближайший неутверждённый месяц — "
"перенести её можно на странице закрытого."
msgstr ""
"Zarada je odobrena zaključno sa %(edge)s. Izmena sa ranijim datumom se "
"prihvata, ali ne prepisuje zatvoreni mesec: ako promeni njegove brojeve, "
"razlika ulazi označenom stavkom u prvi neodobreni mesec — prenesite je na "
"stranici zatvorenog meseca."

#, python-format
msgid ""
"Зарплата утверждена по %(edge)s включительно. Правку с более ранней датой "
"продукт примет, но закрытый месяц ею не переписывается: у этого партнёра "
"разница применяется пересчётом — откройте месяц заново с причиной и "
"посчитайте его снова."
msgstr ""
"Zarada je odobrena zaključno sa %(edge)s. Izmena sa ranijim datumom se "
"prihvata, ali ne prepisuje zatvoreni mesec: kod ovog partnera se razlika "
"primenjuje ponovnim obračunom — otvorite mesec ponovo uz razlog i "
"obračunajte ga opet."

#, python-format
msgid ""
"Правка задела зарплату, утверждённую по %(edge)s. Закрытый месяц остался "
"прежним до копейки: если правка изменила его числа, разница видна на "
"странице этого месяца и переносится оттуда помеченной строкой в ближайший "
"неутверждённый."
msgstr ""
"Izmena je dotakla zaradu odobrenu zaključno sa %(edge)s. Zatvoreni mesec je "
"ostao isti do dinara: ako je izmena promenila njegove brojeve, razlika se "
"vidi na stranici tog meseca i odatle se prenosi označenom stavkom u prvi "
"neodobreni mesec."

#, python-format
msgid ""
"Правка задела зарплату, утверждённую по %(edge)s. Закрытый месяц остался "
"прежним: у этого партнёра разница применяется пересчётом — откройте месяц "
"заново с причиной и посчитайте его снова."
msgstr ""
"Izmena je dotakla zaradu odobrenu zaključno sa %(edge)s. Zatvoreni mesec je "
"ostao isti: kod ovog partnera se razlika primenjuje ponovnim obračunom — "
"otvorite mesec ponovo uz razlog i obračunajte ga opet."

msgid ""
"Календарь общий для страны: правка подействует на всех партнёров этой "
"страны, а не только на вашего. У тех, у кого этот месяц уже утверждён, "
"появится своя разница — переносит её каждый у себя."
msgstr ""
"Kalendar je zajednički za zemlju: izmena će uticati na sve partnere te "
"zemlje, ne samo na vašeg. Kod onih kojima je taj mesec već odobren, pojaviće "
"se sopstvena razlika — svako je prenosi kod sebe."

msgid ""
"Правка календаря подействовала на всех партнёров этой страны, а не только на "
"вашего: календарь общий. У тех, у кого этот месяц утверждён, разница "
"появится на странице месяца — переносит её каждый у себя."
msgstr ""
"Izmena kalendara je uticala na sve partnere te zemlje, ne samo na vašeg: "
"kalendar je zajednički. Kod onih kojima je taj mesec odobren, razlika će se "
"pojaviti na stranici meseca — svako je prenosi kod sebe."

msgid "Карточка сохранена."
msgstr "Kartica je sačuvana."

msgid "Заведена новая версия условий найма."
msgstr "Zavedena je nova verzija uslova zapošljavanja."

msgid "Ничего не изменилось — новая версия не заведена."
msgstr "Ništa se nije promenilo — nova verzija nije zavedena."

msgid ""
"Сотрудник заведён вместе с первой версией условий найма. В ведомость он "
"попадёт, когда за этот месяц появятся его часы: сегодня строку табеля "
"создаёт только загрузка таблицы за месяц."
msgstr ""
"Zaposleni je zaveden zajedno sa prvom verzijom uslova zapošljavanja. U "
"obračunsku listu će ući kada se pojave njegovi sati za ovaj mesec: danas red "
"u evidenciji sati nastaje samo učitavanjem tabele za mesec."

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому сотрудников у вас нет. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati nijednom partneru, pa nemate zaposlene. Zamolite "
"administratora mreže da vas doda."

msgid "Сотрудники"
msgstr "Zaposleni"

msgid "Карточки людей и условия найма: группа, точка, ставка, коэффициент"
msgstr ""
"Kartice ljudi i uslovi zapošljavanja: grupa, objekat, stopa, koeficijent"

msgid "Группы сотрудников"
msgstr "Grupe zaposlenih"

msgid "Схема расчёта и регистр учёта по умолчанию"
msgstr "Podrazumevana šema obračuna i knjiga"

msgid "Точки"
msgstr "Objekti"

msgid "Пиццерии: код, название, юрлицо, даты открытия и закрытия"
msgstr "Picerije: šifra, naziv, pravno lice, datumi otvaranja i zatvaranja"

msgid "Юрлица"
msgstr "Pravna lica"

msgid "С кем работает бухгалтерия: название и налоговый номер"
msgstr "Sa kim radi računovodstvo: naziv i poreski broj"

msgid "Статьи расходов"
msgstr "Stavke troškova"

msgid "Чем называют траты и в какую строку P&L они попадают"
msgstr "Kako se troškovi nazivaju i u koji red P&L-a spadaju"

msgid "Кассы"
msgstr "Kase"

msgid "Коробки, из которых платят наличными: точка и регистр учёта"
msgstr "Kutije iz kojih se plaća gotovinom: objekat i knjiga"

msgid "Поставщики и получатели платежей: название, номера, ключ Dodo IS"
msgstr "Dobavljači i primaoci uplata: naziv, brojevi, Dodo IS ključ"

msgid "Производственный календарь"
msgstr "Proizvodni kalendar"

msgid "Норма часов и рабочие дни месяца — отсюда их берёт страница месяца"
msgstr "Norma časova i radni dani meseca — odavde ih uzima stranica meseca"

#, python-format
msgid "«%(label)s»: дата пишется как 2026-06-01, а не «%(value)s»."
msgstr "„%(label)s“: datum se piše kao 2026-06-01, a ne „%(value)s“."

#, python-format
msgid "«%(label)s»: нужно число, а не «%(value)s»."
msgstr "„%(label)s“: potreban je broj, a ne „%(value)s“."

#, python-format
msgid "«%(label)s»: отрицательное значение."
msgstr "„%(label)s“: negativna vrednost."

#, python-format
msgid "%(code)s — в правилах страны такой нет"
msgstr "%(code)s — ne postoji u pravilima zemlje"

msgid "Внешний ключ"
msgstr "Eksterni ključ"

msgid "Ставка"
msgstr "Stopa"

msgid "Уволен"
msgstr "Otpušten"

msgid ""
"Кто работает у партнёра и по каким условиям. Месяц целиком приносит загрузка "
"таблицы, одного человека — кнопка ниже: вышел на работу пятнадцатого числа, "
"завели пятнадцатым."
msgstr ""
"Ko radi kod partnera i pod kojim uslovima. Ceo mesec donosi učitavanje "
"tabele, jednu osobu — dugme ispod: recimo, datum početka rada je petnaesti, "
"zavedite ga petnaestim."

msgid ""
"Люди вашей точки: в какой группе человек считается и по какой ставке. Только "
"чтение — карточки ведёт администратор сети."
msgstr ""
"Ljudi vašeg objekta: u kojoj grupi se osoba obračunava i po kojoj stopi. "
"Samo čitanje — kartice vodi administrator mreže."

msgid "Поиск по имени или внешнему ключу"
msgstr "Pretraga po imenu ili eksternom ključu"

msgid "Поиск по имени"
msgstr "Pretraga po imenu"

msgid "Завести сотрудника"
msgstr "Dodaj zaposlenog"

msgid "Сотрудников нет."
msgstr "Nema zaposlenih."

msgid ""
"Месяц целиком приносит загрузка таблицы партнёра: откройте месяц и загрузите "
"табель — люди появятся вместе с часами. Одного человека заведите здесь:"
msgstr ""
"Kartice zavodi učitavanje tabele partnera: otvorite mesec i učitajte "
"evidenciju sati — ljudi će se pojaviti zajedno sa satima. Jednu osobu "
"zavedite ovde:"

msgid ""
"Здесь появятся люди вашей точки — вместе с их условиями найма. Пока их нет, "
"спросите администратора сети."
msgstr ""
"Ovde će se pojaviti ljudi vašeg objekta — zajedno sa uslovima zapošljavanja. "
"Dok ih nema, pitajte administratora mreže."

msgid "Попробуйте другое написание имени или фамилии."
msgstr "Probajte drugi ispis imena ili prezimena."

msgid "Новый сотрудник"
msgstr "Novi zaposleni"

msgid "← К сотрудникам"
msgstr "← Na zaposlene"

msgid "Принят"
msgstr "Primljen"

msgid ""
"С этой даты человек работает — и с неё же действует первая версия условий "
"найма. Середина месяца работает: расчёт берёт версию, действующую в месяце."
msgstr ""
"Od ovog datuma osoba radi — i od njega važi prva verzija uslova "
"zapošljavanja. Sredina meseca takođe radi: obračun uzima verziju koja važi "
"tog meseca."

msgid "Фамилия"
msgstr "Prezime"

msgid "Имя"
msgstr "Ime"

msgid ""
"Сквозной ключ между системами, например JMBG. По нему сходится загрузка "
"табеля."
msgstr ""
"Ključ zajednički za sve sisteme, na primer JMBG. Po njemu se poklapa "
"učitavanje evidencije sati."

msgid "Дата увольнения раньше даты приёма."
msgstr "Datum otpuštanja je pre datuma prijema."

msgid "Коэффициент"
msgstr "Koeficijent"

msgid "Схема расчёта"
msgstr "Šema obračuna"

msgid "Чем меряется работа"
msgstr "Mera rada"

msgid "как у группы"
msgstr "kao u grupi"

msgid ""
"Уволить — значит поставить дату. Карточка и история остаются: месяцы, в "
"которые человек работал, считаются по ним. Очистить дату можно — увольнение "
"обратимо."
msgstr ""
"Otpustiti znači postaviti datum. Kartica i istorija ostaju: meseci u kojima "
"je osoba radila i dalje se obračunavaju po njima. Datum se može obrisati — "
"otpuštanje je povratno."

msgid ""
"С этой даты действует новая версия. Прошлая закрывается этим же днём и "
"остаётся в истории."
msgstr ""
"Od ovog datuma važi nova verzija. Prethodna se zatvara istog dana i ostaje u "
"istoriji."

msgid "выберите группу"
msgstr "izaberite grupu"

msgid "не задана"
msgstr "nije podešen"

msgid ""
"Пусто — как у группы. Заполняется там, где человек считается иначе своей "
"группы."
msgstr ""
"Prazno — kao u grupi. Popunjava se tamo gde se osoba obračunava drugačije od "
"svoje grupe."

msgid ""
"Правил страны в базе нет, поэтому и списка схем нет: загрузите пресет "
"страны. Пока — ключ схемы, как он написан в правилах."
msgstr ""
"U bazi nema pravila zemlje, pa nema ni liste šema: učitajte preset zemlje. "
"Za sada — ključ šeme, onako kako je napisan u pravilima."

msgid ""
"Часовая или сдельная — у этого человека. Пусто — как у группы. Сдельному "
"человеку табель спросит величину за месяц вместо часов."
msgstr ""
"Po satu ili po učinku — kod ove osobe. Prazno — kao u grupi. Osobi koja radi "
"po učinku, evidencija sati će tražiti vrednost za mesec umesto sati."

msgid ""
"Правил страны в базе нет, поэтому и списка способов нет: загрузите пресет "
"страны."
msgstr ""
"U bazi nema pravila zemlje, pa nema ni liste načina: učitajte preset zemlje."

msgid ""
"Группа задаёт схему расчёта и регистр учёта по умолчанию. Отдельному "
"человеку и то и другое переопределяется в условиях найма — с датой."
msgstr ""
"Grupa određuje podrazumevanu šemu obračuna i knjigu. Kod pojedinačne osobe "
"oba se mogu preklopiti u uslovima zapošljavanja — sa datumom."

msgid "Завести группу"
msgstr "Dodaj grupu"

msgid "Групп нет."
msgstr "Nema grupa."

msgid "Без группы человека не посчитать: она задаёт схему расчёта."
msgstr "Bez grupe osoba se ne može obračunati: ona određuje šemu obračuna."

msgid "схема расчёта и регистр группы"
msgstr "šema obračuna i knjiga grupe"

msgid "Новая группа"
msgstr "Nova grupa"

msgid "← К группам"
msgstr "← Na grupe"

msgid ""
"По нему группа названа в правилах страны. Менять — только вместе с правилами."
msgstr ""
"Po njemu je grupa imenovana u pravilima zemlje. Menjati — samo zajedno sa "
"pravilima."

msgid "выберите схему"
msgstr "izaberite šemu"

msgid ""
"По ней движок считает людей группы. Список — из правил страны: отдельному "
"человеку схема переопределяется в его условиях найма, с датой."
msgstr ""
"Preko nje sistem obračunava ljude iz grupe. Lista dolazi iz pravila zemlje: "
"kod pojedinačne osobe šema se preklapa u njenim uslovima zapošljavanja, sa "
"datumom."

msgid "Задаётся после сохранения группы: правило адресуется её кодом."
msgstr "Postavlja se nakon čuvanja grupe: pravilo se adresira njenim kodom."

msgid ""
"Правило страны, а не колонка справочника: у смены способа есть дата, и "
"закрытый месяц от неё не двигается."
msgstr ""
"Pravilo zemlje, a ne kolona imenika: promena načina ima datum, i zatvoren "
"mesec se od toga ne pomera."

msgid "Способ действует с"
msgstr "Način važi od"

msgid ""
"Нужна только при смене способа. Пусто — берётся первый день, который не "
"задевает утверждённый месяц."
msgstr ""
"Potrebno samo pri promeni načina. Prazno — koristi se prvi dan koji ne "
"zadire u odobren mesec."

msgid ""
"Расходы разносятся на точку, а не на юрлицо. Закрытая точка остаётся в "
"истории."
msgstr ""
"Troškovi se raspoređuju na objekat, a ne na pravno lice. Zatvoren objekat "
"ostaje u istoriji."

msgid "Завести точку"
msgstr "Dodaj objekat"

msgid "Открыта"
msgstr "Otvoren"

msgid "Закрыта"
msgstr "Zatvoren"

msgid "Точек нет."
msgstr "Nema objekata."

msgid "На точку разносятся часы и расходы — с неё и начинается учёт."
msgstr ""
"Na objekat se raspoređuju sati i troškovi — od njega i počinje evidentiranje."

msgid "Дата закрытия раньше даты открытия."
msgstr "Datum zatvaranja je pre datuma otvaranja."

msgid "Новая точка"
msgstr "Novi objekat"

msgid "← К точкам"
msgstr "← Na objekte"

msgid "Короткий код точки, например NS1. Им точка названа в таблице партнёра."
msgstr ""
"Kratka šifra objekta, na primer NS1. Njome je objekat imenovan u tabeli "
"partnera."

msgid "не задано"
msgstr "nije podešeno"

msgid ""
"Точка закрывается датой, а не удалением: закрытые месяцы ссылаются на неё."
msgstr ""
"Objekat se zatvara datumom, a ne brisanjem: zatvoreni meseci se pozivaju na "
"njega."

msgid "Бухгалтерия работает с юрлицом, пиццерий для неё нет."
msgstr "Računovodstvo radi sa pravnim licem, picerije za njega ne postoje."

msgid "Завести юрлицо"
msgstr "Dodaj pravno lice"

msgid "Юрлиц нет."
msgstr "Nema pravnih lica."

msgid "Юрлицо нужно точке: с ним бухгалтерия работает в официальном регистре."
msgstr ""
"Objektu je potrebno pravno lice: sa njim računovodstvo radi u zvaničnoj "
"knjizi."

msgid "Новое юрлицо"
msgstr "Novo pravno lice"

msgid "← К юрлицам"
msgstr "← Na pravna lica"

msgid "закрыт"
msgstr "zatvoren"

msgid ""
"Норма часов месяца берётся отсюда — её показывает страница месяца. Календаря "
"на месяц нет — там стоит прочерк, а не правдоподобное число."
msgstr ""
"Norma časova meseca se uzima odavde — prikazuje je stranica meseca. Ako za "
"mesec nema kalendara, stoji crta, a ne broj koji samo izgleda tačno."

msgid "Завести месяц"
msgstr "Dodaj mesec"

msgid "Норма часов"
msgstr "Norma sati"

msgid "Рабочих дней"
msgstr "Radnih dana"

msgid "Зарплата"
msgstr "Plata"

msgid "Календарь пуст."
msgstr "Kalendar je prazan."

msgid ""
"Пока месяца нет в календаре, норма часов на его странице — прочерк, и "
"недоработку считать не от чего."
msgstr ""
"Dok mesec nije u kalendaru, norma časova na njegovoj stranici je crta, i "
"nema od čega da se računa manjak."

msgid "Новый месяц календаря"
msgstr "Novi mesec kalendara"

msgid "← К календарю"
msgstr "← Na kalendar"

#, python-format
msgid ""
"«%(label)s»: в месяце %(month)s столько дней не бывает — их всего %(limit)s."
msgstr "„%(label)s“: mesec %(month)s nema toliko dana — ima ih %(limit)s."

#, python-format
msgid "«%(label)s»: месяц пишется как 2026-06, а не «%(value)s»."
msgstr "„%(label)s“: mesec se piše kao 2026-06, a ne „%(value)s“."

msgid "Что-то сломалось на нашей стороне"
msgstr "Nešto se pokvarilo na našoj strani"

msgid ""
"Мы записали это в журнал. Попробуйте ещё раз через минуту, а если повторится "
"— скажите тому, кто ведёт сервис."
msgstr ""
"Zabeležili smo to u dnevnik. Pokušajte ponovo za minut, a ako se ponovi — "
"javite onome ko vodi servis."

msgid ""
"В файле не нашлась колонка с названием статьи. Назовите её «Название», "
"«Naziv» или «Name» — по остальным колонкам продукт разберётся сам."
msgstr ""
"U fajlu nije pronađena kolona sa nazivom stavke. Nazovite je „Название“, "
"„Naziv“ ili „Name“ — ostale kolone će proizvod sam prepoznati."

#, python-format
msgid "строка P&L не опознана: «%(value)s»"
msgstr "P&L red nije prepoznat: „%(value)s“"

#, python-format
msgid ""
"дата «Действует с» не разобрана: «%(value)s». Пишите её как 01.06.2026 или "
"2026-06-01"
msgstr ""
"datum „Važi od“ nije pročitan: „%(value)s“. Pišite ga kao 01.06.2026. ili "
"2026-06-01"

msgid "строка P&L у статьи уже другая — поменяйте её на карточке статьи"
msgstr "stavka već ima drugačiji P&L red — promenite ga na kartici stavke"

msgid "Нужно хотя бы одно название статьи — без него её не выбрать глазами."
msgstr ""
"Potreban je bar jedan naziv stavke — bez njega se ne može prepoznati očima."

msgid "Загрузить из файла"
msgstr "Učitaj iz fajla"

msgid ""
"Список статей бухгалтера книгой Excel. Колонки продукт ищет по названию, на "
"любом из трёх языков: «Название», «Naziv» или «Name»; «Код», «Šifra» или "
"«Code»; «Строка P&L», «Kategorija» или «P&L»; «Действует с», «Važi od» или "
"«Valid from». Порядок и лишние колонки значения не имеют. Дата из файла "
"главнее поля ниже: оно применяется только к строкам, где даты нет, а "
"непонятную дату продукт назовёт и строку пропустит. Повторная загрузка того "
"же файла ничего не удвоит: статьи сходятся по коду. Строки справочника, "
"которых в файле нет, останутся — их судьбу решаете вы."
msgstr ""
"Spisak stavki knjigovođe kao Excel radna sveska. Proizvod traži kolone po "
"nazivu, na bilo kom od tri jezika: „Naziv“, „Name“ ili „Название“; „Šifra“, "
"„Code“ ili „Код“; „Kategorija“, „P&L“ ili „Строка P&L“; „Važi od“, „Valid "
"from“ ili „Действует с“. Redosled i suvišne kolone nisu bitni. Datum iz "
"fajla je jači od polja ispod: ono se primenjuje samo na redove bez datuma, a "
"ako datum ne može da pročita, proizvod će taj red imenovati i preskočiti ga. "
"Ponovno učitavanje istog fajla ništa neće udvostručiti: stavke se poklapaju "
"po šifri. Redovi šifarnika kojih nema u fajlu ostaju — njihovu sudbinu "
"odlučujete vi."

msgid "Чем называют траты и в какую строку P&L они попадают."
msgstr "Kako se troškovi nazivaju i u koji red P&L-a spadaju."

msgid "Завести статью"
msgstr "Dodaj stavku troška"

msgid "Статей расходов нет."
msgstr "Nema stavki troškova."

msgid ""
"Справочник поставляется пустым намеренно: список статей придёт с файла "
"бухгалтера, а не выдумывается здесь — иначе одна и та же трата называлась бы "
"по-разному у нас и у неё."
msgstr ""
"Imenik se isporučuje prazan namerno: spisak stavki će stići iz fajla "
"računovođe, a ne izmišljati se ovde — inače bi se isti trošak kod nas i kod "
"nje zvao drugačije."

msgid "Дата закрытия раньше или равна дате начала действия."
msgstr "Datum zatvaranja je pre datuma početka ili je isti kao on."

msgid "строка P&L статьи расходов"
msgstr "P&L red stavke troška"

msgid "Новая статья"
msgstr "Nova stavka troška"

msgid "← К статьям расходов"
msgstr "← Na stavke troškova"

msgid "По нему статья сходится с файлом бухгалтера при загрузке."
msgstr "Po njemu se stavka poklapa sa fajlom računovođe pri uvozu."

#, python-format
msgid "Название (%(language)s)"
msgstr "Naziv (%(language)s)"

msgid ""
"Статья закрывается датой, а не удалением: закрытые месяцы на неё ссылаются."
msgstr ""
"Stavka troška se zatvara datumom, a ne brisanjem: zatvoreni meseci se "
"pozivaju na nju."

msgid "Точка разнесения"
msgstr "Objekat raspodele"

msgid "Правило действует с"
msgstr "Pravilo važi od"

msgid "Разнесение расхода без точки"
msgstr "Raspodela troška bez objekta"

msgid "Правила нет — расход будет ждать"
msgstr "Nema pravila — trošak će čekati"

msgid ""
"Как разложить по точкам расход, внесённый на всю сеть (аренда офиса, "
"реклама). Без правила он остаётся в списке нераспределённых и в разрез по "
"точкам не попадает."
msgstr ""
"Kako da se po objektima raspodeli trošak unet na celu mrežu (kirija "
"kancelarije, reklama). Bez pravila ostaje na listi neraspoređenog i ne ulazi "
"u razrez po objektima."

msgid "Не выбрана"
msgstr "Nije izabran"

msgid "Нужна только для разнесения на одну точку."
msgstr "Potreban je samo za raspodelu na jedan objekat."

msgid "Регистр учёта правила"
msgstr "Knjiga pravila"

msgid ""
"У одной статьи законно по правилу на регистр: одна и та же трата бывает и "
"официальной, и из кассы."
msgstr ""
"Jedna stavka legalno ima pravilo po knjizi: isti trošak može biti i zvaničan "
"i iz kase."

msgid ""
"Смена правила — новая версия с этой даты, а не правка прежней: закрытые "
"месяцы обязаны считаться тем правилом, которым были посчитаны."
msgstr ""
"Promena pravila je nova verzija od ovog datuma, a ne izmena prethodne: "
"zatvoreni meseci moraju biti obračunati onim pravilom kojim su i obračunati."

msgid "Версии правила"
msgstr "Verzije pravila"

#, python-format
msgid "%(method)s%(unit)s, %(ledger)s, с %(from)s%(to)s"
msgstr "%(method)s%(unit)s, %(ledger)s, od %(from)s%(to)s"

#, python-format
msgid " по %(date)s"
msgstr " do %(date)s"

msgid "По ним видно, каким правилом посчитан закрытый месяц."
msgstr "Iz njih se vidi kojim pravilom je obračunat zatvoreni mesec."

#, python-format
msgid "Файл больше %(limit)s МБ — это не список статей."
msgstr "Fajl je veći od %(limit)s MB — to nije spisak stavki."

msgid "В файле не нашлось ни одной статьи: под строкой заголовков пусто."
msgstr ""
"U fajlu nije pronađena nijedna stavka: ispod reda sa zaglavljima je prazno."

msgid "Язык названий в файле"
msgstr "Jezik naziva u fajlu"

msgid "Статьи действуют с"
msgstr "Stavke važe od"

#, python-format
msgid "Загружено: %(new)s новых, %(same)s без изменений, %(fixed)s обновлено."
msgstr "Učitano: %(new)s novih, %(same)s bez izmena, %(fixed)s ažurirano."

#, python-format
msgid "Пропущены: %(rows)s."
msgstr "Preskočeno: %(rows)s."

#, python-format
msgid ""
"В справочнике остались статьи, которых в файле нет: %(codes)s. Продукт их не "
"трогает — закройте датой те, что больше не нужны."
msgstr ""
"U šifarniku su ostale stavke kojih nema u fajlu: %(codes)s. Proizvod ih ne "
"dira — zatvorite datumom one koje više nisu potrebne."

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому расходов у вас нет. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati ni jednom partneru, pa nemate troškove. Zamolite "
"administratora mreže da vas doda."

msgid "Конец периода раньше начала: поправьте даты."
msgstr "Kraj perioda je pre početka: ispravite datume."

msgid "С даты"
msgstr "Od datuma"

msgid "По дату"
msgstr "Do datuma"

#, python-format
msgid "«%(label)s»: это номер из списка, а не «%(value)s»."
msgstr "„%(label)s“ mora biti ID sa liste, a ne „%(value)s“."

msgid "удалён"
msgstr "Uklonjen"

msgid "заменён"
msgstr "Zamenjen"

msgid "сторно"
msgstr "Storno"

msgid "исправление"
msgstr "Ispravka"

msgid "Все точки"
msgstr "Svi objekti"

msgid "Все статьи"
msgstr "Sve stavke"

msgid "Все регистры"
msgstr "Sve knjige"

#, python-format
msgid ""
"Пересчёт прошёл: ни одна строка не изменилась, а ждут разнесения %(count)s. "
"Что мешает каждой — в колонке «Почему ждёт»."
msgstr ""
"Ponovni obračun je izvršen: nijedan red se nije promenio, a čeka raspodelu "
"%(count)s. Šta sprečava svaki red piše u koloni „Zašto čeka“."

msgid "Пересчёт прошёл: менять было нечего, ни одна строка не тронута."
msgstr ""
"Ponovni obračun je izvršen: nije bilo šta da se menja, ni jedan red nije "
"dodirnut."

#, python-format
msgid "Пересчёт прошёл: строк изменено — %(count)s."
msgstr "Ponovni obračun je izvršen: izmenjeno redova — %(count)s."

#, python-format
msgid ""
"Закрытые месяцы не пересчитывались: %(months)s. Чтобы пересчитать их, месяц "
"придётся открыть заново с причиной."
msgstr ""
"Zatvoreni meseci nisu ponovo obračunati: %(months)s. Da biste ih ponovo "
"obračunali, mesec morate ponovo otvoriti sa razlogom."

#, python-format
msgid ""
"Эти месяцы не пересчитаны: %(months)s — разносит расходы по точкам тот, кто "
"ведёт все точки партнёра."
msgstr ""
"Ovi meseci nisu ponovo obračunati: %(months)s — troškove po objektima "
"raspodeljuje onaj ko vodi sve objekte partnera."

#, python-format
msgid ""
"Месяц %(closed)s закрыт: строку в нём не изменить. Правка ляжет в %(month)s "
"двумя строками — сторно этой записи и новая, — а закрытый месяц не сдвинется "
"ни на копейку."
msgstr ""
"Mesec %(closed)s je zatvoren: red u njemu se ne može izmeniti. Izmena upada "
"u %(month)s kao dva reda — storno ovog zapisa i novi — a zatvoreni mesec se "
"neće pomeriti ni za paru."

msgid ""
"Удалённый расход не стирается: строка останется в списке помеченной, а из "
"итога выйдет."
msgstr ""
"Obrisan trošak nije izbrisan bez traga: red ostaje u listi, obeležen, i "
"izlazi iz ukupnog iznosa."

#, python-format
msgid ""
"Строку закрытого месяца не тронуть и здесь: удаление положит в %(month)s "
"сторно на её сумму, а %(closed)s не сдвинется. Помеченной в списке она не "
"станет — из итога её выводит сторно."
msgstr ""
"Red zatvorenog meseca ni ovde se ne može dirati: brisanje upisuje storno na "
"njegov iznos u %(month)s, a %(closed)s se ne pomera. Red neće biti označen u "
"listi — iz zbira ga izvodi storno."

msgid ""
"Исправленная строка прежней правки при этом снимется — денег этого расхода в "
"P&L не останется."
msgstr ""
"Ispravljeni red od ranije izmene će pritom biti povučen — novca ovog troška "
"u P&L-u neće ostati."

msgid ""
"Этот расход уже удалён: отменяющая строка за него записана раньше. Ничего не "
"изменилось."
msgstr ""
"Ovaj trošak je već obrisan: storno za njega je upisan ranije. Ništa se nije "
"promenilo."

#, python-format
msgid ""
"Расход удалён. Месяц %(closed)s закрыт, строку в нём не тронуть, поэтому в "
"%(month)s легло сторно на её сумму — закрытый месяц не сдвинулся ни на "
"копейку."
msgstr ""
"Trošak je obrisan. Mesec %(closed)s je zatvoren i red u njemu se ne može "
"dirati, pa je u %(month)s upisan storno na njegov iznos — zatvoreni mesec se "
"nije pomerio ni za dinar."

msgid ""
"Исправленная строка прежней правки снята — денег этого расхода в P&L больше "
"нет."
msgstr ""
"Ispravljeni red od ranije izmene je povučen — novca ovog troška više nema u "
"P&L-u."

msgid "Расход удалён: в текущий месяц легло сторно на его сумму."
msgstr "Trošak je obrisan: u tekući mesec je upisan storno na njegov iznos."

msgid "Расход удалён: строка осталась в списке помеченной, а из итога вышла."
msgstr "Trošak je obrisan: red ostaje u listi, označen, a iz zbira izlazi."

#, python-format
msgid "Правка записана в месяц %(month)s."
msgstr "Izmena je upisana u mesec %(month)s."

#, python-format
msgid ""
"Месяц %(closed)s закрыт, поэтому правка записана в %(month)s двумя строками "
"— сторно прежней записи и новой. Закрытый месяц не сдвинулся."
msgstr ""
"Mesec %(closed)s je zatvoren, pa je izmena upisana u %(month)s kroz dva reda "
"— storno prethodnog zapisa i novi. Zatvoreni mesec se nije pomerio."

msgid "Официальный"
msgstr "Zvanična"

msgid "Дополнительный"
msgstr "Dopunska"

msgid "Внутренний"
msgstr "Interna"

#, python-format
msgid "%(percent)s и %(amount)s"
msgstr "%(percent)s i %(amount)s"

msgid "role.director"
msgstr "Operativni direktor"

msgid "role.accountant"
msgstr "Knjigovođa"

msgid "role.manager"
msgstr "Menadžer objekta"

msgid "role.admin"
msgstr "Administrator mreže"

msgid "role.regional_manager"
msgstr "Regionalni menadžer"

msgid "role.shift_manager"
msgstr "Menadžer smene"

msgid "1. Часы"
msgstr "1. Sati"

msgid "Внесите отработанные часы в табеле или загрузите их таблицей."
msgstr "Unesite odrađene sate u evidenciju sati ili ih učitajte tabelom."

msgid "2. Расчёт"
msgstr "2. Obračun"

msgid "Посчитайте период — получится ведомость по видимым вам регистрам."
msgstr ""
"Obračunajte period — dobićete obračunsku listu za knjige koje su vam "
"vidljive."

msgid "3. Утверждение"
msgstr "3. Odobrenje"

msgid "Утвердите период: расчёт замораживается, откат — только с причиной."
msgstr ""
"Odobrite period: obračun se zamrzava, vraćanje unazad — samo uz razlog."

msgid "Выберите, что за бумага: накладная или чек."
msgstr "Izaberite kakav je papir: otpremnica ili račun."

msgid "Файл не приложен: без фотографии разбирать нечего."
msgstr "Fajl nije priložen: bez fotografije nema šta da se razvrstava."

#, python-format
msgid ""
"Файл больше %(limit)s МБ. Сфотографируйте бумагу ещё раз или уменьшите "
"снимок."
msgstr ""
"Fajl je veći od %(limit)s MB. Fotografišite papir ponovo ili smanjite snimak."

msgid ""
"Такой файл продукт не примет: нужна фотография (JPEG, PNG, WebP, HEIC) или "
"PDF."
msgstr ""
"Proizvod neće prihvatiti ovakav fajl: potrebna je fotografija (JPEG, PNG, "
"WebP, HEIC) ili PDF."

msgid "У бумаги должна быть точка: укажите, с какой она пришла."
msgstr "Papir mora imati objekat: navedite sa kog je stigao."

msgid "Контрагент не найден."
msgstr "Partner nije pronađen."

msgid "Накладная"
msgstr "Otpremnica"

msgid "Чек"
msgstr "Račun"

msgid ""
"Вас ещё не завели ни к одному партнёру, поэтому бумаги вам некуда нести. "
"Попросите администратора сети добавить вас."
msgstr ""
"Još niste dodati nijednom partneru, pa nema gde da se donese papir. Zamolite "
"administratora mreže da vas doda."

msgid "Дата на бумаге"
msgstr "Datum na papiru"

msgid "Сумма с бумаги"
msgstr "Iznos sa papira"

#, python-format
msgid ""
"«%(label)s»: ноль не сумма. Оставьте поле пустым, если сумма неизвестна."
msgstr ""
"„%(label)s“: nula nije iznos. Ostavite polje prazno ako iznos nije poznat."

msgid "Что это"
msgstr "Šta je to"

msgid "Что за бумага"
msgstr "Kakav papir"

msgid ""
"Бумагу приносят с точки, а не со всей сети: выберите точку, с которой она "
"пришла."
msgstr ""
"Papir stiže sa objekta, a ne iz cele mreže: izaberite objekat sa kog je "
"stigao."

msgid ""
"Накладная — бумага поставщика на товар. Чек — то, что заплатили на месте."
msgstr ""
"Otpremnica je dobavljačev papir za robu. Račun je ono što je plaćeno na licu "
"mesta."

msgid "Дата, которая напечатана на самой бумаге."
msgstr "Datum koji je odštampan na samom papiru."

msgid "Фотография или PDF"
msgstr "Fotografija ili PDF"

msgid ""
"Снимок с телефона годится. Главное — чтобы читались поставщик, дата и сумма."
msgstr ""
"Snimak telefonom je dovoljan. Bitno je da se vide dobavljač, datum i iznos."

msgid "Поставщик"
msgstr "Dobavljač"

msgid "Не знаю или нет в списке"
msgstr "Ne znam ili nema na spisku"

msgid "Можно не выбирать: поставщика назначит бухгалтер при разборе."
msgstr ""
"Ne morate birati: dobavljača će dodeliti knjigovođa prilikom razvrstavanja."

msgid ""
"Необязательно. Это сумма со слов, а не расход: в P&L она попадёт только "
"после разбора."
msgstr ""
"Nije obavezno. Ovo je iznos po izjavi, a ne trošak: u P&L ulazi tek posle "
"razvrstavanja."

msgid ""
"Одной строкой: от кого бумага и за что. Поможет бухгалтеру найти поставщика."
msgstr ""
"U jednoj rečenici: od koga je papir i za šta. Pomoći će knjigovođi da "
"pronađe dobavljača."

msgid ""
"С какой точки бумага. Не куда ляжет расход — это решает бухгалтер при "
"разборе."
msgstr ""
"Sa kog je objekta papir. Ne gde će trošak pasti — to odlučuje knjigovođa "
"prilikom razvrstavanja."

msgid "Вас ещё не завели ни к одному партнёру, поэтому бумаг у вас нет."
msgstr "Još niste dodati nijednom partneru, pa nemate papira."

#, python-format
msgid "%(kind)s с точки %(unit)s"
msgstr "%(kind)s sa objekta %(unit)s"

msgid ""
"Бумага принята и ждёт разбора бухгалтером. В P&L её ещё нет: сумма появится "
"там, когда бухгалтер назначит статью и период."
msgstr ""
"Papir je primljen i čeka da ga knjigovođa razvrsta. U P&L-u ga još nema: "
"iznos će se tamo pojaviti kada knjigovođa dodeli stavku i period."

#, python-format
msgid "Бумага разобрана: строка учтена в периоде %(month)s."
msgstr "Papir je razvrstan: red je zaveden u period %(month)s."

#, python-format
msgid ""
"Месяц %(month)s закрыт, поэтому строка легла в открытый период — с исходной "
"датой и не сдвинув закрытый месяц."
msgstr ""
"Mesec %(month)s je zatvoren, pa je red ušao u otvoreni period — sa izvornim "
"datumom, ne dirajući zatvoreni mesec."

#, python-format
msgid ""
"Месяц %(month)s закрыт. Разбор его не тронет: строка ляжет в открытый период "
"с исходной датой документа."
msgstr ""
"Mesec %(month)s je zatvoren. Razvrstavanje ga ne dira: red će ući u otvoreni "
"period sa izvornim datumom dokumenta."

#, python-format
msgid "%(size)s КБ"
msgstr "%(size)s KB"

msgid "Правка табеля"
msgstr "Izmena evidencije sati"

msgid "Расчёт периода"
msgstr "Obračun perioda"

msgid "Утверждение периода"
msgstr "Odobrenje perioda"

msgid "Откат периода"
msgstr "Vraćanje perioda"

msgid "Закрытие часов по точке"
msgstr "Zatvaranje sati objekta"

msgid "Заморозка строки ведомости"
msgstr "Zamrzavanje reda obračunske liste"

msgid "Перенос разницы за закрытый месяц"
msgstr "Prenos razlike za zatvoreni mesec"

msgid "Ведение справочников"
msgstr "Upravljanje imenicima"

msgid "Ведение правил расчёта"
msgstr "Upravljanje pravilima obračuna"

msgid "Ведение ролей"
msgstr "Upravljanje ulogama"

msgid "Разбор первички"
msgstr "Razvrstavanje primarne dokumentacije"

#, python-format
msgid ""
"%(action)s не входит в права вашей роли «%(role)s». Вы ведёте роли — "
"откройте «Роли и права» и выдайте его."
msgstr ""
"%(action)s nije u pravima vaše uloge „%(role)s“. Vi vodite uloge — otvorite "
"„Uloge i prava“ i dodelite ga."

#, python-format
msgid ""
"%(action)s не входит в права вашей роли. Вы ведёте роли — откройте «Роли и "
"права» и выдайте его."
msgstr ""
"%(action)s nije u pravima vaše uloge. Vi vodite uloge — otvorite „Uloge i "
"prava“ i dodelite ga."

#, python-format
msgid ""
"%(action)s не входит в права вашей роли «%(role)s». Попросите того, у кого "
"это право есть."
msgstr ""
"%(action)s nije u ovlašćenjima vaše uloge „%(role)s“. Zamolite nekoga ko ima "
"to ovlašćenje."

#, python-format
msgid ""
"%(action)s не входит в права вашей роли. Попросите того, у кого это право "
"есть."
msgstr ""
"%(action)s nije u ovlašćenjima vaše uloge. Zamolite nekoga ko ima to "
"ovlašćenje."

msgid ""
"«Начислено» — сумма показанных строк. Бруто, налог, взносы и каналы выплаты "
"посчитаны по всем регистрам учёта сразу, поэтому показываются тому, кому "
"видны все регистры, и по месяцам не складываются."
msgstr ""
"„Obračunati iznos“ je zbir prikazanih redova. Bruto, porez, doprinosi i "
"kanali isplate se računaju za sve knjige odjednom, zato se prikazuju samo "
"onome ko vidi sve knjige, i ne sabiraju se po mesecima."

#, python-format
msgid "на карту %(bank)s · в кассу %(cash)s"
msgstr "preko banke %(bank)s · gotovinom %(cash)s"

msgid "Начислено за всё время"
msgstr "Obračunato za sve vreme"

msgid "Сумма показанных строк по всем месяцам"
msgstr "Zbir prikazanih redova za sve mesece"

msgid "Месяцев с выплатами"
msgstr "Meseci sa isplatama"

msgid "Считаются только месяцы, строки которых вам видно"
msgstr "Računaju se samo meseci čiji su redovi vama vidljivi"

msgid "В среднем за месяц"
msgstr "Prosek po mesecu"

msgid "Начислено, поделённое на число этих месяцев"
msgstr "Obračunati iznos podeljen brojem tih meseci"

msgid "Часов отработано"
msgstr "Odrađeni sati"

msgid "По табелю за те же месяцы; часы регистром не делятся"
msgstr "Prema evidenciji sati za iste mesece; sati se ne dele po knjigama"

msgid "К выплате (нето)"
msgstr "Za isplatu (neto)"

msgid "Бруто"
msgstr "Bruto"

msgid "Полная стоимость"
msgstr "Ukupan trošak"

msgid "Часы для взносов"
msgstr "Sati za doprinose"

msgid "Базовая ставка"
msgstr "Osnovna stopa rada"

msgid "Топли оброк и регрес"
msgstr "Топли оброк и регрес"

#, python-format
msgid "Часы · %(kind)s"
msgstr "Sati · %(kind)s"

#, python-format
msgid "%(what)s: в таблице %(expected)s, в расчёте %(actual)s"
msgstr "%(what)s: %(expected)s u tabeli, %(actual)s u obračunu"

msgid "Такой роли у этого партнёра нет."
msgstr "Ovaj partner nema takvu ulogu."

msgid "Права роли не изменены: база не приняла запись."
msgstr "Prava nisu izmenjena: baza nije prihvatila upis."

#, python-format
msgid "Права роли «%(role)s» сохранены."
msgstr "Prava uloge „%(role)s“ su sačuvana."

msgid "Это единственная роль человека — снимать её некуда."
msgstr "Ovo je jedina uloga osobe — nema šta da ostane posle uklanjanja."

#, python-format
msgid "Роль «%(role)s» снята."
msgstr "Uloga „%(role)s“ je uklonjena."

msgid "Эта роль у человека уже есть."
msgstr "Osoba već ima ovu ulogu."

#, python-format
msgid "Роль «%(role)s» выдана."
msgstr "Uloga „%(role)s“ je dodeljena."

msgid ""
"Правила группы адресуются её кодом, поэтому ниже партнёра они не действуют: "
"после перевода человека в другую группу такое переопределение молча "
"перестало бы применяться. Схема расчёта, регистр и мера работы конкретного "
"человека задаются в его условиях найма."
msgstr ""
"Pravila grupe se adresiraju njenim kodom, pa ispod partnera ne važe: posle "
"prebacivanja osobe u drugu grupu takva izmena bi prestala da se primenjuje, "
"i to neprimetno. Šema obračuna, knjiga i mera rada konkretne osobe se zadaju "
"u njenim uslovima zapošljavanja."

msgid ""
"Пороги отчёта расхождений читаются один раз на партнёра, поэтому версия для "
"группы или человека в отчёт не попала бы вовсе."
msgstr ""
"Pragovi izveštaja o odstupanjima se čitaju jednom po partneru, pa verzija za "
"grupu ili osobu uopšte ne bi ušla u izveštaj."

msgid "всему партнёру"
msgstr "celom partneru"

msgid "группе"
msgstr "grupi"

msgid "одному человеку"
msgstr "jednoj osobi"

#, python-format
msgid "Уровень «%(level)s» не из тех, на которые кладутся правила."
msgstr "Nivo „%(level)s“ nije jedan od onih na koje se postavljaju pravila."

msgid "У уровня «всему партнёру» объекта нет."
msgstr "Nivo „ceo partner“ nema objekat."

msgid "Не нашлось того, кому адресована правка. Выберите из списка."
msgstr "Nije pronađen onaj kome je izmena upućena. Izaberite sa liste."

#, python-format
msgid "%(count)s группе"
msgstr "%(count)s grupi"

#, python-format
msgid "%(count)s группам"
msgstr "%(count)s grupama"

#, python-format
